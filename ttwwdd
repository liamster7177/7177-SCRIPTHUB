-- =============================================
-- NOCLIP  (simple CanCollide loop)
-- Replaces the old anchor/desync noclip entirely. Nothing is anchored,
-- nothing is welded, the Humanoid keeps walking normally -- its floor
-- detection is a raycast, not a collision test, so you stay grounded.
-- =============================================
AR2_noclipConn = nil

function AR2_startNoclip()
    if AR2_noclipConn then return end
    AR2_CFG.misc.noclip = true
    AR2_noclipConn = task.spawn(function()
        while AR2_CFG.misc.noclip do
            pcall(function()
                local char = LP.Character
                if char then
                    for _, part in ipairs(char:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.CanCollide = false
                        end
                    end
                end
            end)
            task.wait(0.1)
        end
        AR2_noclipConn = nil
    end)
end

function AR2_stopNoclip()
    AR2_CFG.misc.noclip = false
    AR2_noclipConn = nil
    pcall(function()
        local char = LP.Character
        if not char then return end
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                part.CanCollide = true
            end
        end
        local h = char:FindFirstChildWhichIsA("Humanoid")
        if h then h.PlatformStand = false h.Sit = false end
    end)
end

function AR2_noclipActive()
    return AR2_CFG.misc.noclip == true
end

