-- =============================================
-- SILENT AIM + WALLBANG
--
-- This is twd_sa4f.lua's logic copied in VERBATIM. It is wrapped in a do
-- block so every local inside keeps its original name and cannot collide
-- with anything else in the hub. Nothing here was rewritten; the only
-- additions are the WS local and the SA export at the bottom.
--
-- How it works: the client sends its own bullet trace in data.Paths, and
-- the server trusts it. Step 1 is rewritten to say the round hit the
-- target with Human=true; the later Steps are deleted so it never spends
-- its energy on a wall (that is the wallbang).
-- =============================================
do
local WS = workspace

local CFG = {
    on        = false,
    fovDeg    = 25,

    wDir      = true,   -- rewrite data.Direction
    wEnd      = true,   -- EndPosition / EndDistance
    wPart     = true,   -- Step.Part -> the target's body part
    wPos      = true,   -- Step.Position / Normal / Distance
    wHuman    = true,   -- Step.Human = true
    wTrim     = true,   -- delete Steps 2..n (this is the wallbang)
    wStop     = true,   -- overwrite Paths.Stop
    stopValue = "Energy",   -- Energy is the value the client's own trace produces
    wBuild    = true,   -- build Steps[1] when the real shot hit nothing

    showFov = true, showLine = true, esp = true, espMaxDist = 800,
    alive = true,
}

local A = { shots = 0, hits = 0 }
local B = { shots = 0, hits = 0 }
local stuck, tried = 0, 0
local lastInfo, lastStop = "-", "?"
local log = {}
local function logLine(s)
    table.insert(log,1,s) if #log>7 then table.remove(log) end print("[SA4] "..s)
end

local hasDrawing = false
pcall(function() local d=Drawing.new("Line") pcall(function() d:Remove() end) hasDrawing=true end)

local function myHead()
    local c = LP.Character
    return c and (c:FindFirstChild("Head") or c:FindFirstChild("HumanoidRootPart"))
end

--=====================================================================
-- targets (players only)
--=====================================================================
local candidates = {}
local target = { part = nil, pos = nil, name = "-", model = nil }

task.spawn(function()
    while CFG.alive do
        local head = myHead()
        local list = {}
        if head then
            local from = head.Position
            for _, pl in ipairs(Players:GetPlayers()) do
                if pl ~= LP and pl.Character then
                    local p = pl.Character:FindFirstChild("Head")
                           or pl.Character:FindFirstChild("UpperTorso")
                           or pl.Character:FindFirstChild("HumanoidRootPart")
                    local h = pl.Character:FindFirstChildOfClass("Humanoid")
                    if p and h and h.Health > 0 then
                        list[#list+1] = { model=pl.Character, part=p, hum=h,
                                          name=pl.Name, dist=(p.Position-from).Magnitude }
                    end
                end
            end
        end
        candidates = list

        if CFG.on and head then
            local from = head.Position
            local look = WS.CurrentCamera.CFrame.LookVector
            local best, bestAng = nil, CFG.fovDeg
            for _, c in ipairs(candidates) do
                local d = c.part.Position - from
                if d.Magnitude > 1 then
                    local ang = math.deg(math.acos(math.clamp(d.Unit:Dot(look),-1,1)))
                    if ang < bestAng then bestAng, best = ang, c end
                end
            end
            if best then
                target.part, target.pos = best.part, best.part.Position
                target.model, target.name = best.model, best.name
            else
                target.part, target.pos, target.model, target.name = nil, nil, nil, "-"
            end
        else
            target.part, target.pos, target.model, target.name = nil, nil, nil, "-"
        end
        task.wait(0.05)
    end
end)

