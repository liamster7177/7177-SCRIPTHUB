-- build a path that says: the round went straight into this person
--=====================================================================
local function forgePath(data, origin, hitPos, hitPart)
    local dir   = (hitPos - origin)
    local dist  = dir.Magnitude
    if dist < 0.01 then return "too close" end
    dir = dir.Unit

    local fails = {}

    if CFG.wDir then setV(data, "Direction", dir, fails) end

    local paths = data.Paths
    if type(paths) ~= "table" then return "no Paths" end
    local p1 = paths[1]
    if type(p1) ~= "table" then return "no Paths[1]" end

    lastStop = tostring(rawget(p1, "Stop") or p1.Stop)

    if CFG.wEnd then
        setV(p1, "EndPosition", hitPos, fails)
        setV(p1, "EndDistance", dist, fails)
    end

    local steps = p1.Steps
    if type(steps) ~= "table" then return "no Steps" end

    local s1 = steps[1]

    -- Aiming at open sky means the real round hit no surface, so Steps is
    -- empty and there is nothing to rewrite -- that is why it only works
    -- when you are already pointed near someone. Build the step instead.
    if type(s1) ~= "table" and CFG.wBuild then
        local made = {
            Part = hitPart, Position = hitPos,
            Normal = -dir, ExitNormal = dir,
            Distance = dist, ExitDistance = dist + 0.6,
            Human = true, Material = "Plastic",
        }
        if pcall(function() steps[1] = made end) then
            local okR, back = pcall(function() return steps[1] end)
            if okR and type(back) == "table" then s1 = back end
        end
    end

    if type(s1) ~= "table" then return "no Steps[1]" end

    if CFG.wPart  then setV(s1, "Part", hitPart, fails) end
    if CFG.wHuman then setV(s1, "Human", true, fails) end
    if CFG.wPos then
        setV(s1, "Position",     hitPos, fails)
        setV(s1, "Normal",      -dir,    fails)
        setV(s1, "ExitNormal",   dir,    fails)
        setV(s1, "Distance",     dist,   fails)
        setV(s1, "ExitDistance", dist + 0.6, fails)
        setV(s1, "Material", "Plastic", fails)
    end

    -- wallbang: every Step after the first is a wall the round ploughed
    -- through. Remove them and it never spent its energy.
    local trimmed = 0
    if CFG.wTrim then
        for i = 2, 12 do
            if rawget(steps, i) ~= nil or steps[i] ~= nil then
                if pcall(function() steps[i] = nil end) then
                    local okR, back = pcall(function() return steps[i] end)
                    if okR and back == nil then trimmed = trimmed + 1 end
                end
            end
        end
    end

    if CFG.wStop then setV(p1, "Stop", CFG.stopValue, fails) end

    return ("trim %d  fails: %s"):format(
        trimmed, #fails > 0 and table.concat(fails, ",", 1, math.min(#fails,5)) or "none")
end

