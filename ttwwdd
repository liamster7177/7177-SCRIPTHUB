local function addToggle(section, label, cfgTable, cfgKey, cb)
    return section:AddLabel(label):AddToggle({
        Default = cfgTable[cfgKey] or false,
        Flag = "oh_"..label:gsub("[^%w]","_"),
        Callback = function(v) cfgTable[cfgKey]=v if cb then cb(v) end end,
    })
end
local function addSlider(section, label, cfgTable, cfgKey, min, max, step, decimals, cb)
    local def = cfgTable[cfgKey]
    if type(def) ~= "number" then def = min end
    def = math.clamp(def, min, max)
    return section:AddLabel(label):AddSlider({
        Min=min, Max=max, Default=def,
        Rounding = decimals or ((step and step < 1) and 2 or 0),
        Flag = "oh_"..label:gsub("[^%w]","_"),
        Callback = function(v) cfgTable[cfgKey]=v if cb then cb(v) end end,
    })
end
local function addDropdown(section, label, options, cfgTable, cfgKey, cb)
    return section:AddLabel(label):AddDropdown({
