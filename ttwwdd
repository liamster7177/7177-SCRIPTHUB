local corpseCache = { list = {}, at = 0 }
local CORPSE_REFRESH = 1.0
local CORPSE_FOLDERS = { "Characters","Corpses","DeadBodies","Dead","Bodies","Graveyard" }
-- A body has a head AND a torso. Requiring only a head let map props and
-- mannequins into the list, which is what produced boxes on random objects.
local function looksLikeBody(m)
    if not m:FindFirstChild("Head") then return false end
    return (m:FindFirstChild("UpperTorso") or m:FindFirstChild("LowerTorso")
         or m:FindFirstChild("Torso") or m:FindFirstChild("HumanoidRootPart")) ~= nil
end

local function refreshCorpseCache()
    corpseCache.at = os.clock()
    local list, seen = {}, {}
    local myChar = LP.Character

    for _, folderName in ipairs(CORPSE_FOLDERS) do
        local f = workspace:FindFirstChild(folderName)
        if f then
            for _, m in ipairs(f:GetChildren()) do
                -- skip live players and yourself; the Characters folder is
                -- full of them and they were filling the draw pool
                if m:IsA("Model") and not seen[m] and m ~= myChar
                   and not Players:GetPlayerFromCharacter(m)
                   and looksLikeBody(m) then
                    seen[m] = true
                    list[#list+1] = m
                end
            end
        end
    end

    for _, m in ipairs(workspace:GetChildren()) do
        if m:IsA("Model") and not seen[m] and m ~= myChar
           and not Players:GetPlayerFromCharacter(m)
           and not m:FindFirstChildOfClass("Humanoid")
           and looksLikeBody(m) then
            seen[m] = true
            list[#list+1] = m
        end
    end
    corpseCache.list = list
end
-- Corpses ragdoll, so a head-anchored box is wrong. Project every body part
-- and take the screen-space extents instead.
local CORPSE_PARTS = {
    Head=true, UpperTorso=true, LowerTorso=true, Torso=true, HumanoidRootPart=true,
    LeftUpperArm=true, RightUpperArm=true, LeftLowerArm=true, RightLowerArm=true,
    LeftUpperLeg=true, RightUpperLeg=true, LeftLowerLeg=true, RightLowerLeg=true,
    LeftHand=true, RightHand=true, LeftFoot=true, RightFoot=true,
}
local function corpseBox(m)
    local minX, minY = math.huge, math.huge
    local maxX, maxY = -math.huge, -math.huge
    local any = false
    for _, p in ipairs(m:GetChildren()) do
        if p:IsA("BasePart") and CORPSE_PARTS[p.Name] then
            local s, on = Cam:WorldToViewportPoint(p.Position)
            if on and s.Z > 0 then
                any = true
                if s.X < minX then minX = s.X end
                if s.Y < minY then minY = s.Y end
                if s.X > maxX then maxX = s.X end
                if s.Y > maxY then maxY = s.Y end
            end
        end
    end
    if not any then return nil end
    local pad = 6
    return minX - pad, minY - pad, (maxX - minX) + pad*2, (maxY - minY) + pad*2
end

local function getCorpseList()
    local now = os.clock()
    if now - corpseCache.at >= CORPSE_REFRESH then refreshCorpseCache() end
    return corpseCache.list
