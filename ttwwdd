-- =============================================
-- TELEPORT  (drop-through-floor + CFrame)
-- Noclip on -> you sink through the ground for a couple of seconds ->
-- CFrame straight to the destination -> collision restored. Every TP
-- entry point (click, player, death/respawn, zombie, corpse) uses this.
-- =============================================
local TP = { active = false, phase = "idle" }

function AR2_tpBusy() return TP.active end
function AR2_tpPhase() return TP.phase end

local function tpRoot()
    local char = LP.Character
    return char and char:FindFirstChild("HumanoidRootPart"), char
end

-- resolve a live destination at the moment we actually land
local function resolveDest(opts)
    if opts.player and opts.player.Parent then
        local ch  = opts.player.Character
        local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
        if hrp then
            local off = hrp.CFrame.LookVector * 3 + Vector3.new(0, AR2_CFG.tp.tpOffsetY or 4, 0)
            return hrp.Position + off
        end
        return nil
    end
    return opts.pos
end

function AR2_teleportStart(opts)
    opts = opts or {}
    if TP.active then return false end
    if not opts.player and not opts.pos then return false end

    local root, char = tpRoot()
    if not root or not char then return false end

    TP.active = true
    task.spawn(function()
        local ok, err = pcall(function()
            local hum = char:FindFirstChildWhichIsA("Humanoid")
            local wasNoclip = AR2_CFG.misc.noclip

            -- 1. sink
            TP.phase = "dropping"
            AR2_CFG.misc.noclip = true
            AR2_startNoclip()
            if hum then hum.PlatformStand = true end
            tpBeam.Visible = false

            -- fall under normal gravity. Forcing a -60 velocity is a speed
            -- spike this game's anticheat can see; with collision off you
            -- sink on your own anyway.
            local fall = AR2_CFG.tp.fallTime or 2.5
            local t0 = os.clock()
            while os.clock() - t0 < fall do
                if not TP.active then break end
                local r = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                if not r then break end
                task.wait(0.05)
            end

            -- 2. CFrame to the destination and HOLD it.
            -- This game runs AntiTPClientReanchor, which puts you back after a
            -- single write. Writing continuously for a moment outlasts it, and
            -- then we check whether we actually arrived and retry if not.
            TP.phase = "arriving"
            local dest = resolveDest(opts)
            local hold = AR2_CFG.tp.holdTime or 0.8
            local arrived = false

            for attempt = 1, (AR2_CFG.tp.retries or 3) do
                if not TP.active then break end
                dest = resolveDest(opts) or dest
                if not dest then break end

                local h0 = os.clock()
                while os.clock() - h0 < hold do
                    if not TP.active then break end
                    local r = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                    if not r then break end
                    r.CFrame = CFrame.new(dest)
                    r.AssemblyLinearVelocity = Vector3.zero
                    r.AssemblyAngularVelocity = Vector3.zero
                    task.wait()
                end

                local r = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                if r and dest and (r.Position - dest).Magnitude < 25 then
                    arrived = true
                    TP.phase = "arrived"
                    break
                end
                TP.phase = ("retry %d"):format(attempt)
                task.wait(0.15)
            end

            if not arrived then TP.phase = "reanchored" end

            -- 3. settle, then hand collision back
            TP.phase = "settling"
            task.wait(AR2_CFG.tp.settleTime or 0.35)
            if not wasNoclip then AR2_stopNoclip() end
            local h2 = LP.Character and LP.Character:FindFirstChildWhichIsA("Humanoid")
            if h2 then h2.PlatformStand = false h2.Sit = false end
        end)
        if not ok then warn("[Origin HUB] teleport error: " .. tostring(err)) end
        TP.active = false
        TP.phase = "idle"
        pcall(function() tpBeam.Visible = false end)
    end)
    return true
end

function AR2_teleportStop()
    TP.active = false
    TP.phase = "idle"
    pcall(function() tpBeam.Visible = false end)
    local h = LP.Character and LP.Character:FindFirstChildWhichIsA("Humanoid")
    if h then h.PlatformStand = false h.Sit = false end
end

