            pcall(function() if win.SetAccent then win:SetAccent(v) end end)
        end)
        addColorPicker(uiS, "Background", AR2_CFG.ui, "background", function() AR2_queueRebuild(0.15) end)
        addColorPicker(uiS, "Panel", AR2_CFG.ui, "panel", function() AR2_queueRebuild(0.15) end)
        addSlider(uiS, "Transparency %", AR2_CFG.ui, "transparency", 0, 100, 5, 0)
        addSlider(uiS, "Corner Radius", AR2_CFG.ui, "cornerRadius", 0, 24, 1, 0)
        addToggle(uiS, "Glow", AR2_CFG.ui, "glow")
        addToggle(uiS, "Compact", AR2_CFG.ui, "compact")
        addButton(uiS, "Apply Theme", function() AR2_queueRebuild(0.1) end)

        local themeS = setTab:AddSection({Name="Theme Presets"})
        local function preset(acc, hue, bg, panel)
            AR2_CFG.ui.accent = acc AR2_CFG.ui.accentHue = hue AR2_CFG.ui.background = bg AR2_CFG.ui.panel = panel
            AR2_queueRebuild(0.1)
        end
        addButton(themeS, "Orange", function() preset(Color3.fromRGB(255,140,30), 30, Color3.fromRGB(14,14,14), Color3.fromRGB(20,20,20)) end)
        addButton(themeS, "Red", function() preset(Color3.fromRGB(230,40,60), 354, Color3.fromRGB(14,14,14), Color3.fromRGB(20,20,20)) end)
        addButton(themeS, "Cyan", function() preset(Color3.fromRGB(40,200,230), 188, Color3.fromRGB(10,14,18), Color3.fromRGB(18,22,28)) end)
        addButton(themeS, "Purple", function() preset(Color3.fromRGB(160,60,240), 275, Color3.fromRGB(14,10,20), Color3.fromRGB(22,18,30)) end)
        addButton(themeS, "Green", function() preset(Color3.fromRGB(80,220,120), 130, Color3.fromRGB(10,18,12), Color3.fromRGB(18,26,20)) end)

        local rS = setTab:AddSection({Name="Reset", Position="right"})
        addButton(rS, "Reset All Settings", function()
            for k, v in pairs(AR2_CFG) do
                if type(v) == "table" then for k2, v2 in pairs(v) do if type(v2)=="boolean" then v[k2]=false end end end
            end
            AR2_teleportStop()
            AR2_stopNoclip()
            AR2_teleportStop()
            unfreezeAll()
            pcall(restoreFullbright) pcall(restoreFog)
            restorePersonalChar() restorePersonalGun()
            setTungSelf(false) setTungGlobal(false)
            carNoclipStop()
            clearLootHighlights()
            AR2_deathTP.saved = nil
            AR2_toggleMapTP(false)
            AR2_queueRebuild(0.2)
        end)
        addButton(rS, "Reset UI", function()
            AR2_CFG.ui.accent = Color3.fromRGB(255,140,30) AR2_CFG.ui.accentHue = 30
            AR2_CFG.ui.background = Color3.fromRGB(14,14,14) AR2_CFG.ui.panel = Color3.fromRGB(20,20,20)
            AR2_CFG.ui.transparency = 0.15 AR2_CFG.ui.cornerRadius = 8
            AR2_CFG.ui.glow = true AR2_CFG.ui.compact = false
            AR2_CFG.ui.sizePreset = "Default"
            AR2_queueRebuild(0.2)
        end)

        Notif.new({Title="Origin HUB", Content="Loaded — press P", Duration=5})
    end)
    if not uiBuildOk and uiBuildErr then warn("[Origin HUB] UI build failed: "..tostring(uiBuildErr)) end
    captureNewGuisInto(snapshot, AR2_uiGuisToDestroy)
    if win then
        AR2_uiWindowRef = win
        pcall(function() if win.UI and win.UI.Destroy then table.insert(AR2_uiGuisToDestroy, win.UI) end end)
        pcall(function() if win.Gui and win.Gui.Destroy then table.insert(AR2_uiGuisToDestroy, win.Gui) end end)
        pcall(function() if win.ScreenGui and win.ScreenGui.Destroy then table.insert(AR2_uiGuisToDestroy, win.ScreenGui) end end)
        pcall(function() if win.Object and win.Object.Destroy then table.insert(AR2_uiGuisToDestroy, win.Object) end end)
    end
end

task.spawn(AR2_buildUI)

task.delay(2, function()
    if AR2_CFG.misc.skybox and AR2_CFG.misc.skybox ~= "Default" then
        pcall(applySkybox, AR2_CFG.misc.skybox)
    end
end)
