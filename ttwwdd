    else aimFovCircle.Visible = false end
    if SA.on and AR2_CFG.silent.showFov then
        -- radius derived from the real camera FOV so the ring matches the
        -- degrees the targeting actually uses
        local _halfH = Cam.ViewportSize.Y / 2
        local _camHalf = math.rad(Cam.FieldOfView / 2)
        local _r = (_camHalf > 0)
            and (_halfH * math.tan(math.rad(SA.fovDeg or 25)) / math.tan(_camHalf))
            or 150
        silentFovCircle.Position = centre silentFovCircle.Radius = _r
        silentFovCircle.Color = Color3.fromRGB(255,120,220) silentFovCircle.Visible = true
