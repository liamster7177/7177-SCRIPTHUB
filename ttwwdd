-- =============================================
-- APPLY CONFIG
-- Loading a config used to only merge tables, so the game kept running with
-- the old settings until you re-toggled each one. This pushes every loaded
-- value into the live game state. Each call is isolated, so one bad setter
-- cannot stop the rest -- that failure mode silently skipped half the config.
-- =============================================
function AR2_applyConfig()
    local function try(fn, ...)
        if type(fn) ~= "function" then return end
        local ok, err = pcall(fn, ...)
        if not ok then warn("[Origin HUB] apply: " .. tostring(err)) end
    end

    -- movement
    try(function()
        if AR2_CFG.misc.noclip then AR2_startNoclip() else AR2_stopNoclip() end
    end)

    -- vehicles
    try(function() carNoclipSetEnabled(AR2_CFG.cars.noclip) end)

    -- visuals
    try(applyFullbright)
    try(applyNoFog)
    try(applyClouds)
    try(applyCustomAmbient)
    -- the skybox key lives on .misc, not .visuals. Passing nil here made
    -- applySkybox wipe the saved name and clear the sky instead of setting it.
    try(function() applySkybox(AR2_CFG.misc.skybox or "Default") end)
    try(toggleTextures)
    try(toggleTrees)
    try(toggleDoors)
    try(toggleSunRays)
    try(applyPersonalChar)
    try(applyPersonalGun)

    -- cosmetics / chams
    try(function() setTungSelf(AR2_CFG.misc.tungSelf) end)
    try(function() setTungGlobal(AR2_CFG.players.tungGlobal) end)
    try(setLootHighlight)

    -- zoom
    try(function() setFOVZoom(AR2_CFG.misc.fovZoom) end)
    try(function() setDistZoomEnabled(AR2_CFG.misc.distZoomEnabled) end)
    try(function() setDistZoomActive(AR2_CFG.misc.distZoomActive) end)

    -- caches the ESP reads from
    try(function() AR2_setSpin(AR2_spin.on) end)
    try(refreshCorpseCache)
    try(refreshLootList)
end

