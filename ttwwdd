-- Trigger bot status, shown in the UI so you can see why it is or is not firing
AR2_trigStatus = "off"

RunSvc.Heartbeat:Connect(function()
    local t = AR2_CFG.trigger
    if not t.on then
        AR2_trigStatus = "off"
        if trigFiring and os.clock() >= trigReleaseAt then trigRelease() end
        return
    end
    if trigFiring then if os.clock() >= trigReleaseAt then trigRelease() end return end
    if t.holdRMB and not UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
        AR2_trigStatus = "waiting for RMB"
        return
    end

    local char = LP.Character
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not hum or hum.Health <= 0 or not root then AR2_trigStatus = "no character" return end

    local target, how

    -- Silent aim already picks a target and forges the bullet path to it, so
    -- reusing that target means the trigger fires exactly when the forge can
    -- actually land the shot. This is what gives 360 without a separate bot.
    if t.useSilent and SA and SA.on and SA_target and SA_target.pos then
        local d = (SA_target.pos - root.Position).Magnitude
        if d <= t.maxDist then
            target, how = SA_target.pos, "silent"
        end
    end

    if not target then
        local p
        if t.mode360 then p = findTriggerTarget360() else p = findTriggerTarget() end
        if p then
            -- 360 targeting ignored maxDist before, so it fired at anything
            local pos = (typeof(p) == "Instance" and p.Position) or p
            if typeof(pos) == "Vector3" and (pos - root.Position).Magnitude <= t.maxDist then
                target, how = pos, t.mode360 and "360" or "fov"
            end
        end
    end

    if not target then AR2_trigStatus = "no target" return end
    if not toolReady() then AR2_trigStatus = "no weapon" return end

    local now = os.clock()
    if now - trigLastShot < t.delay then return end
    trigLastShot = now

    AR2_trigStatus = "FIRING (" .. tostring(how) .. ")"
    trigPress()
    trigReleaseAt = now + 0.015

    -- optional burst: extra shots after the first
    local n = math.floor(t.burst or 1)
    if n > 1 then
        task.spawn(function()
            for _ = 2, n do
                task.wait(t.burstGap or 0.04)
                if not AR2_CFG.trigger.on then break end
                pcall(trigPress)
                task.wait(0.015)
                pcall(trigRelease)
            end
        end)
    end
end)

