local frozenRoots = {}
local function freezeAllWalkers()
    local container = getZombieContainer() if not container then return end
    local origin = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    local originPos = origin and origin.Position or Vector3.zero
    local seen = {}
    for _, m in ipairs(container:GetChildren()) do
        if m:IsA("Model") then
            local root = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart
            if root and root:IsA("BasePart") then
                local ok = true
                if not AR2_CFG.misc.freezeAll and origin then
                    ok = (root.Position - originPos).Magnitude <= AR2_CFG.misc.freezeRadius
                end
                if ok then
                    seen[m] = true
                    if not frozenRoots[m] then
                        frozenRoots[m] = { cf = root.CFrame, parts = {} }
                        for _, part in ipairs(m:GetDescendants()) do
                            if part:IsA("BasePart") then
                                frozenRoots[m].parts[part] = part.Anchored
                                part.Anchored = true
                            end
                        end
                    end
                    root.CFrame = frozenRoots[m].cf
                    root.AssemblyLinearVelocity = Vector3.zero
                    root.AssemblyAngularVelocity = Vector3.zero
                end
            end
        end
    end
    for model, data in pairs(frozenRoots) do
        if not seen[model] or not model.Parent then
            for part, orig in pairs(data.parts) do
                if part and part.Parent then part.Anchored = orig end
            end
            frozenRoots[model] = nil
        end
    end
end
local function unfreezeAll()
    for model, data in pairs(frozenRoots) do
        for part, orig in pairs(data.parts) do
            if part and part.Parent then part.Anchored = orig end
        end
    end
    frozenRoots = {}
end
RunSvc.Heartbeat:Connect(function()
    if not AR2_CFG.misc.freeze then
        if next(frozenRoots) then unfreezeAll() end
        return
    end
    freezeAllWalkers()
end)

