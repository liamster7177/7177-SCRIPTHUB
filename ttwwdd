-- =============================================
-- SPIN BOT
-- Rotates the BODY, not the camera. The camera is anchored to the
-- HumanoidRootPart, so spinning the root spins your view too -- instead this
-- drives the LowerTorso's Motor6D C0, which moves the torso and everything
-- welded above it while the root (and your view) stays put.
--
-- It runs on BindToRenderStep AFTER the character step, because physics
-- rewrites joint C0 every Heartbeat and whatever writes last wins.
-- =============================================
AR2_spin = { on = false, speed = 20, tilt = false }

do
    local joint, baseC0, angle = nil, nil, 0

    local function findJoint()
        local ch = LP.Character
        if not ch then return nil end
        local lt = ch:FindFirstChild("LowerTorso")
        if lt then
            for _, d in ipairs(lt:GetChildren()) do
                if d:IsA("Motor6D") then return d end
            end
        end
        local hrp = ch:FindFirstChild("HumanoidRootPart")     -- R6 fallback
        if hrp then
            local rj = hrp:FindFirstChild("RootJoint")
            if rj and rj:IsA("Motor6D") then return rj end
        end
        return nil
    end

    function AR2_setSpin(on)
        AR2_spin.on = on
        if not on then
            -- put the torso back where the game had it
            if joint and joint.Parent and baseC0 then
                pcall(function() joint.C0 = baseC0 end)
            end
            joint, baseC0 = nil, nil
        end
    end

    LP.CharacterAdded:Connect(function()
        joint, baseC0 = nil, nil
    end)

    pcall(function()
        RunSvc:BindToRenderStep("AR2_SpinBot", Enum.RenderPriority.Character.Value + 1, function(dt)
            if not AR2_spin.on then return end
            if not joint or not joint.Parent then
                joint = findJoint()
                baseC0 = joint and joint.C0 or nil
            end
            if not joint or not baseC0 then return end
            angle = (angle + AR2_spin.speed * dt) % (math.pi * 2)
            local cf = CFrame.Angles(0, angle, 0)
            if AR2_spin.tilt then
                cf = cf * CFrame.Angles(math.rad(25) * math.sin(angle * 2), 0, 0)
            end
            pcall(function() joint.C0 = baseC0 * cf end)
        end)
    end)
end

-- =============================================
-- BULLET TRACERS
-- Watches the silent-aim shot counter from outside the forge block, so the
-- working code is never touched. Each new shot draws a fading line from your
-- muzzle to where the round was sent. Fixed pool, so no Drawing leaks.
-- =============================================
AR2_tracer = { on = false, life = 0.45, thickness = 2,
               color = Color3.fromRGB(120, 220, 255) }

do
    local MAX = 24
    local lines, shots = {}, {}
    local lastCount, nextSlot = 0, 1

    for i = 1, MAX do
        local l = Drawing.new("Line")
        l.Thickness = 2
        l.Color = AR2_tracer.color
        l.Transparency = 1
        l.Visible = false
        lines[i] = l
        shots[i] = nil
    end

    -- detect a new shot by watching the counter the forge block exports
    task.spawn(function()
        while true do
            if AR2_tracer.on then
                local okS, count = pcall(SA_status)
                if okS and count and count ~= lastCount then
                    lastCount = count
                    local ch = LP.Character
                    local from = ch and (ch:FindFirstChild("Head")
                                      or ch:FindFirstChild("HumanoidRootPart"))
                    local to = SA_target and SA_target.pos
                    if from and to then
                        shots[nextSlot] = { a = from.Position, b = to, born = os.clock() }
                        nextSlot = nextSlot % MAX + 1
                    end
                end
            end
            task.wait(0.03)
        end
    end)

    RunSvc.RenderStepped:Connect(function()
        local cam = workspace.CurrentCamera
        local now = os.clock()
        for i = 1, MAX do
            local s, l = shots[i], lines[i]
            if s and AR2_tracer.on then
                local age = now - s.born
                if age >= AR2_tracer.life then
                    shots[i] = nil
                    l.Visible = false
                else
                    local sa, oa = cam:WorldToViewportPoint(s.a)
                    local sb, ob = cam:WorldToViewportPoint(s.b)
                    if oa and ob and sa.Z > 0 and sb.Z > 0 then
                        l.From = Vector2.new(sa.X, sa.Y)
                        l.To   = Vector2.new(sb.X, sb.Y)
                        l.Color = AR2_tracer.color
                        l.Thickness = AR2_tracer.thickness
                        l.Transparency = 1 - (age / AR2_tracer.life)
                        l.Visible = true
                    else
                        l.Visible = false
                    end
                end
            elseif l.Visible then
                l.Visible = false
            end
        end
    end)
end

