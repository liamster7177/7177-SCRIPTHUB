local function toggleTrees(on)
    if on then
        local function check(name) local l = name:lower() for _, kw in ipairs(TREE_KEYWORDS) do if l:find(kw, 1, true) then return true end end return false end
        local function hide(model) for _, part in ipairs(model:GetDescendants()) do if part:IsA("BasePart") and not savedTrees[part] then savedTrees[part] = part.Transparency part.Transparency = 1 end end end
        local function checkAndHide(obj)
            if check(obj.Name) then
                if obj:IsA("Model") or obj:IsA("Folder") then hide(obj)
                elseif obj:IsA("BasePart") and not savedTrees[obj] then savedTrees[obj] = obj.Transparency obj.Transparency = 1 end
            end
        end
        for _, obj in ipairs(workspace:GetChildren()) do
            checkAndHide(obj)
            if obj:IsA("Folder") or obj:IsA("Model") then for _, child in ipairs(obj:GetChildren()) do checkAndHide(child) end end
        end
    else
        for part, t in pairs(savedTrees) do if part and part.Parent then part.Transparency = t end end
        savedTrees = {}
    end
end
