-- TELEPORT
-- =============================================
local TP = { active=false, conn=nil, targetPos=nil, targetPlayer=nil, speed=nil, startedNoclip=false, onArrive=nil }

local function TP_applyDelta(deltaCF)
    if not ncRoot or not ncRoot.Parent then return end
    ncRoot.CFrame = ncRoot.CFrame + deltaCF
    for p, offset in pairs(ncOffsets) do if p and p.Parent then p.CFrame = ncRoot.CFrame * offset end end
end
local function TP_currentTargetPos()
    if TP.targetPlayer and TP.targetPlayer.Parent then
        local ch = TP.targetPlayer.Character
        local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
        if hrp then
            local offset = hrp.CFrame.LookVector * 3 + Vector3.new(0, AR2_CFG.tp.tpOffsetY or 4, 0)
            return hrp.Position + offset
        end
    end
    return TP.targetPos
end
local function TP_stop(arrived)
    TP.active = false
    if TP.conn then TP.conn:Disconnect() TP.conn = nil end
    tpBeam.Visible = false
    ncAutopilot = false
    if arrived and TP.startedNoclip then
        task.wait(0.05)
        AR2_stopNoclip()
    end
    if arrived and TP.onArrive then local cb = TP.onArrive TP.onArrive = nil pcall(cb) end
    TP.targetPlayer = nil TP.targetPos = nil TP.speed = nil
end
function AR2_teleportStart(opts)
    opts = opts or {}
    local targetPlayer = opts.player
    local targetPos = opts.pos
    if not targetPlayer and not targetPos then return false end
    if targetPlayer and (not targetPlayer.Character or not targetPlayer.Character:FindFirstChild("HumanoidRootPart")) then return false end
    if TP.active then TP_stop(false) end
    local alreadyOn = (ncConn ~= nil and ncRoot ~= nil and ncRoot.Parent ~= nil)
    if not alreadyOn then AR2_CFG.misc.noclip = true AR2_startNoclip() task.wait(0.1) end
    if not (ncConn and ncRoot and ncRoot.Parent) then return false end
    TP.targetPlayer = targetPlayer
    TP.targetPos = targetPos
    TP.speed = 10000
    TP.startedNoclip = not alreadyOn
    TP.onArrive = opts.onArrive
    TP.active = true
    ncAutopilot = true
    TP.conn = RunSvc.Heartbeat:Connect(function(dt)
        if not TP.active then if TP.conn then TP.conn:Disconnect() TP.conn = nil end return end
        if not (ncRoot and ncRoot.Parent) then TP_stop(false) return end
        local dest = TP_currentTargetPos()
        if not dest then TP_stop(false) return end
        local cur = ncRoot.Position
        local delta = dest - cur
        local dist = delta.Magnitude
        if dist <= (AR2_CFG.tp.arrivalDist or 4) then
            TP_applyDelta(dest - cur)
            tpBeam.Visible = false
            TP_stop(true)
            return
        end
        local step = math.min(TP.speed * dt, dist)
        TP_applyDelta(delta.Unit * step)
        local myPos = ncRoot.Position
        local fromScr, fromOn = Cam:WorldToViewportPoint(myPos)
        local toScr, toOn = Cam:WorldToViewportPoint(dest)
        if fromOn and toOn and fromScr.Z > 0 and toScr.Z > 0 then
            tpBeam.From = Vector2.new(fromScr.X, fromScr.Y)
            tpBeam.To   = Vector2.new(toScr.X, toScr.Y)
            tpBeam.Visible = true
        else tpBeam.Visible = false end
    end)
    return true
end
function AR2_teleportStop() TP_stop(false) end
function AR2_teleportToPosition(vec) return AR2_teleportStart({ pos = vec }) end
function AR2_teleportToNearestZombie()
    local zc = getZombieContainer()
    local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not zc or not hrp then return false end
    local bestRoot, bestD = nil, math.huge
    for _, m in ipairs(zc:GetChildren()) do
        if m:IsA("Model") then
            local r = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart
            if r and r:IsA("BasePart") then
                local d = (r.Position - hrp.Position).Magnitude
                if d < bestD then bestD = d bestRoot = r end
            end
        end
    end
    if not bestRoot then return false end
    return AR2_teleportStart({ pos = bestRoot.Position + Vector3.new(0, 5, 0) })
end
function AR2_teleportToNearestCorpse()
    local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local list = getCorpseList and getCorpseList() or {}
    local best, bestD = nil, math.huge
    for _, m in ipairs(list) do
        local r = m:FindFirstChild("HumanoidRootPart") or m:FindFirstChild("Head")
        if r then
            local d = (r.Position - hrp.Position).Magnitude
            if d < bestD then bestD = d best = r end
        end
    end
    if not best then return false end
    return AR2_teleportStart({ pos = best.Position + Vector3.new(0, 5, 0) })
end
function AR2_teleportToNearestPlayer()
    local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local best, bestD = nil, math.huge
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= LP and pl.Character then
            local r = pl.Character:FindFirstChild("HumanoidRootPart")
            if r then
                local d = (r.Position - hrp.Position).Magnitude
                if d < bestD then bestD = d best = pl end
            end
        end
    end
    if not best then return false end
    return AR2_teleportStart({ player = best })
end

