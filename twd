-- NOCLIP / DESYNC
-- =============================================
local ncConn, ncRoot = nil, nil
local ncParts, ncOffsets = {}, {}
local ncKeys = {W=false,A=false,S=false,D=false,Space=false,LeftControl=false}
local ncAutopilot = false

local function AR2_stopNoclip()
    AR2_CFG.misc.noclip = false
    ncAutopilot = false
    if ncConn then ncConn:Disconnect() ncConn=nil end
    for _, p in ipairs(ncParts) do pcall(function() if p and p.Parent then p.Anchored=false p.Velocity=Vector3.zero p.RotVelocity=Vector3.zero end end) end
    ncParts, ncOffsets = {}, {} ncRoot=nil
    for k in pairs(ncKeys) do ncKeys[k]=false end
    local char = LP.Character if char then local h=char:FindFirstChild("Humanoid") if h then h.Sit=false h.PlatformStand=false end end
end

local function AR2_startNoclip()
    if ncConn then return end
    local char = LP.Character if not char then return end
    local hum = char:FindFirstChild("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not (hum and root) then return end
    hum.Sit=true hum.PlatformStand=true
    local parts = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and (obj.Position-root.Position).Magnitude <= 15 then table.insert(parts, obj) end
    end
    if #parts == 0 then AR2_CFG.misc.noclip=false return end
    ncOffsets = {}
    for _, p in ipairs(parts) do ncOffsets[p] = root.CFrame:Inverse()*p.CFrame end
    ncRoot, ncParts = root, parts
    for _, p in ipairs(parts) do p.Anchored=true end
    ncConn = RunSvc.Heartbeat:Connect(function(dt)
        if not AR2_CFG.misc.noclip then AR2_stopNoclip() return end
        if not ncRoot or not ncRoot.Parent then AR2_stopNoclip() return end
        local h = LP.Character and LP.Character:FindFirstChild("Humanoid")
        if h then h.Sit=true h.PlatformStand=true else AR2_stopNoclip() return end
        if ncAutopilot then return end
        local cam = workspace.CurrentCamera
        local move = Vector3.zero
        if ncKeys.W then move += cam.CFrame.LookVector end
        if ncKeys.S then move -= cam.CFrame.LookVector end
        if ncKeys.D then move += cam.CFrame.RightVector end
        if ncKeys.A then move -= cam.CFrame.RightVector end
        if ncKeys.Space then move += Vector3.new(0,1,0) end
        if ncKeys.LeftControl then move -= Vector3.new(0,1,0) end
        if move.Magnitude > 0 then
            local delta = move.Unit * (AR2_CFG.misc.noclipSpeed or 90) * dt
            local newCF = ncRoot.CFrame + delta
            ncRoot.CFrame = newCF
            for p, offset in pairs(ncOffsets) do if p and p.Parent then p.CFrame = newCF * offset end end
        end
    end)
end

AR2_desync = { active = false, conn = nil, parts = {}, offsets = {}, root = nil }

function AR2_startDesync()
    if AR2_desync.conn then return end
    local char = LP.Character if not char then return end
    local hum = char:FindFirstChild("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not (hum and root) then return end
    AR2_desync.active = true
    AR2_CFG.misc.desync = true
    AR2_desync.root = root
    AR2_desync.parts = {}
    AR2_desync.offsets = {}
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then
            AR2_desync.parts[#AR2_desync.parts + 1] = p
            AR2_desync.offsets[p] = root.CFrame:Inverse() * p.CFrame
            p.Anchored = true
        end
    end
    hum.Sit = true
    hum.PlatformStand = true
    local speed = AR2_CFG.misc.desyncSpeed or 45
    AR2_desync.conn = RunSvc.Heartbeat:Connect(function(dt)
        if not AR2_desync.active then return end
        local c = LP.Character
        local h = c and c:FindFirstChild("Humanoid")
        local r = c and c:FindFirstChild("HumanoidRootPart")
        if not (h and r) then AR2_stopDesync() return end
        h.Sit = true
        h.PlatformStand = true
        local cam = workspace.CurrentCamera
        local move = Vector3.zero
        if UIS:IsKeyDown(Enum.KeyCode.W) then move += cam.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.S) then move -= cam.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.D) then move += cam.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.A) then move -= cam.CFrame.RightVector end
        if move.Magnitude > 0.01 then
            move = Vector3.new(move.X, 0, move.Z).Unit
            local cur = r.Position
            local step = speed * dt
            local newPos = cur + move * step
            local params = RaycastParams.new()
            params.FilterType = Enum.RaycastFilterType.Exclude
            params.FilterDescendantsInstances = { c }
            local hit = workspace:Raycast(newPos + Vector3.new(0, 5, 0), Vector3.new(0, -200, 0), params)
            local finalPos
            if hit then
                finalPos = Vector3.new(newPos.X, hit.Position.Y + 3.2, newPos.Z)
            else
                finalPos = Vector3.new(newPos.X, cur.Y, newPos.Z)
            end
            local newCF = CFrame.new(finalPos) * (r.CFrame - r.CFrame.Position)
            r.CFrame = newCF
            for p, offset in pairs(AR2_desync.offsets) do
                if p and p.Parent then p.CFrame = newCF * offset end
            end
        end
    end)
end

function AR2_stopDesync()
    AR2_desync.active = false
    AR2_CFG.misc.desync = false
    if AR2_desync.conn then AR2_desync.conn:Disconnect() AR2_desync.conn = nil end
    for _, p in ipairs(AR2_desync.parts) do
        if p and p.Parent then
            p.Anchored = false
            p.AssemblyLinearVelocity = Vector3.zero
            p.AssemblyAngularVelocity = Vector3.zero
        end
    end
    AR2_desync.parts = {}
    AR2_desync.offsets = {}
    AR2_desync.root = nil
    local char = LP.Character
    if char then
        local h = char:FindFirstChild("Humanoid")
        if h then h.PlatformStand = false h.Sit = false end
    end
end

