                            AR2_CFG.keybinds[id] = AR2_normalizeKey(newKey)
                            if btn then
                                pcall(function() if btn.SetName then btn:SetName(cur()) end end)
                                pcall(function() if btn.SetText then btn:SetText(cur()) end end)
                            end
                        end)
                    end,
                })
            end)
            return ok2 and btn or nil
        end
        local kbE = kbTab:AddSection({Name="ESP"})
        mkKB(kbE, "Player ESP", "playerESP")
        mkKB(kbE, "Zombie ESP", "zombieESP")
        mkKB(kbE, "Vehicle ESP", "vehicleESP")
        mkKB(kbE, "Corpse ESP", "corpseESP")
        mkKB(kbE, "Loot ESP", "lootESP")
        mkKB(kbE, "Tung Self", "tungSelf")
        mkKB(kbE, "Tung Global", "tungGlobal")
        local kbC = kbTab:AddSection({Name="Combat", Position="right"})
        mkKB(kbC, "Aimbot", "aimbot")
        mkKB(kbC, "Aimbot 360", "aimbot360")
        mkKB(kbC, "Silent Aim", "silentAim")
        mkKB(kbC, "Trigger Bot", "triggerBot")
        mkKB(kbC, "Trigger Bot 360", "triggerBot360")
        mkKB(kbC, "Rapid Fire", "rapidFire")
        mkKB(kbC, "Freeze Zombies", "freezeZ")
        local kbT = kbTab:AddSection({Name="Teleport"})
        mkKB(kbT, "TP → Nearest Player", "tpNearestP")
        mkKB(kbT, "TP → Nearest Zombie", "tpNearestZ")
        mkKB(kbT, "TP → Nearest Corpse", "tpNearestC")
        mkKB(kbT, "Interactive Map", "mapFake")
        mkKB(kbT, "TP → Death Location", "deathTP")
        local kbM = kbTab:AddSection({Name="Movement", Position="right"})
        mkKB(kbM, "Noclip", "noclip")
        mkKB(kbM, "Desync", "desync")
        mkKB(kbM, "Inf Jump", "infJump")
        local kbCar = kbTab:AddSection({Name="Cars", Position="right"})
        mkKB(kbCar, "Vehicle Noclip", "carNoclip")
        local kbMi = kbTab:AddSection({Name="Misc", Position="right"})
        mkKB(kbMi, "Fullbright", "fullbright")
        mkKB(kbMi, "No Fog", "noFog")
        mkKB(kbMi, "Personal Chams", "personalChams")
        mkKB(kbMi, "Dist Zoom", "distZoom")
        mkKB(kbMi, "FOV Zoom", "fovZoom")

        local setTab = win:AddTab({Icon="settings", Name="Settings"})
        local cfgS = setTab:AddSection({Name="Config Manager"})
        AR2_refreshConfigList()
        addButton(cfgS, "Save Config", function()
            promptText("Config name:", "", function(name)
                if not name or name == "" then return end
                if AR2_saveConfig(name) then AR2_queueRebuild(0.2) end
            end)
        end)
        addButton(cfgS, "Load Config", function()
            promptText("Load config name:", "", function(name)
                if not name or name == "" then return end
                if AR2_loadConfigByName(name) then AR2_queueRebuild(0.2) end
            end)
        end)
        addButton(cfgS, "Delete Config", function()
            promptText("Delete config name:", "", function(name)
                if not name or name == "" then return end
                if AR2_deleteConfig(name) then AR2_queueRebuild(0.2) end
            end)
        end)
        addButton(cfgS, "Refresh List", function() AR2_refreshConfigList() AR2_queueRebuild(0.1) end)

        local sizeS = setTab:AddSection({Name="UI Size", Position="right"})
        addDropdown(sizeS, "Size Preset", {"Tiny","Small","Default","Large","Huge","Colossal"},
            AR2_CFG.ui, "sizePreset", function(v) AR2_queueRebuild(0.15) end)

        local uiS = setTab:AddSection({Name="UI Personalization"})
        addSlider(uiS, "Accent Hue", AR2_CFG.ui, "accentHue", 0, 360, 15, 0, function(v)
            AR2_CFG.ui.accent = Color3.fromHSV(math.clamp(v,0,360)/360, 1, 1)
            pcall(function() if NL.SetAccent then NL:SetAccent(AR2_CFG.ui.accent) end end)
            pcall(function() if win.SetAccent then win:SetAccent(AR2_CFG.ui.accent) end end)
        end)
        addColorPicker(uiS, "Accent Color", AR2_CFG.ui, "accent", function(v)
            pcall(function() if NL.SetAccent then NL:SetAccent(v) end end)
            pcall(function() if win.SetAccent then win:SetAccent(v) end end)
        end)
        addColorPicker(uiS, "Background", AR2_CFG.ui, "background", function() AR2_queueRebuild(0.15) end)
        addColorPicker(uiS, "Panel", AR2_CFG.ui, "panel", function() AR2_queueRebuild(0.15) end)
        addSlider(uiS, "Transparency %", AR2_CFG.ui, "transparency", 0, 100, 5, 0)
        addSlider(uiS, "Corner Radius", AR2_CFG.ui, "cornerRadius", 0, 24, 1, 0)
        addToggle(uiS, "Glow", AR2_CFG.ui, "glow")
        addToggle(uiS, "Compact", AR2_CFG.ui, "compact")
        addButton(uiS, "Apply Theme", function() AR2_queueRebuild(0.1) end)

        local themeS = setTab:AddSection({Name="Theme Presets"})
        local function preset(acc, hue, bg, panel)
            AR2_CFG.ui.accent = acc AR2_CFG.ui.accentHue = hue AR2_CFG.ui.background = bg AR2_CFG.ui.panel = panel
            AR2_queueRebuild(0.1)
        end
        addButton(themeS, "Orange", function() preset(Color3.fromRGB(255,140,30), 30, Color3.fromRGB(14,14,14), Color3.fromRGB(20,20,20)) end)
        addButton(themeS, "Red", function() preset(Color3.fromRGB(230,40,60), 354, Color3.fromRGB(14,14,14), Color3.fromRGB(20,20,20)) end)
        addButton(themeS, "Cyan", function() preset(Color3.fromRGB(40,200,230), 188, Color3.fromRGB(10,14,18), Color3.fromRGB(18,22,28)) end)
        addButton(themeS, "Purple", function() preset(Color3.fromRGB(160,60,240), 275, Color3.fromRGB(14,10,20), Color3.fromRGB(22,18,30)) end)
        addButton(themeS, "Green", function() preset(Color3.fromRGB(80,220,120), 130, Color3.fromRGB(10,18,12), Color3.fromRGB(18,26,20)) end)

        local rS = setTab:AddSection({Name="Reset", Position="right"})
        addButton(rS, "Reset All Settings", function()
            for k, v in pairs(AR2_CFG) do
                if type(v) == "table" then for k2, v2 in pairs(v) do if type(v2)=="boolean" then v[k2]=false end end end
            end
            if ncConn then AR2_stopNoclip() end
            if AR2_desync.active then AR2_stopDesync() end
            AR2_teleportStop()
            unfreezeAll()
            pcall(restoreFullbright) pcall(restoreFog)
            restorePersonalChar() restorePersonalGun()
            setTungSelf(false) setTungGlobal(false)
            carNoclipStop()
            clearLootHighlights()
            AR2_deathTP.saved = nil
            AR2_toggleMapTP(false)
            AR2_queueRebuild(0.2)
        end)
        addButton(rS, "Reset UI", function()
            AR2_CFG.ui.accent = Color3.fromRGB(255,140,30) AR2_CFG.ui.accentHue = 30
            AR2_CFG.ui.background = Color3.fromRGB(14,14,14) AR2_CFG.ui.panel = Color3.fromRGB(20,20,20)
            AR2_CFG.ui.transparency = 0.15 AR2_CFG.ui.cornerRadius = 8
            AR2_CFG.ui.glow = true AR2_CFG.ui.compact = false
            AR2_CFG.ui.sizePreset = "Default"
            AR2_queueRebuild(0.2)
        end)

        Notif.new({Title="Origin HUB", Content="Loaded — press P", Duration=5})
    end)
    if not uiBuildOk and uiBuildErr then warn("[Origin HUB] UI build failed: "..tostring(uiBuildErr)) end
    captureNewGuisInto(snapshot, AR2_uiGuisToDestroy)
    if win then
        AR2_uiWindowRef = win
        pcall(function() if win.UI and win.UI.Destroy then table.insert(AR2_uiGuisToDestroy, win.UI) end end)
        pcall(function() if win.Gui and win.Gui.Destroy then table.insert(AR2_uiGuisToDestroy, win.Gui) end end)
        pcall(function() if win.ScreenGui and win.ScreenGui.Destroy then table.insert(AR2_uiGuisToDestroy, win.ScreenGui) end end)
        pcall(function() if win.Object and win.Object.Destroy then table.insert(AR2_uiGuisToDestroy, win.Object) end end)
    end
end

