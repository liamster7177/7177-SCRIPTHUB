                    d.Visible = true
                end
            end
        end
        for j = i + 1, #state.dotPool do state.dotPool[j].Visible = false end
    end

    local M = {}
    function M.setVisible(on)
        if not state.gui or not state.gui.Parent then build() end
        if on == nil then on = not state.gui.Enabled end
