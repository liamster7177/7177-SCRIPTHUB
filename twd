                            if x then
                                slot = slot + 1
                                local e = getDraw(slot)
                                e.box.Position = Vector2.new(x, y) e.box.Size = Vector2.new(w, h)
                                e.box.Visible = c.box e.box.Color = Color3.fromRGB(180,180,180)
                                e.name.Text = m.Name e.name.Position = Vector2.new(x+w/2, y-16)
                                e.name.Visible = c.name e.name.Color = Color3.fromRGB(200,200,200)
                                e.dist.Text = string.format("%.0f", d)
                                e.dist.Position = Vector2.new(x+w/2, y+h+2) e.dist.Visible = c.dist
                            end
                        end
                    end
                end
            end
        end
    end

    if AR2_CFG.loot.on then
        local c = AR2_CFG.loot
        local list = getLootList()
        local inRange = {}
        for _, item in ipairs(list) do
            if item.prim and item.prim.Parent then
                local d = (item.prim.Position - camPos).Magnitude
                if d <= c.maxDist then inRange[#inRange+1] = { item = item, d = d } end
            end
        end
        table.sort(inRange, function(a, b) return a.d < b.d end)
        local drawCap = c.maxDraw or 40
        local hlCap   = c.maxHighlight or 20
        local seenHl  = {}
        for i = 1, math.min(#inRange, drawCap) do
            local entry = inRange[i]
            local m = entry.item.model
            local prim = entry.item.prim
            local d = entry.d
            local x, y, w, h
            if m:IsA("Model") then x, y, w, h = getModelBox(m)
            else x, y, w, h = getPartBox(prim) end
            if x then
                slot = slot + 1
                local e = getDraw(slot)
                e.box.Position = Vector2.new(x, y) e.box.Size = Vector2.new(w, h)
                e.box.Visible = c.box e.box.Color = Color3.fromRGB(255,200,40)
                local dispName
                if m:IsA("Model") then dispName = m:GetAttribute("DisplayName") or m.Name
                else dispName = m.Name end
                e.name.Text = dispName
                e.name.Position = Vector2.new(x+w/2, y-16)
                e.name.Visible = c.name e.name.Color = Color3.fromRGB(255,200,40)
                e.dist.Text = string.format("%.0f", d)
                e.dist.Position = Vector2.new(x+w/2, y+h+2)
                e.dist.Visible = c.dist
            end
            if c.highlight and i <= hlCap then
                seenHl[m] = true
                setLootHighlight(m, Color3.fromRGB(255,200,40))
            end
        end
        if c.highlight then
            for obj in pairs(AR2_lootHighlights) do
                if not seenHl[obj] then
                    local hl = AR2_lootHighlights[obj]
                    if hl then hl:Destroy() end
                    AR2_lootHighlights[obj] = nil
                end
            end
        else clearLootHighlights() end
    else clearLootHighlights() end
end)

