local function refreshCorpseCache()
    corpseCache.at = os.clock()
    local list, seen = {}, {}
    for _, folderName in ipairs(CORPSE_FOLDERS) do
        local f = workspace:FindFirstChild(folderName)
        if f then
            for _, m in ipairs(f:GetChildren()) do
                if m:IsA("Model") and m:FindFirstChild("Head") and not seen[m] then
                    seen[m] = true
                    list[#list+1] = m
                end
            end
        end
    end
    for _, m in ipairs(workspace:GetChildren()) do
        if m:IsA("Model") and m:FindFirstChild("Head") and not seen[m]
           and not m:FindFirstChildOfClass("Humanoid") then
            seen[m] = true
            list[#list+1] = m
        end
    end
    corpseCache.list = list
end
local function getCorpseList()
    local now = os.clock()
    if now - corpseCache.at >= CORPSE_REFRESH then refreshCorpseCache() end
    return corpseCache.list
end

