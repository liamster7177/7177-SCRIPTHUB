local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    if getnamecallmethod() ~= "FireServer" then return oldNamecall(self, ...) end
    if not AR2_CFG.silent.on then return oldNamecall(self, ...) end
    if not AR2_CV8 or self ~= AR2_CV8 then return oldNamecall(self, ...) end
    
    local packed = table.pack(...)
    local data = packed[1]
    if type(data) ~= "table" or data.Kind ~= "Fire" then
        return oldNamecall(self, table.unpack(packed, 1, packed.n))
    end
    
    local hp = AR2_silentCache.headPos
    local og = data.Origin
    if hp and typeof(og) == "Vector3" then
        local t = hp - og
        if t.Magnitude > 0.001 then
            local od = data.Direction
            local oa = data.ADS
            data.Direction = t.Unit
            data.ADS = true
            local r = oldNamecall(self, table.unpack(packed, 1, packed.n))
            data.Direction = od
            data.ADS = oa
            return r
        end
    end
    return oldNamecall(self, table.unpack(packed, 1, packed.n))
end)

