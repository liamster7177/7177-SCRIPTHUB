local frozenRoots = {}
local function freezeAllWalkers()
    local container = getZombieContainer() if not container then return end
    local origin = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    local originPos = origin and origin.Position or Vector3.zero
    local seen = {}
    for _, m in ipairs(container:GetChildren()) do
        if m:IsA("Model") then
            local root = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart
            if root and root:IsA("BasePart") then
                local ok = true
                if not AR2_CFG.misc.freezeAll and origin then
                    ok = (root.Position - originPos).Magnitude <= AR2_CFG.misc.freezeRadius
                end
                if ok then
                    seen[m] = true
                    if not frozenRoots[m] then
                        frozenRoots[m] = { cf = root.CFrame, parts = {} }
                        for _, part in ipairs(m:GetDescendants()) do
                            if part:IsA("BasePart") then
                                frozenRoots[m].parts[part] = part.Anchored
                                part.Anchored = true
                            end
                        end
                    end
                    root.CFrame = frozenRoots[m].cf
                    root.AssemblyLinearVelocity = Vector3.zero
                    root.AssemblyAngularVelocity = Vector3.zero
                end
            end
        end
    end
    for model, data in pairs(frozenRoots) do
        if not seen[model] or not model.Parent then
            for part, orig in pairs(data.parts) do
                if part and part.Parent then part.Anchored = orig end
            end
            frozenRoots[model] = nil
        end
    end
end
local function unfreezeAll()
    for model, data in pairs(frozenRoots) do
        for part, orig in pairs(data.parts) do
            if part and part.Parent then part.Anchored = orig end
        end
    end
    frozenRoots = {}
end
RunSvc.Heartbeat:Connect(function()
    if not AR2_CFG.misc.freeze then
        if next(frozenRoots) then unfreezeAll() end
        return
    end
    freezeAllWalkers()
end)

local function carBase(model) return model and (model:FindFirstChild("Base") or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")) end
local function carPickMine()
    local container = getVehicleContainer() if not container then return nil end
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    for _, model in ipairs(container:GetChildren()) do
        if model:IsA("Model") then
            for _, part in ipairs(model:GetDescendants()) do
                if part:IsA("BasePart") then
                    for _, weld in ipairs(part:GetChildren()) do
                        if (weld:IsA("Weld") or weld:IsA("WeldConstraint")) and (weld.Part0 == hrp or weld.Part1 == hrp) then return model end
                    end
                end
            end
        end
    end
    return nil
end
local function carPickNear()
    local container = getVehicleContainer() if not container then return nil end
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local best, bestDist = nil, 30
    for _, model in ipairs(container:GetChildren()) do
        if model:IsA("Model") then
            local base = carBase(model)
            if base then
                local d = (base.Position - hrp.Position).Magnitude
                if d < bestDist then best = model bestDist = d end
            end
        end
    end
    return best
end
local function carPick() return carPickMine() or carPickNear() end
local function stopCarVelocity(model)
    if not model or not model.Parent then return end
    for _, p in ipairs(model:GetDescendants()) do
        if p:IsA("BasePart") then pcall(function() p.AssemblyLinearVelocity = Vector3.zero p.AssemblyAngularVelocity = Vector3.zero end) end
    end
end
local cnActive, cnConn, cnModel, cnRoot, cnParts, cnOffsets, cnSaved = false, nil, nil, nil, nil, nil, nil
local cnKeys = { W=false, A=false, S=false, D=false, Space=false, LeftControl=false }
local function carNoclipStop()
    cnActive = false
    AR2_CFG.cars.noclip = false
    if cnConn then cnConn:Disconnect() cnConn = nil end
    if cnParts and cnSaved then
        for _, p in ipairs(cnParts) do pcall(function() if p and p.Parent then p.Anchored = cnSaved[p] or false end end) end
    end
    if AR2_CFG.cars.noclipEjectOnDisable then
        local char = LP.Character
        local hum = char and char:FindFirstChildWhichIsA("Humanoid")
        if hum and hum.Sit then hum.Sit = false pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end) end
    end
    if cnModel then stopCarVelocity(cnModel) end
    cnModel, cnRoot, cnParts, cnOffsets, cnSaved = nil, nil, nil, nil, nil
    for k in pairs(cnKeys) do cnKeys[k] = false end
end
local function carNoclipStart()
    if cnConn then return true end
    local model = carPick() if not model then return false end
    local char = LP.Character
    local hum = char and char:FindFirstChildWhichIsA("Humanoid")
    if not hum or not hum.Sit then return false end
    local root = carBase(model) if not root then return false end
    local parts, offsets, saved = {}, {}, {}
    for _, p in ipairs(model:GetDescendants()) do
        if p:IsA("BasePart") then
            parts[#parts+1] = p
            saved[p] = p.Anchored
            offsets[p] = root.CFrame:Inverse() * p.CFrame
            p.Anchored = true
            p.AssemblyLinearVelocity = Vector3.zero
            p.AssemblyAngularVelocity = Vector3.zero
        end
    end
    if #parts == 0 then return false end
    cnModel, cnRoot, cnParts, cnOffsets, cnSaved = model, root, parts, offsets, saved
    cnActive = true
    AR2_CFG.cars.noclip = true
    cnConn = RunSvc.Heartbeat:Connect(function(dt)
        local r = cnRoot
        if not cnActive or not cnModel or not cnModel.Parent or not r or not r.Parent then carNoclipStop() return end
        local h = LP.Character and LP.Character:FindFirstChildWhichIsA("Humanoid")
        if not h or not h.Sit then carNoclipStop() return end
        local cam = workspace.CurrentCamera
        local move = Vector3.zero
        if cnKeys.W then move += cam.CFrame.LookVector end
        if cnKeys.S then move -= cam.CFrame.LookVector end
        if cnKeys.D then move += cam.CFrame.RightVector end
        if cnKeys.A then move -= cam.CFrame.RightVector end
        if cnKeys.Space then move += Vector3.new(0, 1, 0) end
        if cnKeys.LeftControl then move -= Vector3.new(0, 1, 0) end
        if move.Magnitude > 0 then
            local delta = move.Unit * (AR2_CFG.cars.noclipSpeed or 90) * dt
            local newCF = r.CFrame + delta
            r.CFrame = newCF
            for p, offset in pairs(cnOffsets) do if p and p.Parent then p.CFrame = newCF * offset end end
        end
    end)
    return true
end
local function carNoclipSetEnabled(on)
    if on then return carNoclipStart() else carNoclipStop() return true end
end
