        AR2_ORIGIN = AR2_localPosition()
        local list, seen = {}, {}
        local corpseFolder = AR2_Corpses
            or AR2_Workspace:FindFirstChild("Corpses")
            or (AR2_Workspace:FindFirstChild("Map") and AR2_Workspace.Map:FindFirstChild("Corpses"))
        if corpseFolder then
            for _, child in ipairs(corpseFolder:GetChildren()) do
