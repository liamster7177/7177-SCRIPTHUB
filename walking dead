
local wallbangTagConn    = nil
local CharactersFolder   = AR2_Workspace:WaitForChild("Characters", 5)
local ZombiesFolder      = AR2_Workspace:WaitForChild("Zombies", 5)
local AR2_wallbangSaved  = {}
local AR2_WALLBANG_GROUPS = { [7]=true, [8]=true, [9]=true, [11]=true, [17]=true }
local AR2_wallbangFilterHooked  = false
local AR2_wallbangRealFilter    = nil

-- Bypass is a permanent state while wallbang is enabled.
AR2_wallbangRaycastBypass = false

-- Time-gate: __namecall hook only intercepts raycasts within this window
-- after a shot. This keeps UI / lock-on / hover raycasts untouched.
AR2_hookWindowUntil = 0
function AR2_extendHookWindow()
    AR2_hookWindowUntil = os.clock() + 1.5
end

local function isCharacterPart(part)
    if not part then return false end
    local parent = part.Parent
    while parent do
        if parent:FindFirstChildOfClass("Humanoid") then return true end
        if parent:IsA("Model")
        and (parent.Parent == CharactersFolder or parent.Parent == ZombiesFolder) then
            return true
        end
        parent = parent.Parent
    end
    return false
end

local function isCorpsePart(part)
    if not part then return false end
    if AR2_Corpses and part:IsDescendantOf(AR2_Corpses) then return true end
    return false
end

local function tagPart(part)
    if not part:IsA("BasePart") then return end
    if isCharacterPart(part) then return end
    if isCorpsePart(part) then return end   -- corpses break game loot UI
    if AR2_CollectionService:HasTag(part, "Bullets Penetrate") then return end
    AR2_CollectionService:AddTag(part, "Bullets Penetrate")
end

local function removeCharacterTags(model)
    for _, part in ipairs(model:GetDescendants()) do
        if part:IsA("BasePart") and AR2_CollectionService:HasTag(part, "Bullets Penetrate") then
            AR2_CollectionService:RemoveTag(part, "Bullets Penetrate")
        end
    end
end

local function AR2_wallbangForcePart(part)
    if not part:IsA("BasePart") then return end
    if isCharacterPart(part) then return end
    if isCorpsePart(part) then return end
    local gid = part.CollisionGroupId
    if AR2_WALLBANG_GROUPS[gid] then
        AR2_wallbangSaved[part] = gid
        pcall(function() part.CollisionGroupId = 0 end)
    end
    tagPart(part)
end

local function AR2_findRaycasting()
    local rs     = AR2_ReplicatedStorage
    local client = rs:FindFirstChild("Client")
    local libs   = client and client:FindFirstChild("Libraries")
    local rc     = libs and libs:FindFirstChild("Raycasting")
    if rc then
        local ok, mod = pcall(require, rc)
        if ok and type(mod) == "table" and type(mod.bulletCastLightFilter) == "function" then
            return mod
        end
    end
    local ok2, fw = pcall(function()
        return require(AR2_ReplicatedFirst:WaitForChild("Framework", 30))
    end)
    if ok2 and fw and fw.Libraries and fw.Libraries.Raycasting
    and type(fw.Libraries.Raycasting.bulletCastLightFilter) == "function" then
        return fw.Libraries.Raycasting
    end
    return nil
end

local function AR2_installWallbangFilterHook()
    if AR2_wallbangFilterHooked then return end
    if type(hookfunction) ~= "function" then
        warn("[wallbang] hookfunction unavailable — filter layer skipped")
        return
    end
    local Raycasting = AR2_findRaycasting()
    if not Raycasting then
        warn("[wallbang] Raycasting.bulletCastLightFilter not found")
        return
    end
    AR2_wallbangRealFilter = hookfunction(Raycasting.bulletCastLightFilter,
        function(instance, ...)
            if AR2_CFG.weapon.wallbang then
                if isCharacterPart(instance) then return false end
                return true
            end
            return AR2_wallbangRealFilter(instance, ...)
        end)
    AR2_wallbangFilterHooked = true
    print("[wallbang] filter hook installed")
end

function startWallbangTagging()
    AR2_installWallbangFilterHook()
    if wallbangTagConn then return end
    for _, part in ipairs(AR2_Workspace:GetDescendants()) do AR2_wallbangForcePart(part) end
    local mapFolder = AR2_Workspace:FindFirstChild("Map")
    if mapFolder then
        for _, desc in ipairs(mapFolder:GetDescendants()) do AR2_wallbangForcePart(desc) end
    end
    wallbangTagConn = AR2_Workspace.DescendantAdded:Connect(function(desc)
        if not AR2_CFG.weapon.wallbang then return end
        if desc:IsA("BasePart") then
            AR2_wallbangForcePart(desc)
        elseif desc:IsA("Humanoid") then
            local model = desc.Parent
            if model and model:IsA("Model") then removeCharacterTags(model) end
        end
    end)
end

function stopWallbangTagging()
    if wallbangTagConn then wallbangTagConn:Disconnect() wallbangTagConn = nil end
    for part, gid in pairs(AR2_wallbangSaved) do
        pcall(function()
            if part and part.Parent then part.CollisionGroupId = gid end
        end)
    end
    AR2_wallbangSaved = {}
end

function AR2_setWallbang(enabled)
    AR2_CFG.weapon.wallbang = enabled
    AR2_wallbangRaycastBypass = enabled
    if enabled then
        startWallbangTagging()
    else
        stopWallbangTagging()
    end
end

-- =============================================
-- UNIFIED NAMECALL HOOK (HBE + WALLBANG)
-- =============================================
-- Single hook, avoids conflict between two __namecall installers.
-- Time-gated: only modifies raycasts within ~1.5s of a shot.
-- Builds FRESH RaycastParams — never mutates the game's shared params.
AR2_sharedHookInstalled = false

function AR2_installSharedNamecallHook()
    if AR2_sharedHookInstalled then return true end

    local installOk = pcall(function()
        if type(hookmetamethod) ~= "function" or type(getnamecallmethod) ~= "function" then
            error("no hookmetamethod available")
        end

        local oldNC
        oldNC = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
            local method = getnamecallmethod()

            if method == "Raycast" and self == workspace then
                -- GATE: only intercept inside the post-shot window.
                -- Outside it, pass through completely untouched.
                if os.clock() >= AR2_hookWindowUntil then
                    return oldNC(self, ...)
                end

                local origin, direction, params = ...
                if typeof(origin) == "Vector3" and typeof(params) == "RaycastParams" then
                    local filter = params.FilterDescendantsInstances
                    local callParams = params

                    -- LAYER 1: Wallbang bypass (fresh params; original untouched)
                    if AR2_wallbangRaycastBypass then
                        local newParams = RaycastParams.new()
                        newParams.FilterType = Enum.RaycastFilterType.Include
                        newParams.IgnoreWater = params.IgnoreWater
                        newParams.CollisionGroup = params.CollisionGroup
                        pcall(function() newParams.RespectCanCollide = params.RespectCanCollide end)

                        local newFilter = {}
                        if AR2_LocalPlayer.Character then table.insert(newFilter, AR2_LocalPlayer.Character) end
                        if CharactersFolder then table.insert(newFilter, CharactersFolder) end
                        if ZombiesFolder   then table.insert(newFilter, ZombiesFolder)   end
                        if filter then
                            for _, inst in ipairs(filter) do
                                if typeof(inst) == "Instance"
                                and inst:IsA("Model")
                                and inst:FindFirstChildOfClass("Humanoid")
                                and inst ~= AR2_LocalPlayer.Character then
                                    table.insert(newFilter, inst)
                                end
                            end
                        end
                        newParams.FilterDescendantsInstances = newFilter
                        callParams = newParams

                    -- LAYER 2: HBE bypass (only when wallbang is off)
                    elseif AR2_CFG.weapon.hbeOn and filter then
                        local hasChars = false
                        for _, inst in ipairs(filter) do
                            if inst == AR2_Characters then hasChars = true break end
                        end
                        if hasChars then
                            local newParams = RaycastParams.new()
                            newParams.FilterType = params.FilterType
                            newParams.IgnoreWater = params.IgnoreWater
                            newParams.CollisionGroup = params.CollisionGroup
                            pcall(function() newParams.RespectCanCollide = params.RespectCanCollide end)

                            local cleaned = {}
                            for _, inst in ipairs(filter) do
                                if inst ~= AR2_Characters then table.insert(cleaned, inst) end
                            end
                            local selfChar = AR2_LocalPlayer.Character
                            if selfChar then table.insert(cleaned, selfChar) end
                            newParams.FilterDescendantsInstances = cleaned
                            callParams = newParams
                        end
                    end

                    local result
                    if callParams ~= params then
                        result = oldNC(self, origin, direction, callParams)
                    else
                        result = oldNC(self, ...)
                    end

                    -- HBE result interception: proxy part hit -> real Head
                    if AR2_CFG.weapon.hbeOn and result and result.Instance then
                        local hit = result.Instance
                        if hit:GetAttribute("ar2_hbe") then
                            for char, hbePart in pairs(AR2_hbeVisuals) do
                                if hbePart == hit then
                                    local realHead = char:FindFirstChild("Head")
                                    if realHead then
                                        return {
                                            Instance = realHead,
                                            Position = result.Position,
                                            Normal   = result.Normal,
                                            Material = result.Material,
                                            Distance = result.Distance,
                                        }
                                    end
                                    break
                                end
                            end
                        end
                    end
                    return result
                end

                return oldNC(self, ...)
            end

            if method == "FireServer" and AR2_containerPersistEnabled then
                local args = {...}
                local eventName = tostring(self.Name)
                local a1 = tostring(args[1] or "")
                if a1:lower():find("close")
                and (eventName:lower():find("container")
                     or eventName:lower():find("storage")
                     or a1:lower():find("container")) then
                    return
                end
            end

            return oldNC(self, ...)
        end))

        if getgenv then getgenv().AR2_sharedHookMethod = "hookmetamethod" end
        AR2_sharedHookInstalled = true
        print("[shared] unified __namecall hook installed (HBE + Wallbang)")
    end)

    if not installOk then
        warn("[shared] failed to install unified hook")
        AR2_sharedHookInstalled = false
        return false
    end
    return true
end

-- =============================================
-- BULLET HOOK
-- =============================================
AR2_success, AR2_Bullets = pcall(function()
    return require(AR2_ReplicatedFirst:WaitForChild("Framework", 30)).Libraries.Bullets
end)
AR2_originalFireFunction = nil
AR2_recoilOriginalFn     = nil
AR2_spreadOriginalFn     = nil

if AR2_success and AR2_Bullets and AR2_Bullets.Fire then
    AR2_originalFireFunction = AR2_Bullets.Fire
    pcall(function() AR2_recoilOriginalFn = debug.getupvalue(AR2_originalFireFunction, 6) end)
    pcall(function() AR2_spreadOriginalFn = debug.getupvalue(AR2_originalFireFunction, 3) end)

    local function AR2_identitySpread(rng, direction)
        return direction.Unit
    end

    AR2_Bullets.Fire = function(self, playerController, weaponInstance, weaponData, origin, direction, shotId)
        AR2_lastFireParams = {
            self = self, pc = playerController,
            wi = weaponInstance, wd = weaponData,
        }
        AR2_hasRealWD      = true
        AR2_autoSeeded     = true
        AR2_autoSeeding    = false
        AR2_tryCacheAmmoRef(weaponInstance)   -- global, declared in RageBot section
        AR2_noteShot()
        AR2_extendHookWindow()                -- enable raycast interception ~1.5s

        if AR2_hitLogger and AR2_hitLogger.enabled then
            local shotTime = os.clock()
            task.delay(0.15, function()
                local confirmed = false
                local damage    = 0
                local target    = nil
                for _, drop in ipairs(AR2_hpDrops) do
                    if drop.at >= shotTime - 0.02
                    and drop.at <= shotTime + AR2_hpDropWindow then
                        confirmed = true
                        damage    = damage + drop.delta
                        target    = target or drop.player
                    end
                end
                if confirmed then
                    local name = (target and target.Name) or "target"
                    AR2_hitLogger.push(string.format("✓ HIT  %s  -%.0f HP", name, damage), true)
                else
                    AR2_hitLogger.push("✗ miss  (no HP drop detected)", false)
                end
            end)
        end

        local ok, result = pcall(function()
            local originalOrigin    = origin
            local originalDirection = direction

            local AR2_ibSavedSpd, AR2_ibSavedGrav, AR2_ibSavedDrop = nil, nil, nil
            local AR2_ibSavedFields = nil

            if AR2_ibEnabled and weaponData and not AR2_CFG.misc.fly then
                AR2_ibEvaluate()
                pcall(function()
                    local spd = AR2_resolveBulletSpeed(weaponData, weaponInstance)
                    if not spd or spd <= 0 then return end

                    AR2_ibLastSpd    = spd
                    AR2_ibShotsFired = AR2_ibShotsFired + 1

                    local bestDist = 400
                    local Characters = AR2_Workspace:FindFirstChild("Characters")
                    if Characters then
                        local dir = direction.Unit
                        local minLat = 5
                        for _, model in ipairs(Characters:GetChildren()) do
                            if model:IsA("Model") then
                                local p = AR2_Players:GetPlayerFromCharacter(model)
                                if p and p ~= AR2_LocalPlayer then
                                    local hrp = model:FindFirstChild("HumanoidRootPart")
                                    if hrp then
                                        local toT  = hrp.Position - origin
                                        local proj = toT:Dot(dir)
                                        if proj > 0 then
                                            local lat = (toT - dir * proj).Magnitude
                                            if lat < minLat then
                                                minLat            = lat
                                                bestDist          = proj
                                                AR2_ibLastHitTime = os.clock()
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end

                    AR2_ibSeedMult(spd, bestDist)

                    local boosted = spd * AR2_ibMult
                    AR2_ibSavedFields = {
                        weaponData = weaponData,
                        originals  = {},
                        gravity    = weaponData.Gravity,
                        bulletDrop = weaponData.BulletDrop,
                    }
                    local O = AR2_ibSavedFields.originals

                    if type(weaponData.BulletSpeed) == "number" then
                        O.BulletSpeed = weaponData.BulletSpeed
                        weaponData.BulletSpeed = boosted
                    end
                    if type(weaponData.MuzzleVelocity) == "number" then
                        O.MuzzleVelocity = weaponData.MuzzleVelocity
                        weaponData.MuzzleVelocity = boosted
                    end
                    if weaponData.FireConfig then
                        if type(weaponData.FireConfig.BulletSpeed) == "number" then
                            O.FC_BulletSpeed = weaponData.FireConfig.BulletSpeed
                            weaponData.FireConfig.BulletSpeed = boosted
                        end
                        if type(weaponData.FireConfig.MuzzleVelocity) == "number" then
                            O.FC_MuzzleVelocity = weaponData.FireConfig.MuzzleVelocity
                            weaponData.FireConfig.MuzzleVelocity = boosted
                        end
                    end

                    AR2_ibSavedSpd  = spd
                    AR2_ibSavedGrav = weaponData.Gravity
                    AR2_ibSavedDrop = weaponData.BulletDrop

                    if weaponData.Gravity    ~= nil then weaponData.Gravity    = 0 end
                    if weaponData.BulletDrop ~= nil then weaponData.BulletDrop = 0 end
                end)
            end

            local aimEntity, aimPart = nil, nil
            if AR2_CFG.magicAim.on or AR2_CFG.rageBot.on then
                aimEntity, aimPart = AR2_magicTarget()
                AR2_magicAim.target = aimEntity
            end

            if (AR2_CFG.magicAim.on or AR2_CFG.rageBot.on) and aimEntity and aimPart then
                if AR2_CFG.magicAim.originShift and aimEntity.model then
                    local headPart = aimEntity.headCollider or aimEntity.head
                    if headPart then
                        local nudge = originalOrigin + originalDirection * AR2_CFG.magicBullet.forwardNudge
                        local newOrigin, clear = AR2_findBestOrigin(nudge, originalDirection, headPart.Position, aimEntity.model)
                        if clear or newOrigin ~= originalOrigin then
                            origin = newOrigin
                            direction = (headPart.Position - origin).Unit
                        end
                    end
                end
                local aimPoint = AR2_predict(aimPart, origin, aimEntity.velocity)
                local bend = aimPoint - origin
                if bend.Magnitude > 0.001 then
                    local angle = math.deg(math.acos(math.clamp(bend.Unit:Dot(direction.Unit), -1, 1)))
                    local chance = AR2_CFG.magicAim.redirectChance or 100
                    if angle <= AR2_CFG.magicAim.maxBend and math.random(1,100) <= chance then
                        direction = bend.Unit
                    end
                end
            end

            local applyNoSpread = AR2_CFG.weapon.noSpread
            if AR2_CFG.magicAim.killSpread and aimEntity ~= nil then
                applyNoSpread = true
            end

            if applyNoSpread then
                pcall(function() debug.setupvalue(AR2_originalFireFunction, 3, AR2_identitySpread) end)
            else
                if AR2_spreadOriginalFn then
                    pcall(debug.setupvalue, AR2_originalFireFunction, 3, AR2_spreadOriginalFn)
                end
            end

            if AR2_CFG.weapon.noRecoil then
                pcall(function()
                    debug.setupvalue(AR2_originalFireFunction, 6,
                        function(...) return Vector2.new(0,0), 0, 0, 0, 0 end)
                end)
            elseif AR2_CFG.weapon.recoilReduction and AR2_CFG.weapon.recoilReduction > 0 then
                local reduction = AR2_CFG.weapon.recoilReduction / 100
                if AR2_recoilOriginalFn then
                    local function newRecoil(...)
                        local x, y, z, a, b = AR2_recoilOriginalFn(...)
                        return Vector2.new(x.X*(1-reduction), x.Y*(1-reduction)),
                               z*(1-reduction), a*(1-reduction), b*(1-reduction), 0
                    end
                    pcall(debug.setupvalue, AR2_originalFireFunction, 6, newRecoil)
                end
            else
                if AR2_recoilOriginalFn then
                    pcall(debug.setupvalue, AR2_originalFireFunction, 6, AR2_recoilOriginalFn)
                end
            end

            -- WALLBANG: penetration fields + zero drop/spread.
            -- The actual filter rewrite is in the __namecall hook, gated by
            -- AR2_hookWindowUntil which we just refreshed above.
            if AR2_CFG.weapon.wallbang and not AR2_CFG.misc.fly then
                local penFields = {
                    "Penetration","PenetrationPower","WallPenetration",
                    "WallPenetrationPower","PierceCount","Piercing",
                    "BulletPenetration","ArmorPenetration","PenPower",
                }
                for _, f in ipairs(penFields) do
                    pcall(function() weaponData[f] = 9999 end)
                end
                pcall(function() weaponData.CanPenetrate    = true end)
                pcall(function() weaponData.PenetrateWalls  = true end)
                pcall(function() weaponData.IgnoreArmor     = true end)
                pcall(function()
                    if weaponData.FireConfig then
                        weaponData.FireConfig.Penetration = 9999
                        weaponData.FireConfig.PenetrationPower = 9999
                    end
                end)

                if weaponData.Gravity    ~= nil then weaponData.Gravity    = 0 end
                if weaponData.BulletDrop ~= nil then weaponData.BulletDrop = 0 end
                pcall(function() debug.setupvalue(AR2_originalFireFunction, 3, AR2_identitySpread) end)
            end

            local _savedGrav = workspace.Gravity
            if AR2_CFG.weapon.noBulletDrop or AR2_CFG.weapon.wallbang then workspace.Gravity = 0 end
            local result = AR2_originalFireFunction(self, playerController, weaponInstance, weaponData, origin, direction, shotId)
            workspace.Gravity = _savedGrav

            if AR2_ibSavedFields then
                pcall(function()
                    local wd = AR2_ibSavedFields.weaponData
                    local O  = AR2_ibSavedFields.originals
                    if wd then
                        if O.BulletSpeed    ~= nil then wd.BulletSpeed    = O.BulletSpeed    end
                        if O.MuzzleVelocity ~= nil then wd.MuzzleVelocity = O.MuzzleVelocity end
                        if wd.FireConfig then
                            if O.FC_BulletSpeed    ~= nil then wd.FireConfig.BulletSpeed    = O.FC_BulletSpeed    end
                            if O.FC_MuzzleVelocity ~= nil then wd.FireConfig.MuzzleVelocity = O.FC_MuzzleVelocity end
                        end
                        if AR2_ibSavedFields.gravity    ~= nil then wd.Gravity    = AR2_ibSavedFields.gravity    end
                        if AR2_ibSavedFields.bulletDrop ~= nil then wd.BulletDrop = AR2_ibSavedFields.bulletDrop end
                    end
                end)
                AR2_ibSavedFields = nil
            end

            if AR2_CFG.hitmarker.enabled then
                local _rp=RaycastParams.new()
                _rp.FilterType=Enum.RaycastFilterType.Exclude
                _rp.FilterDescendantsInstances={AR2_LocalPlayer.Character}
                local _hit=AR2_Workspace:Raycast(origin,direction*2000,_rp)
                local _det=false
                if _hit and _hit.Instance then
                    local _m=_hit.Instance
                    while _m and not _m:IsA("Model") do _m=_m.Parent end
                    if _m then
                        _det=(AR2_Characters~=nil and _m.Parent==AR2_Characters)
                            or(ZombiesFolder~=nil and _m.Parent==ZombiesFolder)
                            or _m:FindFirstChildOfClass("Humanoid")~=nil
                    end
                end
                if _det then AR2_hitmarkerFlag=true end
            end

            if AR2_tracersEnabled then AR2_addTracer(origin, direction) end

            return result
        end)
        if not ok then
            warn("[fire] hook error: " .. tostring(result))
            return AR2_originalFireFunction(self, playerController, weaponInstance, weaponData, origin, direction, shotId)
        end
        return result
    end
end

-- =============================================
-- HBE — Hitbox Expander
-- =============================================
AR2_hbeVisuals       = {}
AR2_hbeChildConn     = nil
AR2_hbeScanThread    = false

local function AR2_hbeIsLocalPlayer(character)
    if not character then return false end
    if character == AR2_LocalPlayer.Character then return true end
    if AR2_Players:GetPlayerFromCharacter(character) == AR2_LocalPlayer then return true end
    if character.Name == AR2_LocalPlayer.Name then return true end
    return false
end

local function AR2_hbeAddVisual(character)
    if AR2_hbeVisuals[character] then return end
    if AR2_hbeIsLocalPlayer(character) then return end
    if not character:FindFirstChildOfClass("Humanoid") then return end
    local realHead = character:FindFirstChild("Head")
    if not realHead then return end
    local charRoot = character:FindFirstChild("HumanoidRootPart") or realHead
    if (charRoot.Position - AR2_localPosition()).Magnitude > 2000 then return end

    local v = Instance.new("Part")
    v.Name         = "ar2_hbe_head"
    v.Size         = Vector3.new(AR2_CFG.weapon.hbeSize, AR2_CFG.weapon.hbeSize, AR2_CFG.weapon.hbeSize)
    v.Transparency = 1
    v.CanCollide   = false
    v.CanTouch     = false
    v.CanQuery     = true
    v.Massless     = true
    v.Anchored     = true
    v.CastShadow   = false
    v:SetAttribute("ar2_hbe", true)
    v.CFrame       = realHead.CFrame
    v.Parent       = character

    local followConn
    followConn = AR2_RunService.Heartbeat:Connect(function()
        if not v or not v.Parent then
            if followConn then followConn:Disconnect() end
            AR2_hbeVisuals[character] = nil
            return
        end
        if not realHead or not realHead.Parent then
            v:Destroy()
            if followConn then followConn:Disconnect() end
            AR2_hbeVisuals[character] = nil
            return
        end
        v.CFrame = realHead.CFrame
    end)

    AR2_hbeVisuals[character] = v
    character.AncestryChanged:Connect(function()
        if not character.Parent then
            if v and v.Parent then v:Destroy() end
            if followConn then followConn:Disconnect() end
            AR2_hbeVisuals[character] = nil
        end
    end)
end

function AR2_hbeScan()
    if not AR2_Characters then return end
    local localRoot = AR2_localPosition()
    for _, model in ipairs(AR2_Characters:GetChildren()) do
        if model:IsA("Model") and not AR2_hbeIsLocalPlayer(model) then
            local root = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Head")
            if root then
                if (root.Position - localRoot).Magnitude <= 2000 then
                    AR2_hbeAddVisual(model)
                else
                    local v = AR2_hbeVisuals[model]
                    if v then v:Destroy() AR2_hbeVisuals[model] = nil end
                end
            end
        end
    end
end

function AR2_hbeRemoveAll()
    for char, v in pairs(AR2_hbeVisuals) do
        if v and v.Parent then v:Destroy() end
        AR2_hbeVisuals[char] = nil
    end
    AR2_hbeVisuals = {}
end

function AR2_hbeUpdateSizes()
    for _, v in pairs(AR2_hbeVisuals) do
        if v and v.Parent then
            v.Size = Vector3.new(AR2_CFG.weapon.hbeSize, AR2_CFG.weapon.hbeSize, AR2_CFG.weapon.hbeSize)
        end
    end
end

function AR2_hbeSetEnabled(enabled)
    AR2_CFG.weapon.hbeOn = enabled
    if enabled then
        AR2_installSharedNamecallHook()
        AR2_hbeScan()
        if AR2_Characters and not AR2_hbeChildConn then
            AR2_hbeChildConn = AR2_Characters.ChildAdded:Connect(function(model)
                if not model:IsA("Model") then return end
                if not AR2_CFG.weapon.hbeOn then return end
                if model.Name == AR2_LocalPlayer.Name then return end
                task.wait(0.3)
                if AR2_hbeIsLocalPlayer(model) then return end
                AR2_hbeAddVisual(model)
            end)
        end
        if not AR2_hbeScanThread then
            AR2_hbeScanThread = true
            task.spawn(function()
                while true do
                    task.wait(2)
                    if AR2_CFG.weapon.hbeOn then pcall(AR2_hbeScan) end
                end
            end)
        end
    else
        AR2_hbeRemoveAll()
    end
end
