## 1. Core Car Helpers

```lua
-- Returns the Base part (or PrimaryPart / first BasePart) of a vehicle model
function AR2_carBase(model)
    return model and (model:FindFirstChild("Base")
        or model.PrimaryPart
        or model:FindFirstChildWhichIsA("BasePart"))
end

-- Returns the vehicle you're currently seated in, or nearest vehicle within range
function AR2_carPick()
    local char = AR2_LocalPlayer.Character
    local humanoid = char and char:FindFirstChildWhichIsA("Humanoid")
    local seat = humanoid and humanoid.SeatPart
    local container = AR2_Workspace:FindFirstChild("Vehicles")
    if not container then return nil end

    if seat then
        local node = seat
        while node and node.Parent do
            if node.Parent == container then return node end
            node = node.Parent
        end
    end

    local best, bestDist = nil, math.huge
    local origin = AR2_localPosition()
    for _, model in ipairs(container:GetChildren()) do
        if model:IsA("Model") then
            local base = AR2_carBase(model)
            if base then
                local d = (base.Position - origin).Magnitude
                if d < bestDist then best, bestDist = model, d end
            end
        end
    end
    return best
end

-- Reads the module script inside the vehicle model that holds physics config
function AR2_carConfig(model)
    local module = model:FindFirstChild("Config")
    if not (module and module:IsA("ModuleScript")) then return nil end
    local ok, tbl = pcall(require, module)
    return (ok and type(tbl) == "table") and tbl or nil
end

-- Vehicle "owned by me" check (ReceiveAge == 0 means we own it)
function AR2_car.owned(model)
    local base = AR2_carBase(model)
    return base ~= nil and base.ReceiveAge == 0
end

-- Detects the vehicle the player is physically welded to (custom seats)
function AR2_occupiedCar()
    local char = AR2_LocalPlayer.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp or not AR2_Vehicles then return nil end

    -- Weld detection (works with custom seats)
    for _, model in ipairs(AR2_Vehicles:GetChildren()) do
        if model:IsA("Model") then
            for _, part in ipairs(model:GetDescendants()) do
                if part:IsA("BasePart") then
                    for _, weld in ipairs(part:GetChildren()) do
                        if (weld:IsA("Weld") or weld:IsA("WeldConstraint"))
                        and (weld.Part0 == hrp or weld.Part1 == hrp) then
                            return model
                        end
                    end
                end
            end
        end
    end

    -- Fallback: nearest vehicle within 12 studs
    local best, bestDist = nil, 12
    for _, model in ipairs(AR2_Vehicles:GetChildren()) do
        if model:IsA("Model") then
            local base = AR2_carBase(model)
            if base then
                local d = (base.Position - hrp.Position).Magnitude
                if d < bestDist then best = model bestDist = d end
            end
        end
    end
    return best
end

-- Eject simulation helpers
function AR2_simulateVehicleExit()
    local VIM = game:GetService("VirtualInputManager")
    if not VIM then return end
    pcall(function() VIM:SendKeyEvent(true,  Enum.KeyCode.Space, false, game) end)
    task.wait(0.05)
    pcall(function() VIM:SendKeyEvent(false, Enum.KeyCode.Space, false, game) end)
end

function AR2_ejectFromVehicle()
    local char = AR2_LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildWhichIsA("Humanoid")
    if not hum then return end
    if hum.Sit then
        AR2_simulateVehicleExit()
        task.wait(0.15)
    end
    if hum.Sit then
        hum.Sit = false
        pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
    end
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("Weld") and (p.Name == "SeatWeld" or p.Name == "SeatWeld1") then
            p:Destroy()
        end
    end
end

function AR2_stopVehicleVelocity(model)
    if not model or not model.Parent then return end
    for _, p in ipairs(model:GetDescendants()) do
        if p:IsA("BasePart") then
            pcall(function()
                p.AssemblyLinearVelocity = Vector3.zero
                p.AssemblyAngularVelocity = Vector3.zero
            end)
        end
    end
end

function AR2_carHealth(model)
    if not model then return nil end
    local hp = model:GetAttribute("Health") or model:GetAttribute("health")
    if hp then return tonumber(hp) end
    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("ValueBase") and (d.Name == "Health" or d.Name == "health") then
            local h = tonumber(d.Value)
            if h then return h end
        end
    end
    return nil
end
