AR2_carDashConn = nil
AR2_carDashLast = 0

function AR2_startCarDash()
    if AR2_carDashConn then return end
    AR2_CFG.car.tpDash = true
    AR2_carDashLast = os.clock()
    AR2_carDashConn = AR2_RunService.Heartbeat:Connect(function()
        if not AR2_CFG.car.tpDash then AR2_stopCarDash() return end
        local now = os.clock()
        if now - AR2_carDashLast < AR2_CFG.car.tpDashInterval then return end
        AR2_carDashLast = now
        local model = AR2_carPick()
        if not model then return end
        local fwd  = workspace.CurrentCamera.CFrame.LookVector
        local flat = Vector3.new(fwd.X, 0, fwd.Z)
        if flat.Magnitude < 0.01 then return end
        flat = flat.Unit
        local verticalOffset = AR2_CFG.car.tpDashVert or 0
        local movement = flat * AR2_CFG.car.tpDashStuds + Vector3.new(0, verticalOffset, 0)
        local curPivot = model:GetPivot()
        local newPivot = CFrame.new(curPivot.Position + movement) * (curPivot - curPivot.Position)
        local savedAnchor = {}
        for _, p in ipairs(model:GetDescendants()) do
            if p:IsA("BasePart") then
                savedAnchor[p] = p.Anchored
                p.Anchored = true
                p.AssemblyLinearVelocity  = Vector3.zero
                p.AssemblyAngularVelocity = Vector3.zero
            end
        end
        model:PivotTo(newPivot)
        for p, wasAnchored in pairs(savedAnchor) do
            if p and p.Parent then
                p.Anchored = wasAnchored
                p.AssemblyLinearVelocity  = Vector3.zero
                p.AssemblyAngularVelocity = Vector3.zero
            end
        end
    end)
end

function AR2_stopCarDash()
    AR2_CFG.car.tpDash = false
    if AR2_carDashConn then AR2_carDashConn:Disconnect() AR2_carDashConn = nil end
end

-- =============================================
-- CAR SYSTEM (core helpers)
-- =============================================
AR2_car = { busy = false, cancel = false, gen = 0, lastResult = "", target = nil }

function AR2_carBase(model)
    return model and (model:FindFirstChild("Base") or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart"))
end

function AR2_carPick()
    local char = AR2_LocalPlayer.Character
    local humanoid = char and char:FindFirstChildWhichIsA("Humanoid")
    local seat = humanoid and humanoid.SeatPart
    local container = AR2_Workspace:FindFirstChild("Vehicles")
    if not container then return nil end
    if seat then
        local node = seat
        while node and node.Parent do
            if node.Parent == container then return node end
            node = node.Parent
        end
    end
    local best, bestDist = nil, math.huge
    local origin = AR2_localPosition()
    for _, model in ipairs(container:GetChildren()) do
        if model:IsA("Model") then
            local base = AR2_carBase(model)
            if base then
                local d = (base.Position - origin).Magnitude
                if d < bestDist then best, bestDist = model, d end
            end
        end
    end
    return best
end

function AR2_car.owned(model)
    local base = AR2_carBase(model)
    return base ~= nil and base.ReceiveAge == 0
end

function AR2_car.stop()
    AR2_car.cancel = true
    AR2_car.gen = AR2_car.gen + 1
end

function AR2_car.desyncTo(goal, label)
    AR2_car.gen = AR2_car.gen + 1
    local mine = AR2_car.gen
    AR2_car.cancel = true
    task.spawn(function()
        while AR2_car.busy do task.wait() end
        if AR2_car.gen ~= mine then return end
        AR2_car.busy, AR2_car.cancel = true, false
        local model = AR2_carPick()
        local base = AR2_carBase(model)
        if not base then
            AR2_car.lastResult = "no vehicle found"
            AR2_car.busy = false
            return
        end
        AR2_car.target = model
        local goalCF = CFrame.new(goal) * (model:GetPivot() - model:GetPivot().Position)
        local wasAnchored = base.Anchored
        base.Anchored = true
        for _ = 1, 20 do
            if AR2_car.cancel or AR2_car.gen ~= mine then break end
            model:PivotTo(goalCF)
            base.AssemblyLinearVelocity = Vector3.zero
            AR2_RunService.Heartbeat:Wait()
        end
        base.Anchored = wasAnchored
        base.AssemblyLinearVelocity = Vector3.zero
        task.wait(1)
        local off = (model:GetPivot().Position - goal).Magnitude
        AR2_car.lastResult = string.format("%s -- %s (%.0f off)", label,
            off <= 30 and "moved" or "server pulled it back", off)
        AR2_car.busy = false
    end)
end

function AR2_car.rewriteTo(goal, label)
    AR2_car.gen = AR2_car.gen + 1
    local mine = AR2_car.gen
    AR2_car.cancel = true
    task.spawn(function()
        while AR2_car.busy do task.wait() end
        if AR2_car.gen ~= mine then return end
        AR2_car.busy, AR2_car.cancel = true, false
        local model = AR2_carPick()
        local base = AR2_carBase(model)
        if not base then
            AR2_car.lastResult = "no vehicle found"
            AR2_car.busy = false
            return
        end
        AR2_car.target = model
        local goalCF = CFrame.new(goal) * (model:GetPivot() - model:GetPivot().Position)
        local stable, last = 0, nil
        local until_ = os.clock() + AR2_CFG.tp.maxSeconds
        while not AR2_car.cancel and AR2_car.gen == mine and os.clock() < until_ do
            local now = model:GetPivot().Position
            if last then
                if (now - last).Magnitude >= AR2_CFG.tp.snapBack then stable = 0
                else stable = stable + 1/60 end
            end
            model:PivotTo(goalCF)
            base.AssemblyLinearVelocity = Vector3.zero
            last = goalCF.Position
            if stable >= AR2_CFG.tp.stableCs/100 then break end
            AR2_RunService.Heartbeat:Wait()
        end
        local off = (model:GetPivot().Position - goal).Magnitude
        AR2_car.lastResult = string.format("%s -- %s (%.0f off)", label,
            off <= 30 and "held" or "did not hold", off)
        AR2_car.busy = false
    end)
end

function AR2_car.toMe(mode)
    local root = AR2_tpRoot()
    if not root then AR2_car.lastResult = "no character" return end
    local goal = root.Position + root.CFrame.LookVector * 12 + Vector3.new(0, 5, 0)
    if mode == "desync" then AR2_car.desyncTo(goal, "to me")
    else AR2_car.rewriteTo(goal, "to me") end
end

function AR2_car.toCursor(mode)
    local cam = Workspace.CurrentCamera
    local screen = AR2_UserInputService:GetMouseLocation()
    local ray = cam:ViewportPointToRay(screen.X, screen.Y)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { AR2_LocalPlayer.Character, AR2_car.target }
    local hit = AR2_Workspace:Raycast(ray.Origin, ray.Direction * 10000, params)
    if not hit then AR2_car.lastResult = "cursor -- nothing there" return end
    local goal = hit.Position + Vector3.new(0, 6, 0)
    if mode == "desync" then AR2_car.desyncTo(goal, "to cursor")
    else AR2_car.rewriteTo(goal, "to cursor") end
end

