function AR2_setAutoReload(enabled)
    AR2_autoReloadEnabled = enabled
    AR2_CFG.weapon.autoReload = enabled
    if AR2_autoReloadConn then AR2_autoReloadConn:Disconnect() AR2_autoReloadConn = nil end
