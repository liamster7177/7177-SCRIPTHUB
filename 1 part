AR2_originalFireModesCache = {}
AR2_allFireModesConn       = nil
AR2_allFireModes_table     = { "Automatic", "Semiautomatic", "Burst" }

function AR2_getEquippedInner()
    local ok, pc = pcall(function()
        return require(AR2_ReplicatedFirst:WaitForChild("Framework", 30)).Classes.Players.get()
    end)
    if not ok or not pc or not pc.Character then return nil end
    local item = pc.Character.EquippedItem
    if not item then return nil end
    return rawget(item, "__item") or item
end

function AR2_applyToInner(inner)
    if not inner then return end
    local id = tostring(inner.Id or inner.ItemName or inner.Name or "unknown")
    if not AR2_originalFireModesCache[id] then
        AR2_originalFireModesCache[id] = inner.FireModes
    end
    inner.FireModes = AR2_allFireModes_table
    return inner
end

function AR2_applyAllFireModes(enabled)
    AR2_CFG.weapon.allFireModes = enabled
    if AR2_allFireModesConn then
        AR2_allFireModesConn:Disconnect()
        AR2_allFireModesConn = nil
    end
    if not enabled then
        local inner = AR2_getEquippedInner()
        if inner then
            local id = tostring(inner.Id or inner.ItemName or inner.Name or "unknown")
            inner.FireModes = AR2_originalFireModesCache[id] or inner.FireModes
        end
        return
    end
    local lastInner = AR2_applyToInner(AR2_getEquippedInner())
    AR2_allFireModesConn = AR2_RunService.Heartbeat:Connect(function()
        if not AR2_CFG.weapon.allFireModes then return end
        local inner = AR2_getEquippedInner()
        if inner and inner ~= lastInner then lastInner = AR2_applyToInner(inner) end
    end)
end

-- =============================================
-- PERSONAL CHARACTER CHAMS
-- =============================================
AR2_personalCharOriginal = {}
AR2_personalCharConn     = nil

function AR2_setPersonalCharacter(enabled, mode, hue, gray, material, rainbow)
    AR2_CFG.misc.personalCharOn       = enabled and true or false
    AR2_CFG.misc.personalCharMode     = mode     or AR2_CFG.misc.personalCharMode
    AR2_CFG.misc.personalCharHue      = hue      or AR2_CFG.misc.personalCharHue
    AR2_CFG.misc.personalCharGray     = gray     or AR2_CFG.misc.personalCharGray
    AR2_CFG.misc.personalCharMaterial = material or AR2_CFG.misc.personalCharMaterial
    AR2_CFG.misc.personalCharRainbow  = rainbow and true or false

    if AR2_personalCharConn then AR2_personalCharConn:Disconnect() AR2_personalCharConn = nil end

    local function restore()
        for part, orig in pairs(AR2_personalCharOriginal) do
            if part and part.Parent then
                pcall(function()
                    part.Color        = orig.Color
                    part.Material     = orig.Material
                    part.Transparency = orig.Transparency
                end)
            end
        end
        AR2_personalCharOriginal = {}
    end

    if not enabled then restore() return end

    local function applyNow()
        local char = AR2_LocalPlayer.Character
        if not char then return end
        local col
        if AR2_CFG.misc.personalCharRainbow then
            AR2_CFG.misc.personalCharHue = (AR2_CFG.misc.personalCharHue + 3) % 360
            col = Color3.fromHSV(AR2_CFG.misc.personalCharHue / 360, 1, 1)
        elseif AR2_CFG.misc.personalCharMode == "BlackWhite" then
            local g = (AR2_CFG.misc.personalCharGray or 100) / 100
            col = Color3.fromRGB(g * 255, g * 255, g * 255)
        else
            col = Color3.fromHSV((AR2_CFG.misc.personalCharHue or 0) / 360, 1, 1)
        end
        local mat = Enum.Material[AR2_CFG.misc.personalCharMaterial] or Enum.Material.ForceField
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                if not AR2_personalCharOriginal[part] then
                    AR2_personalCharOriginal[part] = {
                        Color = part.Color, Material = part.Material, Transparency = part.Transparency,
                    }
                end
                part.Color        = col
                part.Material     = mat
                part.Transparency = 0.35
            end
        end
    end

    applyNow()
    if AR2_CFG.misc.personalCharRainbow then
        AR2_personalCharConn = AR2_RunService.Heartbeat:Connect(applyNow)
    else
        AR2_personalCharConn = AR2_RunService.Heartbeat:Connect(function()
            if not AR2_CFG.misc.personalCharOn then return end
            local char = AR2_LocalPlayer.Character
            if not char then return end
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") and not AR2_personalCharOriginal[part] then
                    applyNow() break
                end
            end
        end)
    end
end

