    elseif AR2_CFG.hitmarker.shape == "Dot" then
        AR2_hitmarkerDrawing[1].Position = center
        AR2_hitmarkerDrawing[1].Transparency = 0
        AR2_hitmarkerDrawing[1].Visible = true
