        AR2_car.toCursor(AR2_CFG.car.method)
    end
end)

-- Personal appearance functions with mode and gray slider
local personalCharOriginal = {}
local personalGunOriginal = {}
local personalCharRainbowConn = nil
local personalGunRainbowConn = nil
local personalGunLoopConn = nil

function AR2_setPersonalCharacter(enabled, mode, hue, gray, materialStr, rainbow)
    AR2_CFG.misc.personalCharOn = enabled
    if mode then AR2_CFG.misc.personalCharMode = mode end
    if hue then AR2_CFG.misc.personalCharHue = hue end
    if gray then AR2_CFG.misc.personalCharGray = gray end
    if materialStr then AR2_CFG.misc.personalCharMaterial = materialStr end
    if rainbow ~= nil then AR2_CFG.misc.personalCharRainbow = rainbow end

    if not enabled then
        if personalCharRainbowConn then personalCharRainbowConn:Disconnect() personalCharRainbowConn = nil end
        for part, orig in pairs(personalCharOriginal) do
            if part.Parent then
                part.Color = orig.Color
                part.Material = orig.Material
                part.Transparency = orig.Transparency
            end
        end
        table.clear(personalCharOriginal)
        return
    end

    local char = AR2_LocalPlayer.Character
    if not char then return end
    task.wait(0.5)
    local material = Enum.Material[AR2_CFG.misc.personalCharMaterial] or Enum.Material.ForceField
    local targetParts = {
        "Head", "UpperTorso", "LowerTorso",
        "LeftUpperArm", "LeftLowerArm", "LeftHand",
        "RightUpperArm", "RightLowerArm", "RightHand",
        "LeftUpperLeg", "LeftLowerLeg", "LeftFoot",
        "RightUpperLeg", "RightLowerLeg", "RightFoot"
    }
    local function getColor()
        if AR2_CFG.misc.personalCharMode == "BlackWhite" then
            local g = AR2_CFG.misc.personalCharGray / 100
            return Color3.fromRGB(g*255, g*255, g*255)
        else
            return Color3.fromHSV(AR2_CFG.misc.personalCharHue/360, 1, 1)
        end
    end

    for _, name in ipairs(targetParts) do
        local part = char:FindFirstChild(name)
        if part and part:IsA("BasePart") then
            if not personalCharOriginal[part] then
                personalCharOriginal[part] = { Color = part.Color, Material = part.Material, Transparency = part.Transparency }
            end
            part.Material = material
            if material == Enum.Material.ForceField then
                part.Transparency = 0.5
            else
                part.Transparency = 0
            end
            part.Color = getColor()
        end
    end

    if AR2_CFG.misc.personalCharRainbow then
        if personalCharRainbowConn then personalCharRainbowConn:Disconnect() end
        personalCharRainbowConn = AR2_RunService.Heartbeat:Connect(function()
            local hue = (tick() * 100) % 360
            local color = Color3.fromHSV(hue/360, 1, 1)
            for _, name in ipairs(targetParts) do
                local part = char:FindFirstChild(name)
                if part and part:IsA("BasePart") then
                    part.Color = color
                end
            end
        end)
    else
        if personalCharRainbowConn then personalCharRainbowConn:Disconnect() personalCharRainbowConn = nil end
    end
end

function AR2_setPersonalGun(enabled, mode, hue, gray, materialStr, rainbow)
    AR2_CFG.misc.personalGunOn = enabled
    if mode then AR2_CFG.misc.personalGunMode = mode end
    if hue then AR2_CFG.misc.personalGunHue = hue end
    if gray then AR2_CFG.misc.personalGunGray = gray end
    if materialStr then AR2_CFG.misc.personalGunMaterial = materialStr end
    if rainbow ~= nil then AR2_CFG.misc.personalGunRainbow = rainbow end

    if not enabled then
        if personalGunRainbowConn then personalGunRainbowConn:Disconnect() personalGunRainbowConn = nil end
        if personalGunLoopConn then personalGunLoopConn:Disconnect() personalGunLoopConn = nil end
        for part, orig in pairs(personalGunOriginal) do
            if part.Parent then
                part.Color = orig.Color
                part.Material = orig.Material
                part.Transparency = orig.Transparency
            end
        end
        table.clear(personalGunOriginal)
        return
    end

    if personalGunLoopConn then personalGunLoopConn:Disconnect() end
    personalGunLoopConn = AR2_RunService.Heartbeat:Connect(function()
        local gun = AR2_findGunModel()
        if not gun then return end
        local material = Enum.Material[AR2_CFG.misc.personalGunMaterial] or Enum.Material.Neon
        local function getColor()
            if AR2_CFG.misc.personalGunMode == "BlackWhite" then
                local g = AR2_CFG.misc.personalGunGray / 100
                return Color3.fromRGB(g*255, g*255, g*255)
            else
                return Color3.fromHSV(AR2_CFG.misc.personalGunHue/360, 1, 1)
            end
        end
        local function applyColor(color)
            for _, descendant in ipairs(gun:GetDescendants()) do
                if descendant:IsA("BasePart") then
                    -- Skip scope/sight parts — they need to stay transparent
                    local n = descendant.Name:lower()
                    local isSight = n:find("scope") or n:find("sight") or n:find("lens")
                        or n:find("glass") or n:find("reticle") or n:find("window")
                        or n:find("dot") or n:find("optic")
                    -- Also skip originally-transparent parts (scope lenses etc)
                    local origT = personalGunOriginal[descendant]
                        and personalGunOriginal[descendant].Transparency
                        or descendant.Transparency
                    if not isSight and origT < 0.8 then
                        if not personalGunOriginal[descendant] then
                            personalGunOriginal[descendant] = {
                                Color = descendant.Color,
                                Material = descendant.Material,
                                Transparency = descendant.Transparency
                            }
                        end
                        descendant.Material = material
                        descendant.Transparency = material == Enum.Material.ForceField and 0.5 or 0
                        descendant.Color = color
                    end
                end
            end
        end
        if AR2_CFG.misc.personalGunRainbow then
            local hue = (tick() * 100) % 360
            applyColor(Color3.fromHSV(hue/360, 1, 1))
        else
            applyColor(getColor())
        end
    end)
end

-- Final initialization
AR2_tracersEnabled = AR2_CFG.misc.tracers
AR2_esp.update()
if AR2_CFG.aim.on then AR2_aim.start() end
AR2_magicUpdate()
AR2_tracersUpdate()
if AR2_CFG.misc.freeze then AR2_freeze.start() end
AR2_visuals.apply()
AR2_carMods.apply()
if AR2_CFG.radar.on then AR2_radar.start() end
if AR2_CFG.speed.on then AR2_speed.start() end
AR2_rageBotSetEnabled(AR2_CFG.rageBot.on)
AR2_toggleFOVZoom(AR2_CFG.misc.fovZoom)
AR2_toggleDistZoomEnabled(AR2_CFG.misc.distZoomEnabled)
AR2_toggleDistanceZoom(AR2_CFG.misc.distZoomActive)
if AR2_CFG.misc.charm then AR2_toggleCharm(true) end
if AR2_CFG.minimap.on then
    AR2_minimapEnabled = true
    AR2_updateMinimap()
end
if AR2_CFG.misc.noclip then AR2_startNoclip() end
if AR2_CFG.misc.infJump then AR2_startInfJump() end
AR2_toggleRemoveTextures(AR2_CFG.misc.removeTextures)
AR2_toggleRemoveTrees(AR2_CFG.misc.removeTrees)
if AR2_CFG.misc.hidePlayer then AR2_toggleHidePlayer(true) end
if AR2_CFG.misc.hideGun then AR2_toggleHideGun(true) end
if AR2_CFG.weapon.wallbang then startWallbangTagging() else stopWallbangTagging() end
AR2_applyAllFireModes(AR2_CFG.weapon.allFireModes)
if AR2_CFG.weapon.instantReload then setInstantReloadEnabled(true) end
if AR2_CFG.misc.personalCharOn then AR2_setPersonalCharacter(true, AR2_CFG.misc.personalCharMode, AR2_CFG.misc.personalCharHue, AR2_CFG.misc.personalCharGray, AR2_CFG.misc.personalCharMaterial, AR2_CFG.misc.personalCharRainbow) end
if AR2_CFG.misc.personalGunOn then AR2_setPersonalGun(true, AR2_CFG.misc.personalGunMode, AR2_CFG.misc.personalGunHue, AR2_CFG.misc.personalGunGray, AR2_CFG.misc.personalGunMaterial, AR2_CFG.misc.personalGunRainbow) end
if AR2_CFG.visuals.skybox ~= "Default" then AR2_applySkybox(AR2_CFG.visuals.skybox) end
if AR2_CFG.hitmarker.enabled then AR2_toggleHitmarker(true) end
if AR2_CFG.crosshair.enabled then AR2_toggleCrosshair(true) end
if AR2_CFG.tp.respawnTP then AR2_toggleRespawnTP(true) end
if AR2_CFG.weapon.hbeOn then AR2_hbeSetEnabled(true) end

AR2_registerAllKeybinds()

function AR2_unload()
    AR2_esp.destroy()
    AR2_aim.destroy()
    AR2_magicUpdate()
    AR2_tracersStop()
    AR2_freeze.destroy()
    AR2_visuals.destroy()
    AR2_carMods.destroy()
    AR2_radar.destroy()
    AR2_speed.stop()
    AR2_rageBotSetEnabled(false)
    AR2_toggleFOVZoom(false)
    AR2_toggleDistZoomEnabled(false)
    AR2_toggleDistanceZoom(false)
    AR2_stopNoclip()
    AR2_stopInfJump()
    AR2_toggleRemoveTextures(false)
    AR2_toggleRemoveTrees(false)
    AR2_toggleHidePlayer(false)
    AR2_toggleHideGun(false)
    stopWallbangTagging()
    AR2_applyAllFireModes(false)
    setInstantReloadEnabled(false)
    AR2_setPersonalCharacter(false)
    AR2_setPersonalGun(false)
    if AR2_CFG.visuals.skybox ~= "Default" then AR2_applySkybox("Default") end
    if AR2_CFG.hitmarker.enabled then AR2_toggleHitmarker(false) end
    if AR2_CFG.crosshair.enabled then AR2_toggleCrosshair(false) end
    AR2_toggleRespawnTP(false)
    AR2_hbeSetEnabled(false)
    if AR2_mapConn then AR2_mapConn:Disconnect() end
    if AR2_mapGui then AR2_mapGui:Destroy() end
    if AR2_minimapGui then AR2_minimapGui:Destroy() end
end
getgenv().__AR2_UNLOAD = AR2_unload
