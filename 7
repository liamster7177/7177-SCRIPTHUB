-- HITMARKER — full implementation
AR2_showHitmarker = function()
    if not AR2_CFG.hitmarker.enabled then return end
    if not AR2_hasDrawing then return end
    local cfg = AR2_CFG.hitmarker
    local cam = workspace.CurrentCamera
    if not cam then return end
    local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    local color = Color3.fromHSV(cfg.colorHue / 360, 1, 1)
    local s = cfg.size
    local drawings = {}

    if cfg.shape == "Cross" then
        local coords = {
            {center + Vector2.new(-s, -s), center + Vector2.new(s,  s)},
            {center + Vector2.new(-s,  s), center + Vector2.new(s, -s)},
        }
        for _, pts in ipairs(coords) do
            local l = Drawing.new("Line")
            l.From, l.To = pts[1], pts[2]
            l.Color = color
            l.Thickness = 2
            l.Transparency = 1
            l.Visible = true
            drawings[#drawings+1] = l
        end
    elseif cfg.shape == "Dot" then
        local c = Drawing.new("Circle")
        c.Position = center
        c.Radius = math.max(2, s / 3)
        c.Color = color
        c.Filled = true
        c.Transparency = 1
        c.Visible = true
        drawings[1] = c
    elseif cfg.shape == "Square" then
        local sq = Drawing.new("Square")
        sq.Position = center - Vector2.new(s, s)
        sq.Size = Vector2.new(s * 2, s * 2)
        sq.Color = color
        sq.Filled = false
        sq.Thickness = 2
        sq.Transparency = 1
        sq.Visible = true
        drawings[1] = sq
    end

    local soundIds = {
        Hit  = "rbxassetid://9118817318",
        Ding = "rbxassetid://4612402584",
        Pop  = "rbxassetid://5801257793",
    }
    if cfg.sound ~= "None" and soundIds[cfg.sound] then
        local snd = Instance.new("Sound")
        snd.SoundId = soundIds[cfg.sound]
        snd.Volume = math.clamp((AR2_CFG.misc.hitSoundVolume or 70) / 100, 0, 1)
        snd.Parent = cam
        snd:Play()
        game:GetService("Debris"):AddItem(snd, 2)
    end

    task.delay(cfg.duration, function()
        for _, d in ipairs(drawings) do
            pcall(function() d:Remove() end)
        end
    end)
end

AR2_success, AR2_Bullets = pcall(function() return require(AR2_ReplicatedStorage.Client.Libraries.Bullets) end)
AR2_originalFireFunction = nil
AR2_recoilOriginal = nil
AR2_spreadOriginal = nil
AR2_recoilOriginalFn = nil

if AR2_success and AR2_Bullets and AR2_Bullets.Fire then
    AR2_originalFireFunction = AR2_Bullets.Fire
    pcall(function()
        AR2_recoilOriginal = debug.getupvalue(AR2_originalFireFunction, 6)
        AR2_spreadOriginal = debug.getupvalue(AR2_originalFireFunction, 3)
        if AR2_recoilOriginal then
            AR2_recoilOriginalFn = AR2_recoilOriginal
        end
    end)

    AR2_Bullets.Fire = function(self, playerController, weaponInstance, weaponData, origin, direction, shotId)
        local ok, result = pcall(function()
            local originalOrigin = origin
            local originalDirection = direction

            local aimEntity, aimPart = nil, nil
            if AR2_CFG.magicAim.on then
                aimEntity, aimPart = AR2_magicTarget()
                AR2_magicAim.target = aimEntity
            end

            if AR2_CFG.magicAim.on and AR2_CFG.magicAim.originShift then
                if aimEntity and aimEntity.model then
                    local headPart = aimEntity.headCollider or aimEntity.head
                    if headPart then
                        local nudge = originalOrigin + originalDirection * AR2_CFG.magicBullet.forwardNudge
                        local newOrigin, clear = AR2_findBestOrigin(nudge, originalDirection, headPart.Position, aimEntity.model)
                        if clear or newOrigin ~= originalOrigin then
                            origin = newOrigin
                            direction = (headPart.Position - origin).Unit
                        end
                    end
                end
            end

            if AR2_CFG.magicAim.on then
                local entity, part = aimEntity, aimPart
                if not entity then entity, part = AR2_magicTarget() end
                if part then
                    local aimPoint = AR2_predict(part, origin, entity.velocity)
                    local bend = aimPoint - origin
                    if bend.Magnitude > 0.001 then
                        local angle = math.deg(math.acos(math.clamp(bend.Unit:Dot(direction.Unit), -1, 1)))
                        local chance = AR2_CFG.magicAim.redirectChance or 100
                        if angle <= AR2_CFG.magicAim.maxBend and math.random(1,100) <= chance then
                            direction = bend.Unit
                        end
                    end
                end
            end

            if AR2_CFG.weapon.recoilReduction and AR2_CFG.weapon.recoilReduction > 0 then
                local reduction = AR2_CFG.weapon.recoilReduction / 100
                if AR2_recoilOriginalFn then
                    local function newRecoil(...)
                        local x, y, z, a, b = AR2_recoilOriginalFn(...)
                        if reduction >= 1 then
                            return Vector2.new(0,0), 0, 0, 0, 0
                        else
                            return Vector2.new(x.X * (1 - reduction), x.Y * (1 - reduction)), z * (1 - reduction), a * (1 - reduction), b * (1 - reduction), 0
                        end
                    end
                    debug.setupvalue(AR2_originalFireFunction, 6, newRecoil)
                end
            else
                if AR2_recoilOriginalFn then
                    debug.setupvalue(AR2_originalFireFunction, 6, AR2_recoilOriginalFn)
                end
            end

            if AR2_CFG.weapon.noSpread then
                debug.setupvalue(AR2_originalFireFunction, 3, function(rng, dir) return dir.Unit end)
            elseif AR2_spreadOriginal then
                debug.setupvalue(AR2_originalFireFunction, 3, AR2_spreadOriginal)
            end

            if AR2_CFG.weapon.wallbang then
                pcall(function()
                    weaponData.Penetration = 9999
                    weaponData.PenetrationPower = 9999
                    weaponData.WallPenetration = 9999
                    weaponData.WallPenetrationPower = 9999
                    weaponData.PierceCount = 9999
                    weaponData.CanPenetrate = true
                    weaponData.PenetrateWalls = true
                end)
            end

            local result
            if AR2_CFG.weapon.noBulletDrop then
                local savedGravity = workspace.Gravity
                workspace.Gravity = 0
                result = AR2_originalFireFunction(self, playerController, weaponInstance, weaponData, origin, direction, shotId)
                workspace.Gravity = savedGravity
            else
                result = AR2_originalFireFunction(self, playerController, weaponInstance, weaponData, origin, direction, shotId)
            end

            if AR2_tracersEnabled then
                AR2_addTracer(origin, direction)
            end

            -- Hitmarker: raycast along bullet path to check for character hit
            if AR2_CFG.hitmarker.enabled then
                local rp = RaycastParams.new()
                rp.FilterType = Enum.RaycastFilterType.Exclude
                rp.FilterDescendantsInstances = { AR2_LocalPlayer.Character }
                local hit = AR2_Workspace:Raycast(origin, direction * 2000, rp)
                if hit and hit.Instance then
                    local model = hit.Instance
                    while model and not model:IsA("Model") do model = model.Parent end
                    if model then
                        local isChar = (AR2_Characters and model.Parent == AR2_Characters)
                            or (ZombiesFolder and model.Parent == ZombiesFolder)
                            or model:FindFirstChildOfClass("Humanoid") ~= nil
                        if isChar then AR2_showHitmarker() end
                    end
                end
            end

            return result
        end)
        if not ok then
            warn("[fire] hook error: " .. tostring(result))
            return AR2_originalFireFunction(self, playerController, weaponInstance, weaponData, origin, direction, shotId)
        end
        return result
    end
end

