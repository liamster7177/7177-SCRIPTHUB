function AR2_api.corpses()
    return AR2_cached("corpses", 0.2, function()
        AR2_ORIGIN = AR2_localPosition()
        local list = {}
        local seen = {}
        if AR2_Corpses then
            for _, child in ipairs(AR2_Corpses:GetChildren()) do
                if child:IsA("Model") then
                    local e = AR2_buildCorpse(child)
                    if e then list[#list+1] = e seen[child] = true end
                end
            end
        end
        -- Also catch players mid-death or who left while dead
        if AR2_Characters then
            for _, child in ipairs(AR2_Characters:GetChildren()) do
                if child:IsA("Model") and not seen[child]
                   and child ~= AR2_LocalPlayer.Character then
                    local hum = child:FindFirstChildWhichIsA("Humanoid")
                    if hum and hum.Health <= 0 then
                        local e = AR2_buildCorpse(child)
                        if e then e.kind = "corpse" list[#list+1] = e end
                    end
                end
            end
        end
        table.sort(list, function(a, b) return a.distance < b.distance end)
        return list
    end)
end

