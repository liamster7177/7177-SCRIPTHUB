        AR2_hitmarkerDrawing[1].Position = center - Vector2.new(AR2_CFG.hitmarker.size/2, AR2_CFG.hitmarker.size/2)
        AR2_hitmarkerDrawing[1].Transparency = 0
        AR2_hitmarkerDrawing[1].Visible = true
    end

    if AR2_CFG.hitmarker.sound ~= "None" then
        local soundId = ""
        if AR2_CFG.hitmarker.sound == "Hit" then soundId = "rbxassetid://12222201"
        elseif AR2_CFG.hitmarker.sound == "Ding" then soundId = "rbxassetid://12222201"
        elseif AR2_CFG.hitmarker.sound == "Pop" then soundId = "rbxassetid://12222201"
