        AR2_hitmarkerDrawing[1].To = center + Vector2.new(size/2, size/2)
        AR2_hitmarkerDrawing[2].From = center - Vector2.new(size/2, -size/2)
        AR2_hitmarkerDrawing[2].To = center + Vector2.new(size/2, -size/2)
