        return element
    end

    local function addSlider(tab, label, cfgTable, cfgKey, min, max, stepOrOnChange, onChange)
        local step = 1
        local callback = onChange
        if type(stepOrOnChange) == "function" then
            callback = stepOrOnChange
        elseif type(stepOrOnChange) == "number" then
            step = stepOrOnChange
        end
        local element = tab:Slider({
            Title = label,
            Step  = step,
            Value = { Min = math.floor(min), Max = math.floor(max), Default = math.floor(cfgTable[cfgKey] or min) },
            Callback = function(value)
                local v = tonumber(value)
                if v then
                    cfgTable[cfgKey] = math.floor(v)
                    AR2_markDirty()
                    if callback then callback(math.floor(v)) end
                end
            end,
        })
        storeElement({
            getter = function() return cfgTable[cfgKey] end,
            setter = function(val) element:Set(val) end
        })
        return element
    end

