local AR2_hiddenTrees = {}
local AR2_treeUpdateConn = nil
local AR2_treeLastUpdate = 0

local function AR2_applyTreeTransparency(part)
    if not AR2_hiddenTrees[part] then
        AR2_hiddenTrees[part] = part.LocalTransparencyModifier
    end
    part.LocalTransparencyModifier = 0.9
end

local function AR2_refreshTreesInRadius()
    if not AR2_CFG.misc.removeTrees then return end
    local playerPos = AR2_localPosition()
    local radius = 1000
    local nearbyParts = AR2_Workspace:GetPartBoundsInRadius(playerPos, radius)
    for _, part in ipairs(nearbyParts) do
        local model = part.Parent
        while model and not model:IsA("Model") do model = model.Parent end
        if model then
            local name = model.Name:lower()
            if name:find("tree") or name:find("bush") or name:find("shrub") or name:find("foliage") then
                for _, descendant in ipairs(model:GetDescendants()) do
                    if descendant:IsA("BasePart") then
                        AR2_applyTreeTransparency(descendant)
                    end
                end
            end
        end
    end
end

function AR2_toggleRemoveTrees(enabled)
    AR2_CFG.misc.removeTrees = enabled
    if enabled then
        for _, obj in ipairs(AR2_Workspace:GetDescendants()) do
            local name = obj.Name:lower()
            if obj:IsA("Model") and
               (name:find("tree") or name:find("bush") or name:find("shrub") or name:find("foliage")) then
                for _, part in ipairs(obj:GetDescendants()) do
                    if part:IsA("BasePart") then
                        AR2_applyTreeTransparency(part)
                    end
                end
            end
        end
        if not AR2_treeUpdateConn then
            AR2_treeUpdateConn = AR2_RunService.Heartbeat:Connect(function()
                local now = os.clock()
                if now - AR2_treeLastUpdate >= 20 then
                    AR2_treeLastUpdate = now
                    pcall(AR2_refreshTreesInRadius)
                end
            end)
        end
    else
        if AR2_treeUpdateConn then
            AR2_treeUpdateConn:Disconnect()
            AR2_treeUpdateConn = nil
        end
        for part, orig in pairs(AR2_hiddenTrees) do
            if part.Parent then
                part.LocalTransparencyModifier = orig
            end
        end
        table.clear(AR2_hiddenTrees)
    end
end

