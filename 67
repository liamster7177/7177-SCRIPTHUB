AR2_parts = function(model)
    return {
        root = model:FindFirstChild("HumanoidRootPart"),
        head = model:FindFirstChild("Head"),
        headCollider = model:FindFirstChild("HeadCollider"),
        torso = model:FindFirstChild("UpperTorso"),
