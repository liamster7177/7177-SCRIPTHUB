## 1. Auto Reload

This feature automatically presses `R` when the magazine is empty, and also includes an "Instant Reload" that skips the reload animation.  
Requires the game's Framework and `VirtualInputManager`.

```lua
-- Services
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedFirst = game:GetService("ReplicatedFirst")
local VirtualInputManager = game:GetService("VirtualInputManager")

-- Framework
local Framework = require(ReplicatedFirst:WaitForChild("Framework"))
Framework:WaitForLoaded()
local PlayerController = Framework.Classes.Players.get()

-- Auto reload state
local autoReloadEnabled = false
local isReloading = false

local function doReload()
    if isReloading then return end
    isReloading = true
    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.R, false, game)
    task.wait(0.05)
    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.R, false, game)
    task.wait(2.5)
    isReloading = false
end

local function checkAmmo()
    if not autoReloadEnabled then return end
    local character = PlayerController.Character
    if not character then return end
    local equipped = character.EquippedItem
    if not equipped or not equipped.__item then return end
    local ammo = equipped.__item.Attachments.Ammo
    if not ammo then return end
    local currentAmmo = ammo.__item.WorkingAmount
    if currentAmmo == 0 and not isReloading then
        doReload()
    end
end

-- Loop
task.spawn(function()
    while true do
        task.wait(0.15)
        pcall(checkAmmo)
    end
end)

-- Enable/disable: set autoReloadEnabled = true/false
```

**Instant Reload** (skip reload animation) – hooks the firearm initializer:

```lua
-- This part requires the specific framework and firearm initializer.
local instantReloadEnabled = false

task.spawn(function()
    pcall(function()
        local Framework = require(ReplicatedFirst:WaitForChild("Framework"))
        Framework:WaitForLoaded()
        local FirearmInitializer = require(game:GetService("ReplicatedStorage").Client.Abstracts.ItemInitializers.Firearm)
        local originalAttemptReload = debug.getupvalue(FirearmInitializer, 7)  -- may need adjustment
        if type(originalAttemptReload) == "function" then
            debug.setupvalue(FirearmInitializer, 7, function(...)
                if instantReloadEnabled then
                    local args = {...}
                    if #args >= 4 then
                        local callback = args[4]
                        if type(callback) == "function" then
                            pcall(function()
                                callback("Commit", "Load")
                                callback("Commit", "End")
                            end)
                        end
                    end
                    return true
                end
                return originalAttemptReload(...)
            end)
        end
    end)
end)
```

