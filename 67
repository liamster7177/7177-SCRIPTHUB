        local function getCurrentHitSoundPreset()
            for _, preset in ipairs(AR2_HITSOUND_PRESETS) do
                if preset.path == AR2_CFG.hitmarker.soundPath and preset.id == AR2_CFG.hitmarker.sound then return preset.name end
