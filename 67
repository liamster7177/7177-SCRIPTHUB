## 11. Player Jesus

Allows walking on water by modifying water surface tags. Water surfaces with the "Swim Surface" tag are changed to "Player Jesus" to become solid.

```lua
local Workspace = game:GetService("Workspace")

local playerJesusEnabled = false

local function setPlayerJesus(enabled)
    local water = Workspace:FindFirstChild("Map") and Workspace.Map:FindFirstChild("Water") or Workspace:FindFirstChild("Water")
    if not water then return end

    for _, part in ipairs(water:GetDescendants()) do
        if enabled then
            if part:HasTag("Swim Surface") then
                part:RemoveTag("Swim Surface")
                part:AddTag("Player Jesus")
            end
        else
            if part:HasTag("Player Jesus") then
                part:RemoveTag("Player Jesus")
                part:AddTag("Swim Surface")
            end
        end
    end
end

-- Usage:
-- setPlayerJesus(true)   -- enable
-- setPlayerJesus(false)  -- disable
```

