## 7. Self Backtrack

Creates a "ghost" of your character at a delayed position, visible only to you.  
Uses `RunService.Heartbeat` to record CFrame history and creates a model `BT_Self` with cloned body parts.

```lua
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer

-- Configuration
local backtrackEnabled = false
local backtrackColor = Color3.fromRGB(255, 255, 255)
local backtrackTransparency = 0.4
local backtrackMaterial = Enum.Material.ForceField
local backtrackDelay = 0.3   -- seconds

-- Internal
local positionHistory = {}
local R15_PARTS = {
    "Head", "UpperTorso", "LowerTorso",
    "LeftUpperArm", "LeftLowerArm", "LeftHand",
    "RightUpperArm", "RightLowerArm", "RightHand",
    "LeftUpperLeg", "LeftLowerLeg", "LeftFoot",
    "RightUpperLeg", "RightLowerLeg", "RightFoot"
}

local function createFakeModel(character, cframe)
    -- Remove previous fake
    local old = Workspace:FindFirstChild("BT_Self")
    if old then old:Destroy() end

    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then return end

    local fakeModel = Instance.new("Model")
    fakeModel.Name = "BT_Self"

    for _, partName in ipairs(R15_PARTS) do
        local realPart = character:FindFirstChild(partName)
        if realPart and realPart:IsA("BasePart") then
            local fakePart = realPart:Clone()
            fakePart.Anchored = true
            fakePart.CanCollide = false
            fakePart.CanQuery = false
            fakePart.CanTouch = false
            fakePart.CastShadow = false
            fakePart.Massless = true
            fakePart.Transparency = backtrackTransparency
            fakePart.Color = backtrackColor
            fakePart.Material = backtrackMaterial
            fakePart.Name = partName

            -- Remove non-mesh children (decals, etc.)
            for _, child in ipairs(fakePart:GetChildren()) do
                if not child:IsA("SpecialMesh") and not child:IsA("DataModelMesh") then
                    child:Destroy()
                end
            end

            local offset = humanoidRootPart.CFrame:ToObjectSpace(realPart.CFrame)
            fakePart.CFrame = cframe * offset
            fakePart.Parent = fakeModel
        end
    end

    fakeModel.Parent = Workspace
end

-- Record history on Heartbeat
RunService.Heartbeat:Connect(function()
    if not backtrackEnabled then
        local old = Workspace:FindFirstChild("BT_Self")
        if old then old:Destroy() end
        positionHistory = {}
        return
    end

    local character = LocalPlayer.Character
    local humanoidRootPart = character and character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then return end

    local now = tick()
    table.insert(positionHistory, { time = now, cframe = humanoidRootPart.CFrame })

    -- Limit history size
    while #positionHistory > 200 do
        table.remove(positionHistory, 1)
    end

    -- Find closest record to desired delay
    local targetTime = now - backtrackDelay
    local bestRecord = nil
    local bestDiff = math.huge
    for _, record in ipairs(positionHistory) do
        local diff = math.abs(record.time - targetTime)
        if diff < bestDiff then
            bestDiff = diff
            bestRecord = record
        end
    end

    if bestRecord then
        createFakeModel(character, bestRecord.cframe)
    end
end)

-- Toggle backtrackEnabled = true/false
```

