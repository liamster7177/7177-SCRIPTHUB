## 6. Color Correction

Applies a `ColorCorrectionEffect` to Lighting with adjustable saturation, contrast, brightness.

```lua
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")

local colorCorrectionEnabled = false
local saturation = 1
local contrast = 0.5   -- will be doubled
local brightness = 1   -- will be reduced by 1

local colorCorrection = nil

local function updateColorCorrection()
    if colorCorrectionEnabled then
        if not colorCorrection or not colorCorrection.Parent then
            colorCorrection = Lighting:FindFirstChildOfClass("ColorCorrectionEffect") or Instance.new("ColorCorrectionEffect")
            colorCorrection.Parent = Lighting
        end
        colorCorrection.Saturation = saturation
        colorCorrection.Contrast = contrast * 2   -- original mapped 0..1 -> 0..2
        colorCorrection.Brightness = brightness - 1 -- original mapped 0.2..2 -> -0.8..1
        colorCorrection.Enabled = true
    else
        if colorCorrection then
            colorCorrection.Enabled = false
        end
    end
end

-- Call updateColorCorrection() whenever a setting changes or toggle is flipped.
```

