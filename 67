function AR2_promptKeybind(featureName, currentKey, callback)
    local gui = Instance.new("ScreenGui")
    gui.Name = "origin_KbPrompt"
    gui.ResetOnSpawn = false
    gui.Parent = (AR2_gethui and AR2_gethui()) or game:GetService("CoreGui")

    local frame = Instance.new("Frame")
    frame.Size = UDim2.fromOffset(320, 130)
    frame.Position = UDim2.fromScale(0.5, 0.5)
    frame.AnchorPoint = Vector2.new(0.5, 0.5)
    frame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    frame.BorderSizePixel = 0
    frame.Parent = gui
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)
    local stroke = Instance.new("UIStroke") stroke.Color = Color3.fromRGB(255,140,30) stroke.Thickness = 1.5 stroke.Parent = frame

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -20, 0, 20)
