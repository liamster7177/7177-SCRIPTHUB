function AR2_cached(key, ttl, build)
    local entry = AR2_cache[key]
    local now = os.clock()
    if entry and (now - entry.at) < ttl then return entry.value end
    local value = build()
    AR2_cache[key] = { at = now, value = value }
    return value
end

