## 3. Remove Leaves

Makes foliage parts (leaves, fronds, pine leaves) transparent. Handles parts added later.

```lua
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")

local removeLeaves = false
local originalTransparencies = {}
local descendantConnection = nil

local function setLeavesTransparency(enabled)
    local mapElements = Workspace:FindFirstChild("Map") and Workspace.Map:FindFirstChild("Elements")
    if not mapElements then return end

    local function processPart(part)
        if part.Name == "Fronds" or part.Name == "Leaves" or part.Name == "PineLeaves" then
            if enabled then
                if not originalTransparencies[part] then
                    originalTransparencies[part] = part.Transparency
                end
                part.Transparency = 1
            else
                local original = originalTransparencies[part]
                if original ~= nil then
                    part.Transparency = original
                else
                    part.Transparency = 0
                end
            end
        end
    end

    -- Apply to existing parts
    for _, part in ipairs(mapElements:GetDescendants()) do
        processPart(part)
    end

    -- Connect to new parts
    if enabled and not descendantConnection then
        descendantConnection = mapElements.DescendantAdded:Connect(function(part)
            task.wait()
            processPart(part)
        end)
    elseif not enabled and descendantConnection then
        descendantConnection:Disconnect()
        descendantConnection = nil
        originalTransparencies = {}
    end
end

-- Toggle: setLeavesTransparency(true) to remove, setLeavesTransparency(false) to restore
```

