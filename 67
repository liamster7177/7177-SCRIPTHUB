        -- Add vertical offset
        local verticalOffset = AR2_CFG.misc.tpDashVert or 0
        local movement = flat.Unit * AR2_CFG.misc.tpDashStuds + Vector3.new(0, verticalOffset, 0)
        root.CFrame = root.CFrame + movement
    end)
end

