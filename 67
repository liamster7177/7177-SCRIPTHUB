AR2_UI_ELEMENTS = {}
AR2_configDropdown = nil

task.spawn(function()
    local okNL, NL = pcall(function()
        return loadstring(game:HttpGet("https://raw.githubusercontent.com/DeviceHB21/mylib/refs/heads/main/source.lua"))()
    end)
    if not okNL or not NL then warn("[Origin HUB] NL library failed to load: "..tostring(NL)) return end

    -- =========================================
    -- THEME — orange & black
    -- =========================================
    local ORANGE       = Color3.fromRGB(255, 140, 30)
    local ORANGE_DARK  = Color3.fromRGB(200, 95, 15)
    local BLACK_BG     = Color3.fromRGB(14, 14, 14)
    local BLACK_PANEL  = Color3.fromRGB(20, 20, 20)
    local BLACK_INPUT  = Color3.fromRGB(35, 35, 35)

    pcall(function() NL.Theme = "Dark" end)
    pcall(function() if NL.SetTheme then NL:SetTheme("Dark") end end)
    pcall(function() if NL.SetAccent then NL:SetAccent(ORANGE) end end)
    pcall(function() if NL.SetAccentColor then NL:SetAccentColor(ORANGE) end end)

    local uiBuildOk, uiBuildErr = pcall(function()
        local Notif = NL:CreateNotification()

        local createOpts = {
            Name="Origin HUB", Content="AR2 | Integrated", Size=NL.Scales.Default,
            ConfigFolder="OriginHUB_Configs", Enable3DRenderer=false, Keybind="P",
            Theme="Dark", Accent=ORANGE,
        }
        pcall(function() createOpts.AccentColor = ORANGE end)
        pcall(function() createOpts.Color = ORANGE end)
        pcall(function() createOpts.Background = BLACK_BG end)
        pcall(function() createOpts.Panel = BLACK_PANEL end)

        local win = NL:CreateWindow(createOpts)

        pcall(function() if NL.SetAccent then NL:SetAccent(ORANGE) end end)
        pcall(function() if NL.SetAccentColor then NL:SetAccentColor(ORANGE) end end)
        pcall(function() if win.SetAccent then win:SetAccent(ORANGE) end end)
        pcall(function() if win.SetAccentColor then win:SetAccentColor(ORANGE) end end)

        -- =========================================
        -- ROBUST ELEMENT STATE SETTER
        -- =========================================
        local function storeElement(e) table.insert(AR2_UI_ELEMENTS,e) end

        local function applyElemState(elem, val)
            if not elem then return end
            if type(elem.Set)      == "function" then pcall(function() elem:Set(val)      end) end
            if type(elem.SetValue) == "function" then pcall(function() elem:SetValue(val) end) end
            if type(elem.Update)   == "function" then pcall(function() elem:Update(val)   end) end
            pcall(function() if elem.Value ~= nil then elem.Value = val end end)
            pcall(function() if elem.State ~= nil then elem.State = val end end)
            if type(elem.Set) == "function" then
                task.spawn(function()
                    pcall(function() elem:Set(not val) end)
                    task.wait(0.05)
                    pcall(function() elem:Set(val) end)
                end)
            end
        end

        -- Robust text setter for inputs
        local function applyInputText(elem, text)
            if not elem then return end
            local s = tostring(text or "")
            if type(elem.Set)       == "function" then pcall(function() elem:Set(s)       end) end
            if type(elem.SetText)   == "function" then pcall(function() elem:SetText(s)   end) end
            if type(elem.SetValue)  == "function" then pcall(function() elem:SetValue(s)  end) end
            pcall(function() if elem.Text  ~= nil then elem.Text  = s end end)
            pcall(function() if elem.Value ~= nil then elem.Value = s end end)
        end

        local function addToggle(section,label,cfgTable,cfgKey,callback)
            local lbl=section:AddLabel(label)
            local elem=lbl:AddToggle({
                Default=cfgTable[cfgKey] or false,
                Flag="origin_"..label:gsub("[^%w]","_"),
                Callback=function(v) cfgTable[cfgKey]=v if callback then callback(v) end end,
            })
            storeElement({
                getter = function() return cfgTable[cfgKey] end,
                setter = function(val) applyElemState(elem, val) end,
            })
            return lbl,elem
        end

        local function addSlider(section,label,cfgTable,cfgKey,min,max,stepOrOnChange,onChange)
            local callback=onChange if type(stepOrOnChange)=="function" then callback=stepOrOnChange end
            local rounding=type(stepOrOnChange)=="number" and stepOrOnChange<1 and 2 or 0
            local def=cfgTable[cfgKey]
            if type(def)~="number" or def~=def or def==math.huge or def==-math.huge then def=min end
            def=math.clamp(def,min,max)
            local elem=section:AddLabel(label):AddSlider({
                Min=min,Max=max,Default=def,Rounding=rounding,
                Flag="origin_"..label:gsub("[^%w]","_"),
                Callback=function(v) cfgTable[cfgKey]=v if callback then callback(v) end end,
            })
            storeElement({
                getter = function() return cfgTable[cfgKey] end,
                setter = function(val) applyElemState(elem, val) end,
            })
            return elem
        end

        local function addDropdown(section,label,options,cfgTable,cfgKey,callback)
            local elem=section:AddLabel(label):AddDropdown({
                Default=cfgTable[cfgKey],Values=options,
                Flag="origin_"..label:gsub("[^%w]","_"),
                Callback=function(v) cfgTable[cfgKey]=v if callback then callback(v) end end,
            })
            storeElement({
                getter = function() return cfgTable[cfgKey] end,
                setter = function(val) applyElemState(elem, val) end,
            })
            return elem
        end

        local function addColorPicker(section,label,cfgTable,cfgKey,callback)
            local ok,elem=pcall(function()
                return section:AddLabel(label):AddColorPicker({
                    Default=cfgTable[cfgKey],
                    Flag="origin_"..label:gsub("[^%w]","_"),
                    Callback=function(v) cfgTable[cfgKey]=v if callback then callback(v) end end,
                })
            end)
            if not ok then warn("[Origin HUB] addColorPicker failed for "..label) return end
            storeElement({
                getter = function() return cfgTable[cfgKey] end,
                setter = function(val) applyElemState(elem, val) end,
            })
        end

        -- =========================================
        -- KEYBIND INPUT — text box (button opens prompt on click)
        -- We build a small UI: a label + a Textbox styled like an input
        -- Because NL lacks a reliable text input, we use a button that
        -- opens the prompt. The button displays the CURRENT key and
        -- refreshes whenever the value changes.
        -- =========================================
        local function addKeybindEntry(section, label, cfgKey)
            -- Create the label first
            local lbl = section:AddLabel(label)

            -- Build button showing current value; clicking opens prompt
            local function currentText()
                local k = AR2_CFG.keybinds[cfgKey] or "None"
                return label .. "  →  " .. k
            end

            local btn
            local ok = pcall(function()
                btn = section:AddButton({
                    Name = currentText(),
                    Callback = function()
                        AR2_promptKeybind(label, AR2_CFG.keybinds[cfgKey], function(newKey)
                            AR2_CFG.keybinds[cfgKey] = newKey
                            AR2_markDirty()
                            -- Update button label
                            if btn then
                                pcall(function() if btn.SetName  then btn:SetName(currentText())  end end)
                                pcall(function() if btn.SetTitle then btn:SetTitle(currentText()) end end)
                                pcall(function() if btn.SetText  then btn:SetText(currentText())  end end)
                                pcall(function() if btn.Set      then btn:Set(currentText())      end end)
                                pcall(function() if btn.Name  ~= nil then btn.Name  = currentText() end end)
                                pcall(function() if btn.Title ~= nil then btn.Title = currentText() end end)
                                pcall(function() if btn.Text  ~= nil then btn.Text  = currentText() end end)
                            end
                        end)
                    end,
                })
            end)

            if not ok or not btn then
                warn("[Origin HUB] keybind button failed for "..label)
                return
            end

            -- Let refreshUI update the button label when a config loads
            storeElement({
                getter = function() return AR2_CFG.keybinds[cfgKey] end,
                setter = function(_)
                    if not btn then return end
                    pcall(function() if btn.SetName  then btn:SetName(currentText())  end end)
                    pcall(function() if btn.SetTitle then btn:SetTitle(currentText()) end end)
                    pcall(function() if btn.SetText  then btn:SetText(currentText())  end end)
                    pcall(function() if btn.Set      then btn:Set(currentText())      end end)
                    pcall(function() if btn.Name  ~= nil then btn.Name  = currentText() end end)
                    pcall(function() if btn.Title ~= nil then btn.Title = currentText() end end)
                    pcall(function() if btn.Text  ~= nil then btn.Text  = currentText() end end)
                end,
            })
        end

        -- =========================================
        -- ESP TAB
        -- =========================================
        local espTab = win:AddTab({Icon="eye",Name="ESP"})
        local playerSection = espTab:AddSection({Name="Player ESP"})
        addToggle(playerSection,"Enabled",AR2_CFG.players,"on",function(v) AR2_esp.update() end)
        addToggle(playerSection,"Box",AR2_CFG.players,"box")
        addToggle(playerSection,"Name",AR2_CFG.players,"name")
        addToggle(playerSection,"Tracer",AR2_CFG.players,"tracer")
        addToggle(playerSection,"Chams",AR2_CFG.players,"chams")
        addToggle(playerSection,"Weapon",AR2_CFG.players,"weapon")
        addToggle(playerSection,"Distance",AR2_CFG.players,"dist")
        addToggle(playerSection,"Health Bar",AR2_CFG.players,"healthBar",function() end)
        addSlider(playerSection,"Max Distance",AR2_CFG.players,"maxDist",100,10000)

        local advCorpseSection = espTab:AddSection({Name="Corpse ESP (Advanced)",Position="right"})
        addToggle(advCorpseSection,"Enabled",advCorpseESP,"enabled",function(v) toggleAdvCorpseESP(v) end)
        addToggle(advCorpseSection,"Show Names",advCorpseESP,"showNames",function(v) setAdvCorpseSetting("showNames",v) end)
        addToggle(advCorpseSection,"Show Distance",advCorpseESP,"showDistance",function(v) setAdvCorpseSetting("showDistance",v) end)
        addColorPicker(advCorpseSection,"Highlight Color",advCorpseESP,"highlightColor",function(v) setAdvCorpseSetting("highlightColor",v) end)
        addColorPicker(advCorpseSection,"Name Color",advCorpseESP,"nameColor",function(v) setAdvCorpseSetting("nameColor",v) end)
        addColorPicker(advCorpseSection,"Distance Color",advCorpseESP,"distanceColor",function(v) setAdvCorpseSetting("distanceColor",v) end)
        addSlider(advCorpseSection,"Max Distance",advCorpseESP,"maxDistance",100,20000,function(v) setAdvCorpseSetting("maxDistance",v) end)

        local lootSection = espTab:AddSection({Name="Loot ESP"})
        addToggle(lootSection,"Enabled",AR2_CFG.loot,"on",function(v) AR2_esp.update() end)
        addSlider(lootSection,"Max Distance",AR2_CFG.loot,"maxDist",100,5000)
        addSlider(lootSection,"Min Rank",AR2_CFG.loot,"minRank",0,5)

        local zombieSection = espTab:AddSection({Name="Zombie ESP",Position="right"})
        addToggle(zombieSection,"Enabled",AR2_CFG.zombies,"on",function(v) AR2_esp.update() end)
        addToggle(zombieSection,"Health Bar",AR2_CFG.zombies,"healthBar",function() end)
        addSlider(zombieSection,"Max Distance",AR2_CFG.zombies,"maxDist",100,3000)

        local vehicleSection = espTab:AddSection({Name="Vehicle ESP"})
        addToggle(vehicleSection,"Enabled",AR2_CFG.vehicles,"on",function(v) AR2_esp.update() end)
        addSlider(vehicleSection,"Max Distance",AR2_CFG.vehicles,"maxDist",100,5000)

        -- =========================================
        -- COMBAT TAB
        -- =========================================
        local combatTab = win:AddTab({Icon="crosshair",Name="Combat"})
        local aimbotSection = combatTab:AddSection({Name="Aimbot"})
        addToggle(aimbotSection,"Enabled",AR2_CFG.aim,"on",function(v) if v then AR2_aim.start() else AR2_aim.stop() end end)
        addDropdown(aimbotSection,"Target Part",AR2_AIM_PARTS,AR2_CFG.aim,"part")
        addSlider(aimbotSection,"FOV",AR2_CFG.aim,"fov",20,500)
        addSlider(aimbotSection,"Smoothing",AR2_CFG.aim,"smooth",3,60)
        addToggle(aimbotSection,"Wall Check",AR2_CFG.aim,"wallCheck")
        addToggle(aimbotSection,"Show FOV",AR2_CFG.aim,"showFov")

        local silentAimSection = combatTab:AddSection({Name="Silent Aim",Position="right"})
        addToggle(silentAimSection,"Enabled",AR2_CFG.magicAim,"on",function(v) AR2_magicUpdate() end)
        addSlider(silentAimSection,"FOV",AR2_CFG.magicAim,"fov",20,800)
        addSlider(silentAimSection,"Max Bend",AR2_CFG.magicAim,"maxBend",1,180)
        addSlider(silentAimSection,"Max Distance",AR2_CFG.magicAim,"maxDist",100,10000)
        addDropdown(silentAimSection,"Target Part",AR2_MAGIC_AIM_PARTS,AR2_CFG.magicAim,"part")
        addToggle(silentAimSection,"Players",AR2_CFG.magicAim,"players")
        addToggle(silentAimSection,"Zombies",AR2_CFG.magicAim,"zombies")
        addToggle(silentAimSection,"Skip Teammates",AR2_CFG.magicAim,"noTeammate",function(v) AR2_CFG.magicAim.noTeammate=v end)
        addToggle(silentAimSection,"Visible Only",AR2_CFG.magicAim,"visCheck")
