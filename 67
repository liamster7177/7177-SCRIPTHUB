                local selectedPreset
                for _,preset in ipairs(AR2_HITSOUND_PRESETS) do if preset.name==selectedName then selectedPreset=preset break end end
                if selectedPreset then
                    if selectedPreset.name=="Custom..." then
                        AR2_CFG.hitmarker.sound="Custom..." AR2_CFG.hitmarker.soundPath=AR2_CFG.hitmarker.soundPath or ""
                    else
                        AR2_CFG.hitmarker.sound=selectedPreset.id AR2_CFG.hitmarker.soundPath=selectedPreset.path AR2_hitSoundLoad(AR2_CFG.hitmarker.soundPath)
                    end
                    AR2_markDirty()
