## 5. Clouds

Modifies the `Clouds` object (if present in workspace). Allows toggling clouds and changing color, cover, density.

```lua
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")

local clouds = Workspace:FindFirstChildOfClass("Clouds") or (Workspace.Terrain and Workspace.Terrain:FindFirstChildOfClass("Clouds"))
if not clouds then
    warn("Clouds object not found")
    return
end

-- Defaults from game (adjust as needed)
local defaultEnabled = clouds.Enabled
local defaultColor = clouds.Color
local defaultCover = clouds.Cover
local defaultDensity = clouds.Density

-- User settings
local modifyClouds = false
local cloudsEnabled = true
local cloudsColor = defaultColor
local cloudsCover = 0.5
local cloudsDensity = 0.5

-- Apply continuously
RunService.RenderStepped:Connect(function()
    if modifyClouds then
        clouds.Enabled = cloudsEnabled
        clouds.Color = cloudsColor
        clouds.Cover = cloudsCover
        clouds.Density = cloudsDensity
    else
        -- Restore defaults when not modifying
        clouds.Enabled = defaultEnabled
        clouds.Color = defaultColor
        clouds.Cover = defaultCover
        clouds.Density = defaultDensity
    end
end)

-- Set modifyClouds = true to start applying your values.
```

