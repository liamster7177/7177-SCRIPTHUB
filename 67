## 8. Jump Circle

Creates an expanding ring effect on the ground when the player jumps.

```lua
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")

local LocalPlayer = Players.LocalPlayer

-- Configuration
local jumpCircleEnabled = false
local circleColor = Color3.new(1, 1, 1)
local startRadius = 1
local endRadius = 12
local duration = 1.2
local iconTexture = "rbxassetid://89391029290549"   -- default icon

local function spawnJumpCircle(position)
    local part = Instance.new("Part")
    part.Name = "JumpCircleEffect"
    part.Shape = Enum.PartType.Block
    part.Material = Enum.Material.ForceField
    part.Transparency = 1
    part.Color = circleColor
    part.Size = Vector3.new(startRadius, 0.05, startRadius)
    part.Anchored = true
    part.CanCollide = false
    part.CastShadow = false

    -- Raycast downward to place on ground
    local raycastParams = RaycastParams.new()
    if LocalPlayer.Character then
        raycastParams.FilterDescendantsInstances = {LocalPlayer.Character}
    end
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude

    local rayResult = Workspace:Raycast(position, Vector3.new(0, -15, 0), raycastParams)
    if rayResult then
        part.Position = rayResult.Position + Vector3.new(0, 0.1, 0)
    else
        part.Position = position - Vector3.new(0, 3, 0)
    end

    -- Decal
    local decal = Instance.new("Decal")
    decal.Texture = iconTexture
    decal.Face = Enum.NormalId.Top
    decal.Transparency = 0.1
    decal.Color3 = circleColor
    decal.Parent = part

    part.Parent = Workspace

    -- Tween expand
    local expandTween = TweenService:Create(part, TweenInfo.new(duration, Enum.EasingStyle.Circular, Enum.EasingDirection.Out), {
        Size = Vector3.new(endRadius, 0.05, endRadius)
    })
    local fadeTween = TweenService:Create(decal, TweenInfo.new(duration * 0.8, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
        Transparency = 1
    })

    expandTween:Play()
    fadeTween:Play()
    expandTween.Completed:Once(function()
        part:Destroy()
    end)
end

local function onCharacterAdded(character)
    local humanoid = character:WaitForChild("Humanoid")
    humanoid.StateChanged:Connect(function(_, state)
        if state == Enum.HumanoidStateType.Jumping and jumpCircleEnabled then
            local rootPart = character:FindFirstChild("HumanoidRootPart")
            if rootPart then
                spawnJumpCircle(rootPart.Position)
            end
        end
    end)
end

LocalPlayer.CharacterAdded:Connect(onCharacterAdded)
if LocalPlayer.Character then
    onCharacterAdded(LocalPlayer.Character)
end

-- Toggle jumpCircleEnabled = true/false
```

