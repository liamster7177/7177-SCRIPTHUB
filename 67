-- TRACERS
AR2_tracers = {}
AR2_tracersConn = nil
local AR2_beamPool = {}

local function AR2_tweenNumber(from, to, duration, callback)
    local startTime = tick()
    local conn
    conn = AR2_RunService.Heartbeat:Connect(function()
        local alpha = math.clamp((tick() - startTime) / duration, 0, 1)
        callback(from + (to - from) * alpha)
        if alpha >= 1 then conn:Disconnect() end
    end)
end

function AR2_addTracer(origin, direction)
    if not AR2_tracersEnabled then return end
    local terrain = AR2_Workspace.Terrain
    if not terrain then return end

    local length = (AR2_CFG.misc.tracerLength or 10) * 100
    local dir = direction.Unit
    local perp1 = Vector3.new(-dir.Z, 0, dir.X)
    local perp2 = Vector3.new(0, dir.Z, -dir.X)

    if AR2_CFG.misc.tracerLightning then
        local segments = 20
        local points = {origin}
        for i = 1, segments do
            local frac = i / segments
            local basePoint = origin + dir * (length * frac)
            local offset = (perp1 * (math.random() - 0.5) + perp2 * (math.random() - 0.5)) * (math.random() * 6 + 2)
            table.insert(points, basePoint + offset)
        end

        for i = 1, #points - 1 do
            local a0 = Instance.new("Attachment") a0.Position = points[i] a0.Parent = terrain
            local a1 = Instance.new("Attachment") a1.Position = points[i + 1] a1.Parent = terrain
            local beam = Instance.new("Beam")
            beam.FaceCamera = true beam.LightEmission = 1 beam.Texture = "rbxassetid://2382169232"
            beam.Width0 = AR2_CFG.misc.tracerWidth or 2 beam.Width1 = AR2_CFG.misc.tracerWidth or 2
            beam.Attachment0 = a0 beam.Attachment1 = a1 beam.Parent = terrain
            if AR2_CFG.misc.tracerRainbow then
                local hue = (tick() * 1000 % 360) / 360
                beam.Color = ColorSequence.new(Color3.fromHSV(hue, 1, 1))
            else
                beam.Color = ColorSequence.new(Color3.fromHSV(AR2_CFG.misc.tracerHue / 360, 1, 1))
            end
            beam.Transparency = NumberSequence.new(0)
            local lifetime = 0.4
            task.delay(lifetime / 2, function()
                AR2_tweenNumber(0, 1, lifetime / 2, function(t) if beam.Parent then beam.Transparency = NumberSequence.new(t) end end)
                task.delay(lifetime / 2, function() beam:Destroy() a0:Destroy() a1:Destroy() end)
            end)
        end
    else
        local a0 = Instance.new("Attachment") a0.Position = origin a0.Parent = terrain
        local a1 = Instance.new("Attachment") a1.Position = origin + dir * length a1.Parent = terrain
        local beam = Instance.new("Beam")
        beam.FaceCamera = true beam.LightEmission = 1 beam.Texture = "rbxassetid://2382169232"
        beam.Width0 = AR2_CFG.misc.tracerWidth or 2 beam.Width1 = AR2_CFG.misc.tracerWidth or 2
        beam.Attachment0 = a0 beam.Attachment1 = a1 beam.Parent = terrain
        if AR2_CFG.misc.tracerRainbow then
            local hue = (tick() * 1000 % 360) / 360
            beam.Color = ColorSequence.new(Color3.fromHSV(hue, 1, 1))
        else
            beam.Color = ColorSequence.new(Color3.fromHSV(AR2_CFG.misc.tracerHue / 360, 1, 1))
        end
        beam.Transparency = NumberSequence.new(0)
        local lifetime = 0.4
        task.delay(lifetime / 2, function()
            AR2_tweenNumber(0, 1, lifetime / 2, function(t) if beam.Parent then beam.Transparency = NumberSequence.new(t) end end)
            task.delay(lifetime / 2, function() beam:Destroy() a0:Destroy() a1:Destroy() end)
        end)
    end
end

