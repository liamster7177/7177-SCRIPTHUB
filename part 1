function AR2_newVisual()
    local box = Drawing.new("Square")
    box.Thickness, box.Filled, box.Transparency, box.Visible = 1, false, 1, false
    local name = Drawing.new("Text")
    name.Size, name.Center, name.Outline, name.Visible = AR2_CFG.style.textSize, true, true, false
    local info = Drawing.new("Text")
    info.Size, info.Center, info.Outline, info.Visible = AR2_CFG.style.textSize - 1, true, true, false
    local tracer = Drawing.new("Line")
    tracer.Thickness, tracer.Transparency, tracer.Visible = 1, 1, false
    return { box = box, name = name, info = info, tracer = tracer }
end

function AR2_acquireVisual(index)
    local v = AR2_drawPool[index]
    if not v then v = AR2_newVisual() AR2_drawPool[index] = v end
    return v
end

function AR2_hideVisual(v)
    v.box.Visible, v.name.Visible, v.info.Visible, v.tracer.Visible = false, false, false, false
end

function AR2_screenBox(model)
    local cam = Workspace.CurrentCamera
    if not cam then return nil end
    local cf, size
    if model:IsA("Model") then
        local ok, a, b = pcall(model.GetBoundingBox, model)
        if not ok then return nil end
        cf, size = a, b
    elseif model:IsA("BasePart") then
        cf, size = model.CFrame, model.Size
    else return nil end
    local minX, minY = math.huge, math.huge
    local maxX, maxY = -math.huge, -math.huge
    local anyOnScreen = false
    for x = -1, 1, 2 do for y = -1, 1, 2 do for z = -1, 1, 2 do
        local corner = cf * CFrame.new(size.X/2*x, size.Y/2*y, size.Z/2*z)
        local point, onScreen = cam:WorldToViewportPoint(corner.Position)
        if point.Z > 0 then
            anyOnScreen = anyOnScreen or onScreen
            if point.X < minX then minX = point.X end
            if point.Y < minY then minY = point.Y end
            if point.X > maxX then maxX = point.X end
            if point.Y > maxY then maxY = point.Y end
        end
    end end end
    if not anyOnScreen or minX == math.huge then return nil end
    return minX, minY, maxX - minX, maxY - minY
end

AR2_slot = 0
function AR2_drawEntity(model, color, label, sub, opt)
    local x, y, w, h = AR2_screenBox(model)
    if not x then return false end
    AR2_slot = AR2_slot + 1
    local v = AR2_acquireVisual(AR2_slot)
    if opt.box then
        v.box.Position, v.box.Size = Vector2.new(x, y), Vector2.new(w, h)
        v.box.Color, v.box.Thickness, v.box.Visible = color, AR2_CFG.style.boxThickness, true
    else v.box.Visible = false end
    if label and label ~= "" then
        v.name.Text, v.name.Color = label, color
        v.name.Size = AR2_CFG.style.textSize
        v.name.Position, v.name.Visible = Vector2.new(x + w/2, y - AR2_CFG.style.textSize - 2), true
    else v.name.Visible = false end
    if sub and sub ~= "" then
        v.info.Text, v.info.Color = sub, color
        v.info.Size = AR2_CFG.style.textSize - 1
        v.info.Position, v.info.Visible = Vector2.new(x + w/2, y + h + 1), true
    else v.info.Visible = false end
    if opt.tracer then
        local cam = Workspace.CurrentCamera
        local origin = AR2_CFG.style.tracerFromBottom and Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y) or Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)
        v.tracer.From, v.tracer.To = origin, Vector2.new(x + w/2, y + h)
        v.tracer.Color, v.tracer.Thickness, v.tracer.Visible = color, AR2_CFG.style.tracerThickness, true
    else v.tracer.Visible = false end
    return true
end

