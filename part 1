-- =============================================
-- Step 6: Ragebot replacement
-- =============================================
AR2_lastFireParams = nil
local AR2_rbConn = nil
local AR2_rbLastFire = 0

local function AR2_rageBotStep()
    local c = AR2_CFG.rageBot
    if not c.on then return end

    if c.requireADS then
        if not AR2_UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then return end
    end

    local inner = AR2_getEquippedInner()
    if not c.noWeaponRequired and not inner then return end

    local fireInterval = 0.1
    if inner and inner.FireConfig and inner.FireConfig.FireRate then
        fireInterval = math.max(0.05, 60 / inner.FireConfig.FireRate)
    end
    local now = os.clock()
    if now - AR2_rbLastFire < fireInterval then return end

    local entity, part = AR2_magicTarget()

    if not entity and c.protection then
        local pool = c.players and AR2_api.players() or {}
        for _, e in ipairs(pool) do
            if e.distance <= c.protectionRadius then
                entity, part = e, AR2_aimPartOf(e, AR2_CFG.magicAim.part)
                break
            end
        end
    end

    if not entity or not part then return end
    if not AR2_originalFireFunction or not AR2_lastFireParams then return end

    AR2_rbLastFire = now

    local origin = AR2_localPosition()
    local char   = AR2_LocalPlayer.Character
    local hrp    = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then origin = hrp.Position + Vector3.new(0, 1.5, 0) end

    local direction = (part.Position - origin).Unit

    pcall(AR2_originalFireFunction,
        AR2_lastFireParams.self,
        AR2_lastFireParams.pc,
        AR2_lastFireParams.wi,
        AR2_lastFireParams.wd,
        origin,
        direction,
        math.random(100000, 999999)
    )
end

function AR2_rageBotSetEnabled(enabled)
    AR2_CFG.rageBot.on = enabled
    if AR2_rbConn then AR2_rbConn:Disconnect() AR2_rbConn = nil end
    if enabled then
        AR2_rbConn = AR2_RunService.Heartbeat:Connect(function()
            local ok, err = pcall(AR2_rageBotStep)
            if not ok then warn("[ragebot] " .. tostring(err)) end
        end)
    end
end

