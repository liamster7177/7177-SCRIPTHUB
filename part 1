    while parent do
        if parent:FindFirstChildOfClass("Humanoid") then return true end
        if parent:IsA("Model") and (parent.Parent == CharactersFolder or parent.Parent == ZombiesFolder) then return true end
        parent = parent.Parent
    end
    return false
