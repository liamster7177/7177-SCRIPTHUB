AR2_visuals = {}
local AR2_lightingSnapshot = nil

local function AR2_snapshotLighting()
    if AR2_lightingSnapshot then return end
    local atm = AR2_Lighting:FindFirstChildWhichIsA("Atmosphere")
    AR2_lightingSnapshot = {
        brightness     = AR2_Lighting.Brightness,
        clockTime      = AR2_Lighting.ClockTime,
        globalShadows  = AR2_Lighting.GlobalShadows,
        ambient        = AR2_Lighting.Ambient,
        outdoorAmbient = AR2_Lighting.OutdoorAmbient,
        fogEnd         = AR2_Lighting.FogEnd,
        fogStart       = AR2_Lighting.FogStart,
        fogColor       = AR2_Lighting.FogColor,
        atmDensity     = atm and atm.Density or 0.395,
        atmOffset      = atm and atm.Offset  or 0,
    }
end

function AR2_visuals.apply()
    AR2_snapshotLighting()
    local c = AR2_CFG.visuals
    local s = AR2_lightingSnapshot
    local atm = AR2_Lighting:FindFirstChildWhichIsA("Atmosphere")

    if c.fullbright then
        AR2_Lighting.Brightness     = c.brightness
        AR2_Lighting.ClockTime      = 14
        AR2_Lighting.GlobalShadows  = false
        AR2_Lighting.Ambient        = Color3.fromRGB(178, 178, 178)
        AR2_Lighting.OutdoorAmbient = Color3.fromRGB(178, 178, 178)
        if atm then atm.Density = 0 atm.Offset = 0 end
    else
        AR2_Lighting.GlobalShadows  = s.globalShadows
        AR2_Lighting.Ambient        = s.ambient
        AR2_Lighting.OutdoorAmbient = s.outdoorAmbient
        if not c.setTime then
            AR2_Lighting.Brightness = s.brightness
            AR2_Lighting.ClockTime  = s.clockTime
        end
    end

    if c.setTime then AR2_Lighting.ClockTime = c.time end

    if c.nofog then
        AR2_Lighting.FogEnd   = 9e9
        AR2_Lighting.FogStart = 9e9
        if atm then atm.Density = 0 atm.Offset = 0 end
    else
        AR2_Lighting.FogEnd   = s.fogEnd
        AR2_Lighting.FogStart = s.fogStart
        AR2_Lighting.FogColor = s.fogColor
        if atm and not c.fullbright then
            atm.Density = s.atmDensity
            atm.Offset  = s.atmOffset
        end
    end
end

function AR2_setClouds(enabled, modify, color, cover, density)
    AR2_CFG.visuals.cloudsEnabled = enabled
    AR2_CFG.visuals.modifyClouds = modify
    if color then AR2_CFG.visuals.cloudsColor = color end
    if cover then AR2_CFG.visuals.cloudsCover = cover end
    if density then AR2_CFG.visuals.cloudsDensity = density end
    
    local terrain = workspace:FindFirstChildWhichIsA("Terrain")
    local clouds = terrain and terrain:FindFirstChildWhichIsA("Clouds")
    
    if not clouds then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Clouds") then
                clouds = obj
                break
            end
        end
    end
    
    if clouds then
        if enabled then
            clouds.Enabled = true
            if modify then
                pcall(function()
                    clouds.Color = AR2_CFG.visuals.cloudsColor or Color3.fromRGB(255,255,255)
                    clouds.Cover = AR2_CFG.visuals.cloudsCover or 0.5
                    clouds.Density = AR2_CFG.visuals.cloudsDensity or 0.5
                end)
            end
        else
            clouds.Enabled = false
        end
    end
end

local AR2_skyboxOriginal = nil
function AR2_applySkybox(preset)
    AR2_CFG.visuals.skybox = preset
    local sky = AR2_Lighting:FindFirstChildWhichIsA("Sky")
    if sky and not AR2_skyboxOriginal then
        AR2_skyboxOriginal = {
            Bk = sky.SkyboxBk, Dn = sky.SkyboxDn, Ft = sky.SkyboxFt,
            Lf = sky.SkyboxLf, Rt = sky.SkyboxRt, Up = sky.SkyboxUp,
        }
    end
    if preset == "Default" then
        if sky and AR2_skyboxOriginal then
            sky.SkyboxBk = AR2_skyboxOriginal.Bk sky.SkyboxDn = AR2_skyboxOriginal.Dn
            sky.SkyboxFt = AR2_skyboxOriginal.Ft sky.SkyboxLf = AR2_skyboxOriginal.Lf
            sky.SkyboxRt = AR2_skyboxOriginal.Rt sky.SkyboxUp = AR2_skyboxOriginal.Up
        end
        return
    end
    if not sky then sky = Instance.new("Sky") sky.Parent = AR2_Lighting end
    local presets = {
        Night = {
            Bk="rbxassetid://159454299", Dn="rbxassetid://159454296", Ft="rbxassetid://159454293",
            Lf="rbxassetid://159454286", Rt="rbxassetid://159454300", Up="rbxassetid://159454302",
        },
        Bluesky = {
            Bk="rbxassetid://6444884", Dn="rbxassetid://6444881", Ft="rbxassetid://6444882",
            Lf="rbxassetid://6444883", Rt="rbxassetid://6444880", Up="rbxassetid://6444879",
        },
    }
    local p = presets[preset]
    if not p then return end
    sky.SkyboxBk=p.Bk sky.SkyboxDn=p.Dn sky.SkyboxFt=p.Ft
    sky.SkyboxLf=p.Lf sky.SkyboxRt=p.Rt sky.SkyboxUp=p.Up
end

local AR2_removedTextures = {}
function AR2_toggleRemoveTextures(enabled)
    AR2_CFG.misc.removeTextures = enabled
    if enabled then
        for _, obj in ipairs(AR2_Workspace:GetDescendants()) do
            if obj:IsA("Texture") or obj:IsA("Decal") then
                AR2_removedTextures[obj] = obj.Transparency
                obj.Transparency = 1
            end
        end
    else
        for obj, t in pairs(AR2_removedTextures) do
            if obj and obj.Parent then obj.Transparency = t end
        end
        AR2_removedTextures = {}
    end
end
