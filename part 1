local AR2_jesusStateConn = nil

function AR2_toggleJesus(enabled)
    AR2_CFG.misc.jesus = enabled
    local char = AR2_LocalPlayer.Character
    local hum  = char and char:FindFirstChildWhichIsA("Humanoid")

    if AR2_jesusStateConn then
        AR2_jesusStateConn:Disconnect()
        AR2_jesusStateConn = nil
