        function AR2_refreshUI()
            for _, elem in ipairs(AR2_UI_ELEMENTS) do
                local val = elem.getter()
                if val ~= nil and elem.setter then
                    local ok, err = pcall(elem.setter, val)
                    if not ok then warn("[Origin HUB] refreshUI error: "..tostring(err)) end
                end
            end
        end
        AR2_refreshUI()
    end)
    if not uiBuildOk and uiBuildErr then
        warn("[Origin HUB] UI build failed: "..tostring(uiBuildErr))
    end

    local hostAfter = (typeof(gethui) == "function" and gethui()) or game:GetService("CoreGui")
    for _, c in ipairs(hostAfter:GetChildren()) do
        if c:IsA("ScreenGui") and not snapshot[c] then
