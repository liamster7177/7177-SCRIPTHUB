        local Notif = NL:CreateNotification()
        local createOpts = {
            Name = "Origin HUB", Content = "AR2 | Integrated", Size = windowSize,
            ConfigFolder = "OriginHUB_Configs", Enable3DRenderer = false, Keybind = "P",
            Theme = "Dark", Accent = ORANGE,
        }
        pcall(function() createOpts.AccentColor = ORANGE      end)
        pcall(function() createOpts.Color       = ORANGE      end)
        pcall(function() createOpts.Background  = BLACK_BG    end)
        pcall(function() createOpts.Panel       = BLACK_PANEL end)

        win = NL:CreateWindow(createOpts)
        if getgenv then getgenv().OriginHUB_Window = win end

        pcall(function() if NL.SetAccent      then NL:SetAccent(ORANGE)      end end)
        pcall(function() if NL.SetAccentColor then NL:SetAccentColor(ORANGE) end end)
        pcall(function() if win.SetAccent     then win:SetAccent(ORANGE)     end end)
        pcall(function() if win.SetAccentColor then win:SetAccentColor(ORANGE) end end)

        local function storeElement(e) table.insert(AR2_UI_ELEMENTS, e) end

        local function applyElemState(elem, val)
            if not elem then return end
            if type(elem.Set)      == "function" then pcall(function() elem:Set(val) end) end
            if type(elem.SetValue) == "function" then pcall(function() elem:SetValue(val) end) end
            if type(elem.Update)   == "function" then pcall(function() elem:Update(val) end) end
            pcall(function() if elem.Value ~= nil then elem.Value = val end end)
            pcall(function() if elem.State ~= nil then elem.State = val end end)
            if type(elem.Set) == "function" then
                task.spawn(function()
                    pcall(function() elem:Set(not val) end)
                    task.wait(0.05)
                    pcall(function() elem:Set(val) end)
                end)
            end
        end

        local function addToggle(section, label, cfgTable, cfgKey, callback)
            local lbl = section:AddLabel(label)
            local elem = lbl:AddToggle({
                Default = cfgTable[cfgKey] or false,
                Flag    = "origin_"..label:gsub("[^%w]","_"),
                Callback = function(v) cfgTable[cfgKey] = v if callback then callback(v) end end,
            })
            storeElement({
                getter = function() return cfgTable[cfgKey] end,
                setter = function(val) applyElemState(elem, val) end,
            })
            return lbl, elem
        end

        local function addSlider(section, label, cfgTable, cfgKey, min, max, stepOrOnChange, onChange)
            local callback = onChange
            if type(stepOrOnChange) == "function" then callback = stepOrOnChange end
            local rounding = type(stepOrOnChange) == "number" and stepOrOnChange < 1 and 2 or 0
            local def = cfgTable[cfgKey]
            if type(def) ~= "number" or def ~= def or def == math.huge or def == -math.huge then
                def = min
            end
            def = math.clamp(def, min, max)
            local elem = section:AddLabel(label):AddSlider({
                Min = min, Max = max, Default = def, Rounding = rounding,
                Flag = "origin_"..label:gsub("[^%w]","_"),
                Callback = function(v) cfgTable[cfgKey] = v if callback then callback(v) end end,
            })
            storeElement({
                getter = function() return cfgTable[cfgKey] end,
                setter = function(val) applyElemState(elem, val) end,
            })
            return elem
        end

        local function addDropdown(section, label, options, cfgTable, cfgKey, callback)
