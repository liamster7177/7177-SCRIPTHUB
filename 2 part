function AR2_applyFullbright()
    AR2_Lighting.Brightness = AR2_CFG.visuals.brightness
    AR2_Lighting.Ambient = Color3.fromRGB(180, 180, 180)
    AR2_Lighting.OutdoorAmbient = Color3.fromRGB(200, 200, 200)
