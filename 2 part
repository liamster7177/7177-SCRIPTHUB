AR2_rebuildQueued = false
AR2_rebuildCount  = 0
AR2_rebuildWindow = os.clock()

function AR2_queueRebuild(delaySecs)
    if AR2_rebuildQueued then return end
    AR2_rebuildQueued = true
    task.delay(delaySecs or 0.4, function()
        AR2_rebuildQueued = false
        AR2_buildUI()
    end)
end

AR2_UI_SIZES = {
    ["Tiny"]=0.65, ["Small"]=0.80, ["Default"]=1.00,
    ["Large"]=1.20, ["Huge"]=1.45, ["Colossal"]=1.75,
}

function AR2_uiSizeToUDim2()
    local ui = AR2_CFG.ui
    local preset = ui.sizePreset or "Default"
    local mult = AR2_UI_SIZES[preset] or 1.0
    return UDim2.fromOffset(math.floor(800 * mult), math.floor(780 * mult))
end

local function AR2_setDropdown(dd, val)
    if not dd then return end
    local done = false
    pcall(function() if dd.SetValue then dd:SetValue(val) done = true end end)
    if not done then pcall(function() if dd.Set then dd:Set(val) end end) end
end

local function AR2_refreshDropdown(dd, values)
    if not dd then return end
    pcall(function() if dd.Refresh     then dd:Refresh(values)     end end)
    pcall(function() if dd.UpdateValues then dd:UpdateValues(values) end end)
    pcall(function() if dd.SetValues   then dd:SetValues(values)   end end)
    pcall(function() if dd.SetList     then dd:SetList(values)     end end)
    pcall(function() if dd.Reload      then dd:Reload(values)      end end)
    pcall(function() if dd.Update      then dd:Update(values)      end end)
    pcall(function() if dd.Values ~= nil then dd.Values = values   end end)
end

function AR2_buildUI()
    local now = os.clock()
    if now - AR2_rebuildWindow > 10 then
        AR2_rebuildWindow = now
        AR2_rebuildCount  = 0
    end
    AR2_rebuildCount = AR2_rebuildCount + 1
    if AR2_rebuildCount > 6 then
        warn("[Origin HUB] rebuild loop detected — aborting extra rebuilds for 10s")
        return
    end

    for _, g in ipairs(AR2_uiGuisToDestroy) do
        pcall(function() if g and g.Parent then g:Destroy() end end)
    end
    AR2_uiGuisToDestroy = {}

    if AR2_uiWindowRef then
        pcall(function() if AR2_uiWindowRef.Destroy then AR2_uiWindowRef:Destroy() end end)
        pcall(function() if AR2_uiWindowRef.Unload  then AR2_uiWindowRef:Unload()  end end)
        pcall(function() if AR2_uiWindowRef.Remove  then AR2_uiWindowRef:Remove()  end end)
        pcall(function() if AR2_uiWindowRef.Hide    then AR2_uiWindowRef:Hide()    end end)
        AR2_uiWindowRef = nil
    end

    AR2_UI_ELEMENTS = {}
    AR2_configDropdown = nil
    AR2_cosLoadoutDropdown = nil

    local hostBefore = (typeof(gethui) == "function" and gethui()) or game:GetService("CoreGui")
    local snapshot = {}
    for _, c in ipairs(hostBefore:GetChildren()) do
        if c:IsA("ScreenGui") then snapshot[c] = true end
    end

    local okNL, NL = pcall(function()
        return loadstring(game:HttpGet("https://raw.githubusercontent.com/DeviceHB21/mylib/refs/heads/main/source.lua"))()
    end)
    if not okNL or not NL then
        warn("[Origin HUB] NL library failed to load: "..tostring(NL))
        return
    end
    if getgenv then getgenv().OriginHUB_NL = NL end

    local uiCfg       = AR2_CFG.ui
    local ORANGE      = uiCfg.accent
    local BLACK_BG    = uiCfg.background
    local BLACK_PANEL = uiCfg.panel
    local windowSize  = AR2_uiSizeToUDim2()

    pcall(function() NL.Theme = "Dark" end)
    pcall(function() if NL.SetTheme       then NL:SetTheme("Dark")       end end)
    pcall(function() if NL.SetAccent      then NL:SetAccent(ORANGE)      end end)
    pcall(function() if NL.SetAccentColor then NL:SetAccentColor(ORANGE) end end)

    local win
