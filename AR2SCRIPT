    local function c_fake(char, cf)
        local o_ = ws:FindFirstChild("BT_Self")
        if o_ then o_:Destroy() end
        local rt = char:FindFirstChild("HumanoidRootPart")
        if not rt then return end

        local fm = Instance.new("Model")
        fm.Name = "BT_Self"

        for _, name in ipairs(r15) do
            local p_rt = char:FindFirstChild(name)
            if p_rt and p_rt:IsA("BasePart") then
                local fk = p_rt:Clone()
                fk.Anchored, fk.CanCollide, fk.CanQuery, fk.CanTouch, fk.CastShadow, fk.Massless = true, false, false, false, false, true
                fk.Transparency, fk.Color, fk.Material, fk.Name = bt_set.transparency, bt_set.color, bt_set.material, name
                for _, child in ipairs(fk:GetChildren()) do
                    if not child:IsA("SpecialMesh") and not child:IsA("DataModelMesh") then child:Destroy() end
                end
                local off = rt.CFrame:ToObjectSpace(p_rt.CFrame)
                fk.CFrame = cf * off
                fk.Parent = fm
            end
        end
        fm.Parent = ws
    end

