                    if ds_ < cD then
                        cD = ds_
                        vh = st.Parent
                    end
                end
            end
        end
    end

    if not vh then return end
    eFl(vh)
    if vehicleFlyToggleCallback then
        vehicleFlyToggleCallback(true)
    end
end

