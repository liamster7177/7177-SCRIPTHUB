-- UI
-- =============================================
AR2_UI_ELEMENTS     = {}
AR2_configDropdown  = nil
AR2_uiGuisToDestroy = AR2_uiGuisToDestroy or {}
AR2_uiWindowRef     = nil
AR2_cosLoadoutDropdown = nil

AR2_rebuildQueued  = false
AR2_rebuildCount   = 0
AR2_rebuildWindow  = os.clock()

function AR2_queueRebuild(delaySecs)
    if AR2_rebuildQueued then return end
    AR2_rebuildQueued = true
    task.delay(delaySecs or 0.4, function()
        AR2_rebuildQueued = false
        AR2_buildUI()
    end)
end

AR2_UI_SIZES = {
    ["Tiny"]=0.65, ["Small"]=0.80, ["Default"]=1.00,
    ["Large"]=1.20, ["Huge"]=1.45, ["Colossal"]=1.75,
}

function AR2_uiSizeToUDim2()
    local ui = AR2_CFG.ui
    local preset = ui.sizePreset or "Default"
    local mult = AR2_UI_SIZES[preset] or 1.0
    return UDim2.fromOffset(math.floor(800 * mult), math.floor(780 * mult))
end

function AR2_buildUI()
    local now = os.clock()
    if now - AR2_rebuildWindow > 10 then
        AR2_rebuildWindow = now
        AR2_rebuildCount  = 0
    end
    AR2_rebuildCount = AR2_rebuildCount + 1
    if AR2_rebuildCount > 6 then
        warn("[Origin HUB] rebuild loop detected — aborting extra rebuilds for 10s")
        return
    end

    for _, g in ipairs(AR2_uiGuisToDestroy) do
        pcall(function() if g and g.Parent then g:Destroy() end end)
    end
    AR2_uiGuisToDestroy = {}

    if AR2_uiWindowRef then
        pcall(function() if AR2_uiWindowRef.Destroy then AR2_uiWindowRef:Destroy() end end)
        pcall(function() if AR2_uiWindowRef.Unload then AR2_uiWindowRef:Unload() end end)
        pcall(function() if AR2_uiWindowRef.Remove then AR2_uiWindowRef:Remove() end end)
        pcall(function() if AR2_uiWindowRef.Hide   then AR2_uiWindowRef:Hide()   end end)
        AR2_uiWindowRef = nil
    end

    AR2_UI_ELEMENTS    = {}
    AR2_configDropdown = nil
    AR2_cosLoadoutDropdown = nil

    local hostBefore = (typeof(gethui) == "function" and gethui()) or game:GetService("CoreGui")
    local snapshot = {}
    for _, c in ipairs(hostBefore:GetChildren()) do
        if c:IsA("ScreenGui") then snapshot[c] = true end
    end

    local okNL, NL = pcall(function()
        return loadstring(game:HttpGet("https://raw.githubusercontent.com/DeviceHB21/mylib/refs/heads/main/source.lua"))()
    end)
    if not okNL or not NL then
        warn("[Origin HUB] NL library failed to load: "..tostring(NL))
        return
    end

    if getgenv then getgenv().OriginHUB_NL = NL end

    local uiCfg       = AR2_CFG.ui
    local ORANGE      = uiCfg.accent
    local BLACK_BG    = uiCfg.background
    local BLACK_PANEL = uiCfg.panel
    local windowSize  = AR2_uiSizeToUDim2()

    pcall(function() NL.Theme = "Dark" end)
    pcall(function() if NL.SetTheme then NL:SetTheme("Dark") end end)
    pcall(function() if NL.SetAccent then NL:SetAccent(ORANGE) end end)
    pcall(function() if NL.SetAccentColor then NL:SetAccentColor(ORANGE) end end)

    local win

    local uiBuildOk, uiBuildErr = pcall(function()
        local Notif = NL:CreateNotification()

        local createOpts = {
            Name = "Origin HUB", Content = "AR2 | Integrated", Size = windowSize,
            ConfigFolder = "OriginHUB_Configs", Enable3DRenderer = false, Keybind = "P",
            Theme = "Dark", Accent = ORANGE,
        }
        pcall(function() createOpts.AccentColor = ORANGE end)
        pcall(function() createOpts.Color = ORANGE end)
        pcall(function() createOpts.Background = BLACK_BG end)
        pcall(function() createOpts.Panel = BLACK_PANEL end)

        win = NL:CreateWindow(createOpts)
        if getgenv then getgenv().OriginHUB_Window = win end

        pcall(function() if NL.SetAccent then NL:SetAccent(ORANGE) end end)
        pcall(function() if NL.SetAccentColor then NL:SetAccentColor(ORANGE) end end)
        pcall(function() if win.SetAccent then win:SetAccent(ORANGE) end end)
        pcall(function() if win.SetAccentColor then win:SetAccentColor(ORANGE) end end)

        local function storeElement(e) table.insert(AR2_UI_ELEMENTS,e) end

        local function applyElemState(elem, val)
            if not elem then return end
            if type(elem.Set)      == "function" then pcall(function() elem:Set(val) end) end
            if type(elem.SetValue) == "function" then pcall(function() elem:SetValue(val) end) end
            if type(elem.Update)   == "function" then pcall(function() elem:Update(val) end) end
            pcall(function() if elem.Value ~= nil then elem.Value = val end end)
            pcall(function() if elem.State ~= nil then elem.State = val end end)
            if type(elem.Set) == "function" then
                task.spawn(function()
                    pcall(function() elem:Set(not val) end)
                    task.wait(0.05)
                    pcall(function() elem:Set(val) end)
                end)
            end
        end

        -- Every control's Flag must be UNIQUE. Labels repeat across sections
        -- ("Enabled","Max Distance","Box"...), so a label-derived flag collides
        -- and makes toggles/sliders fight each other. Counter guarantees uniqueness.
        local __flagN = 0
        local function nextFlag(label)
            __flagN = __flagN + 1
            return "origin_" .. __flagN .. "_" .. tostring(label):gsub("[^%w]","_")
        end

        local function addToggle(section,label,cfgTable,cfgKey,callback)
            local lbl=section:AddLabel(label)
            local elem=lbl:AddToggle({
                Default=cfgTable[cfgKey] or false,
                Flag=nextFlag(label),
                Callback=function(v) cfgTable[cfgKey]=v if callback then callback(v) end end,
            })
            storeElement({getter=function() return cfgTable[cfgKey] end,setter=function(val) applyElemState(elem,val) end})
            return lbl,elem
        end

        local function addSlider(section,label,cfgTable,cfgKey,min,max,stepOrOnChange,onChange)
            local callback=onChange if type(stepOrOnChange)=="function" then callback=stepOrOnChange end
            local rounding=type(stepOrOnChange)=="number" and stepOrOnChange<1 and 2 or 0
            local def=cfgTable[cfgKey]
            if type(def)~="number" or def~=def or def==math.huge or def==-math.huge then def=min end
            def=math.clamp(def,min,max)
            local elem=section:AddLabel(label):AddSlider({
                Min=min,Max=max,Default=def,Rounding=rounding,
                Flag=nextFlag(label),
                Callback=function(v) cfgTable[cfgKey]=v if callback then callback(v) end end,
            })
            storeElement({getter=function() return cfgTable[cfgKey] end,setter=function(val) applyElemState(elem,val) end})
            return elem
        end

        local function addDropdown(section,label,options,cfgTable,cfgKey,callback)
            local elem=section:AddLabel(label):AddDropdown({
                Default=cfgTable[cfgKey],Values=options,
                Flag=nextFlag(label),
                Callback=function(v) cfgTable[cfgKey]=v if callback then callback(v) end end,
            })
            storeElement({getter=function() return cfgTable[cfgKey] end,setter=function(val) applyElemState(elem,val) end})
            return elem
        end

        local function addColorPicker(section,label,cfgTable,cfgKey,callback)
            local ok,elem=pcall(function()
                return section:AddLabel(label):AddColorPicker({
