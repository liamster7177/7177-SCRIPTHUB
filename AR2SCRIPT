    rs.Heartbeat:Connect(function()
        if not bt_set.enabled then
            local o_ = ws:FindFirstChild("BT_Self")
            if o_ then o_:Destroy() end
            bt_rec = {}
            return
        end
        local c_ = lp.Character
        local rt = c_ and c_:FindFirstChild("HumanoidRootPart")
        if not rt then return end

        local now = tick()
        table.insert(bt_rec, { time = now, cframe = rt.CFrame })
        while #bt_rec > 200 do table.remove(bt_rec, 1) end

        local best = nil
        local tgt = now - bt_set.delay
        local cls = math.huge
        for _, rec in ipairs(bt_rec) do
            local df = math.abs(rec.time - tgt)
            if df < cls then cls, best = df, rec end
        end
        if best then pcall(function() c_fake(c_, best.cframe) end) end
    end)

