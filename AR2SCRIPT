                    or AR2_UserInputService:IsKeyDown(Enum.KeyCode.D)
        if moving and hum.FloorMaterial ~= Enum.Material.Air then
            root.AssemblyLinearVelocity = Vector3.new(
                root.AssemblyLinearVelocity.X,
