end)

rs.Heartbeat:Connect(function()
    local hT = tick()
    if S.HitboxEnabled and cf_ and (hT - (getgenv().LastHitboxUpdate or 0) > 0.2) then
        getgenv().LastHitboxUpdate = hT
        local sV = Vector3.new(S.HitboxSize, S.HitboxSize, S.HitboxSize)
        local CF = ws:FindFirstChild("Characters")
        if CF then
            for _, ch in pairs(CF:GetChildren()) do 
                if ch:IsA("Model") then
                    local pl_ = pl:GetPlayerFromCharacter(ch)
                    if ch ~= lp.Character and (not pl_ or pl_ ~= lp) and ch.Name ~= lp.Name then
                        local hd = ch:FindFirstChild("Head")
                        local hm = ch:FindFirstChild("Humanoid")
                        if hd and hd:IsA("BasePart") and hm and hm.Health > 0 then 
                            if not oHP[hd] then 
                                oHP[hd] = { Size = hd.Size, Transparency = hd.Transparency } 
                            end
                            if hd.Size.X ~= S.HitboxSize or hd.Transparency ~= S.HitboxTrans then 
                                hd.Size = sV
                                hd.Transparency = S.HitboxTrans
                                hd.CanCollide = false
                                hd.Massless = true 
                            end 
                        end 
                    end
                end 
            end
        end
    elseif not S.HitboxEnabled and next(oHP) then
        for hd, pr in pairs(oHP) do 
            if hd and hd.Parent then 
                hd.Size = pr.Size
                hd.Transparency = pr.Transparency 
            end 
        end
        table.clear(oHP)
    end
end)

local function ds(lf, f, t, th)
	if not f or not t then 
		lf.Visible = false 
		return 
	end
	local ctr = (f + t) / 2
	local dst = (t - f).Magnitude
	local ang = math.atan2(t.Y - f.Y, t.X - f.X)
	lf.Position = UDim2.fromOffset(ctr.X - dst/2, ctr.Y - th/2)
	lf.Size = UDim2.fromOffset(dst, th)
	lf.Rotation = math.deg(ang)
	lf.Visible = true
end

local function cln(plr)
	if ea[plr] then
		for _, obj in pairs(ea[plr]) do
			if typeof(obj) == "Instance" then 
				obj:Destroy()
			elseif typeof(obj) == "table" and obj.Lines then
				for _, ln in ipairs(obj.Lines) do 
					if ln.Remove then ln:Remove() end
				end
			elseif typeof(obj) == "userdata" and obj.Remove then
				obj:Remove()
			end
		end
		ea[plr] = nil
	end
end

