        addKeybindEntry(movementKbSection,"Fly Recover","flyRecover")

        local miscKbSection = keybindsTab:AddSection({Name="Misc",Position="right"})
        addKeybindEntry(miscKbSection,"Freeze Zombies","freezeZombies")
        addKeybindEntry(miscKbSection,"Fullbright","fullbright")
        addKeybindEntry(miscKbSection,"Anti-Aim","antiAim")
        addKeybindEntry(miscKbSection,"Zombie Circle","zombieCircle")
        addKeybindEntry(miscKbSection,"Jump Circle","jumpCircle")
        addKeybindEntry(miscKbSection,"Self Backtrack","selfBacktrack")
        addKeybindEntry(miscKbSection,"Instant Interact","instantInteract")
        addKeybindEntry(miscKbSection,"Container Persist","containerPersist")
        addKeybindEntry(miscKbSection,"Player Jesus","playerJesus")
        addKeybindEntry(miscKbSection,"Third Person ADS","thirdPersonADS")

        local configKbSection = keybindsTab:AddSection({Name="Config"})
        addKeybindEntry(configKbSection,"Reset To Default","resetConfig")

        local kbResetSection = keybindsTab:AddSection({Name="Reset Keybinds"})
        kbResetSection:AddLabel("Clears every keybind back to None (blank).")
        kbResetSection:AddButton({
            Name = "Reset All Keybinds",
            Callback = function()
                AR2_resetAllKeybinds()
                AR2_refreshUI()
                Notif.new({Title="Origin HUB",Content="All keybinds cleared",Duration=3})
            end,
        })

        -- SETTINGS TAB
        local settingsTab = win:AddTab({Icon="settings",Name="Settings"})
        local settingsSection = settingsTab:AddSection({Name="Config Manager"})
        local configListLabel = settingsSection:AddLabel("Saved configs: (none)")
        local function _updateConfigListLabel()
            AR2_refreshConfigList()
            if #AR2_configList == 0 then
                pcall(function() configListLabel:SetText("Saved configs: (none)") end)
            else
                pcall(function() configListLabel:SetText("Saved configs: " .. table.concat(AR2_configList, ", ")) end)
            end
        end
        _updateConfigListLabel()
        settingsSection:AddButton({
            Name = "Save Current Config",
            Callback = function()
                AR2_promptConfigName(function(name)
                    if not name or name == "" then return end
                    if AR2_saveConfig(name) then
                        Notif.new({Title="Origin HUB",Content="Saved config: "..name,Duration=3})
                        task.wait(0.05)
                        _updateConfigListLabel()
                    else
                        Notif.new({Title="Origin HUB",Content="Save failed — check writefile",Duration=4})
                    end
                end)
            end,
        })
        settingsSection:AddButton({
            Name = "Load Config (type name)",
            Callback = function()
                AR2_promptConfigName(function(name)
                    if not name or name == "" then return end
                    if AR2_loadConfigByName(name) then
                        Notif.new({Title="Origin HUB",Content="Loaded config: "..name,Duration=3})
                    else
                        Notif.new({Title="Origin HUB",Content="Load failed — check console",Duration=4})
                    end
                end)
            end,
        })
        settingsSection:AddButton({
            Name = "Refresh Config List",
            Callback = function()
                _updateConfigListLabel()
                Notif.new({Title="Origin HUB",Content="Config list refreshed ("..#AR2_configList..")",Duration=3})
            end,
        })
        settingsSection:AddButton({
            Name = "Delete Config (type name)",
            Callback = function()
                AR2_promptConfigName(function(name)
                    if not name or name == "" then return end
                    if AR2_deleteConfig(name) then
                        Notif.new({Title="Origin HUB",Content="Deleted: "..name,Duration=3})
                        _updateConfigListLabel()
                    else
                        Notif.new({Title="Origin HUB",Content="Delete failed: "..name,Duration=4})
                    end
                end)
            end,
        })
        settingsSection:AddButton({
            Name = "Reset To Default (all off)",
            Callback = function()
                AR2_resetConfig()
                Notif.new({Title="Origin HUB",Content="Reset to defaults",Duration=3})
            end,
        })

        local sizeSection = settingsTab:AddSection({Name="UI Size"})
        local uiSizePresetNames = { "Tiny","Small","Default","Large","Huge","Colossal" }
        local sizeDropdownReady = false
        task.delay(1.0, function() sizeDropdownReady = true end)
        sizeSection:AddLabel("Size"):AddDropdown({
            Default = uiCfg.sizePreset or "Default",
            Values  = uiSizePresetNames,
            Flag    = "origin_UiSizePreset",
            Callback = function(v)
                if not sizeDropdownReady then return end
                if type(v) ~= "string" then return end
                if uiCfg.sizePreset == v then return end
                uiCfg.sizePreset = v
                AR2_queueRebuild(0.4)
                Notif.new({Title="Origin HUB",Content="UI size: "..v,Duration=3})
            end,
        })
        sizeSection:AddLabel("Default = 100%  ·  Tiny = 65%  ·  Colossal = 175%")

        local uiSection = settingsTab:AddSection({Name="UI Personalization"})
        local function accentFromHue(h) return Color3.fromHSV(math.clamp(h,0,360)/360, 1, 1) end
        addSlider(uiSection,"Accent Hue",AR2_CFG.ui,"accentHue",0,360,function(v) AR2_CFG.ui.accent = accentFromHue(v) end)
        pcall(function()
            uiSection:AddLabel("Accent Color"):AddColorPicker({Default=AR2_CFG.ui.accent,Flag="origin_UiAccent",Callback=function(c) AR2_CFG.ui.accent = c end})
        end)
        pcall(function()
            uiSection:AddLabel("Background Color"):AddColorPicker({Default=AR2_CFG.ui.background,Flag="origin_UiBg",Callback=function(c) AR2_CFG.ui.background = c end})
        end)
        pcall(function()
            uiSection:AddLabel("Panel Color"):AddColorPicker({Default=AR2_CFG.ui.panel,Flag="origin_UiPanel",Callback=function(c) AR2_CFG.ui.panel = c end})
        end)
        addSlider(uiSection,"Window Transparency %",AR2_CFG.ui,"transparency",0,100,function(v) AR2_CFG.ui.transparency = v / 100 end)
        addSlider(uiSection,"Corner Radius",AR2_CFG.ui,"cornerRadius",0,24,function(v) AR2_CFG.ui.cornerRadius = v end)
        addToggle(uiSection,"Glow Effects",AR2_CFG.ui,"glow",function(v) AR2_CFG.ui.glow = v end)
        addToggle(uiSection,"Compact Mode",AR2_CFG.ui,"compact",function(v) AR2_CFG.ui.compact = v end)
        uiSection:AddLabel("Changes apply when you rebuild the UI:")
        uiSection:AddButton({Name="Apply Theme (Rebuild UI)",Callback=function()
            AR2_queueRebuild()
            Notif.new({Title="Origin HUB",Content="UI rebuilt with new theme",Duration=3})
        end})

        local themeResetSection = settingsTab:AddSection({Name="Theme Presets", Position="right"})
        themeResetSection:AddButton({Name="Preset: Orange & Black",Callback=function()
            AR2_CFG.ui.accent=Color3.fromRGB(255,140,30)
            AR2_CFG.ui.accentHue=30
            AR2_CFG.ui.background=Color3.fromRGB(14,14,14)
            AR2_CFG.ui.panel=Color3.fromRGB(20,20,20)
            AR2_queueRebuild()
            Notif.new({Title="Origin HUB",Content="Orange & Black applied",Duration=3})
        end})
        themeResetSection:AddButton({Name="Preset: Red & Black",Callback=function()
            AR2_CFG.ui.accent=Color3.fromRGB(230,40,60)
            AR2_CFG.ui.accentHue=354
            AR2_CFG.ui.background=Color3.fromRGB(14,14,14)
            AR2_CFG.ui.panel=Color3.fromRGB(20,20,20)
            AR2_queueRebuild()
            Notif.new({Title="Origin HUB",Content="Red & Black applied",Duration=3})
        end})
        themeResetSection:AddButton({Name="Preset: Cyan & Black",Callback=function()
            AR2_CFG.ui.accent=Color3.fromRGB(40,200,230)
            AR2_CFG.ui.accentHue=188
            AR2_CFG.ui.background=Color3.fromRGB(10,14,18)
            AR2_CFG.ui.panel=Color3.fromRGB(18,22,28)
            AR2_queueRebuild()
            Notif.new({Title="Origin HUB",Content="Cyan & Black applied",Duration=3})
        end})
        themeResetSection:AddButton({Name="Preset: Purple & Black",Callback=function()
            AR2_CFG.ui.accent=Color3.fromRGB(160,60,240)
            AR2_CFG.ui.accentHue=275
            AR2_CFG.ui.background=Color3.fromRGB(14,10,20)
            AR2_CFG.ui.panel=Color3.fromRGB(22,18,30)
            AR2_queueRebuild()
            Notif.new({Title="Origin HUB",Content="Purple & Black applied",Duration=3})
        end})

        Notif.new({Title="Origin HUB",Content="Loaded — click a keybind button to type your key",Duration=5})

        function AR2_refreshUI()
            for _, elem in ipairs(AR2_UI_ELEMENTS) do
                local val = elem.getter()
                if val ~= nil and elem.setter then
                    local ok, err = pcall(elem.setter, val)
                    if not ok then warn("[Origin HUB] refreshUI error: "..tostring(err)) end
                end
            end
        end
        AR2_refreshUI()
    end)
    if not uiBuildOk and uiBuildErr then
        warn("[Origin HUB] UI build failed: "..tostring(uiBuildErr))
    end

    local hostAfter = (typeof(gethui) == "function" and gethui()) or game:GetService("CoreGui")
    for _, c in ipairs(hostAfter:GetChildren()) do
        if c:IsA("ScreenGui") and not snapshot[c] then
            if not c.Name:find("^origin_") then
                table.insert(AR2_uiGuisToDestroy, c)
            end
        end
    end

    if win then
        AR2_uiWindowRef = win
        pcall(function()
            if win.UI and win.UI.Destroy then table.insert(AR2_uiGuisToDestroy, win.UI) end
        end)
        pcall(function()
            if win.Gui and win.Gui.Destroy then table.insert(AR2_uiGuisToDestroy, win.Gui) end
        end)
        pcall(function()
            if win.ScreenGui and win.ScreenGui.Destroy then table.insert(AR2_uiGuisToDestroy, win.ScreenGui) end
        end)
        pcall(function()
            if win.Object and win.Object.Destroy then table.insert(AR2_uiGuisToDestroy, win.Object) end
        end)
    end
end

