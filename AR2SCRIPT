				if ec.Name then
					local dn = ec.UseDisplayName and plr.DisplayName or plr.Name
					esp.NameLabel.Text = dn
					esp.NameLabel.Position = UDim2.fromOffset(l_ - 1, y_o)
					esp.NameLabel.Size = UDim2.fromOffset(w_d + 2, 12)
					esp.NameLabel.Visible = true
					y_o = y_o - 14
				else
					esp.NameLabel.Visible = false
				end

				local b_y_o = b + 2
				local t_n = nil
				local eq = char:FindFirstChild("Equipped")
				if eq then
					local itm = eq:FindFirstChildOfClass("Model")
					if itm then t_n = itm.Name end
				end
				if not t_n then t_n = "Hands" end

				if t_n ~= esp.LastTool then
					esp.ToolLabel.Text = t_n
					esp.LastTool = t_n
				end

				esp.ToolLabel.Visible = ec.WeaponName
				if esp.ToolLabel.Visible then
					esp.ToolLabel.Position = UDim2.fromOffset(l_ - 1, b_y_o)
					esp.ToolLabel.Size = UDim2.fromOffset(w_d + 2, 12)
					b_y_o = b_y_o + 14 
				end

				if ec.Distance and lpr then
					local d_s = (lpr.Position - root.Position).Magnitude
					local d_v = ec.Metric == "Meters" and math.floor(d_s * 0.28) or math.floor(d_s)
					local u_ = ec.Metric == "Meters" and "м" or "s"
					esp.DistanceLabel.Text = d_v .. u_
					esp.DistanceLabel.Position = UDim2.fromOffset(l_ - 1, b_y_o)
					esp.DistanceLabel.Size = UDim2.fromOffset(w_d + 2, 12)
