        local function addKeybindEntry(section, label, cfgKey)
            local function currentText()
                local k = AR2_CFG.keybinds[cfgKey] or "None"
                return label .. "  →  " .. k
            end
            local btn
            local ok = pcall(function()
                btn = section:AddButton({
                    Name = currentText(),
                    Callback = function()
                        AR2_promptKeybind(label, AR2_CFG.keybinds[cfgKey], function(newKey)
                            AR2_CFG.keybinds[cfgKey] = newKey
                            AR2_markDirty()
                            if btn then
                                pcall(function() if btn.SetName then btn:SetName(currentText()) end end)
                                pcall(function() if btn.SetText then btn:SetText(currentText()) end end)
                                pcall(function() if btn.Set then btn:Set(currentText()) end end)
                                pcall(function() if btn.Name ~= nil then btn.Name = currentText() end end)
                                pcall(function() if btn.Text ~= nil then btn.Text = currentText() end end)
                            end
                        end)
                    end,
                })
            end)
            if not ok or not btn then return end
            storeElement({
                getter = function() return AR2_CFG.keybinds[cfgKey] end,
                setter = function(_)
                    if not btn then return end
                    pcall(function() if btn.SetName then btn:SetName(currentText()) end end)
                    pcall(function() if btn.SetText then btn:SetText(currentText()) end end)
                    pcall(function() if btn.Set then btn:Set(currentText()) end end)
                    pcall(function() if btn.Name ~= nil then btn.Name = currentText() end end)
                    pcall(function() if btn.Text ~= nil then btn.Text = currentText() end end)
                end,
            })
        end

