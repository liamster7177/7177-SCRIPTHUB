    local function c_jc_eff(pos, col, sr, er, dur, icon)
        task.spawn(function()
            local pl_ = Instance.new("Part")
            pl_.Name = "JumpCircleEffect"
            pl_.Shape = Enum.PartType.Block
            pl_.Material = Enum.Material.ForceField
            pl_.Transparency = 1
            pl_.Color = col
            pl_.Size = Vector3.new(sr, 0.05, sr)
            pl_.Anchored = true
            pl_.CanCollide = false
            pl_.CastShadow = false
            
            local c_ = lp.Character
            local rp = RaycastParams.new()
            if c_ then rp.FilterDescendantsInstances = {c_} end
            rp.FilterType = Enum.RaycastFilterType.Exclude

            local res = ws:Raycast(pos, Vector3.new(0, -15, 0), rp)
            if res then
                pl_.Position = res.Position + Vector3.new(0, 0.1, 0)
            else
                pl_.Position = pos - Vector3.new(0, 3, 0)
            end

            local dc_ = Instance.new("Decal")
            dc_.Texture = icon
            dc_.Face = Enum.NormalId.Top
            dc_.Transparency = 0.1
            dc_.Color3 = col
            dc_.Parent = pl_
            pl_.Parent = ws

            local ex_t = ts:Create(pl_, TweenInfo.new(dur, Enum.EasingStyle.Circular, Enum.EasingDirection.Out), { Size = Vector3.new(er, 0.05, er) })
            local fd_t = ts:Create(dc_, TweenInfo.new(dur * 0.8, Enum.EasingStyle.Quart, Enum.EasingDirection.In), { Transparency = 1 })

            ex_t:Play()
            fd_t:Play()
            ex_t.Completed:Once(function() pl_:Destroy() end)
        end)
    end

