                    im[i] = im[i] * S.RecoilScale
                end
            end
            return unpack(im)
        end)
    end

    local oF = bul.Fire
    bul.Fire = function(w_, c_, a3, g_, orG, dr, ...)
        local args = {...}
        if S.SilentEnabled then
            local tg = gCP(S.SilentTargetType, S.SilentTargetHitbox, S.SilentMaxDistance)
            if tg and math.random(1, 100) <= S.SilentHitChance then
                local pt = tg:FindFirstChild(S.SilentTargetHitbox)
                if pt then
                    local tP = pt.Position
                    if S.SilentVisibilityCheck then
                        if not isV(orG, tP, pt) then
                            return oF(w_, c_, a3, g_, orG, dr, unpack(args))
                        end
                    end
                    if S.BulletManipulation then
                        if not isV(orG, tP, pt) then
                            local os = gSO(orG, tP, S.BulletManipRadius, pt)
                            if os.Magnitude > 0.1 then
                                orG = orG + os
                            end
                        end
                    end
                    dr = (tP - orG).Unit
                    S.lastSilentOrigin = orG
                    S.lastSilentDir = dr
                end
            end
        end

        if tr_set.Enabled then
            local fo = orG
            if not fo then
                local t = lp.Character and lp.Character:FindFirstChildOfClass("Tool")
                local h = t and (t:FindFirstChild("Muzzle") or t:FindFirstChild("FirePart") or t:FindFirstChild("Handle") or t:FindFirstChildOfClass("BasePart"))
                fo = h and h.Position or cm.CFrame.Position
            end
            if typeof(dr) == "Vector3" then
                c_bt(fo, fo + dr.Unit * 2000)
            end
        end

        return oF(w_, c_, a3, g_, orG, dr, unpack(args))
    end
end

