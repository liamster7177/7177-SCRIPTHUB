local function gCP(tT, hb, mD)
    local cl, sh = nil, math.huge
    local ct = Vector2.new(cm.ViewportSize.X/2, cm.ViewportSize.Y/2)
    for _, pl_ in pairs(pl:GetPlayers()) do
        if pl_ ~= lp and pl_.Character and pl_.Character:FindFirstChild(hb) then
            local ch_ = pl_.Character
            local pt = ch_[hb]
            local pos, oS = cm:WorldToViewportPoint(pt.Position)
            if not oS then continue end
            
            local d3D = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
                and (lp.Character.HumanoidRootPart.Position - pt.Position).Magnitude or math.huge
                
            if d3D > mD then continue end
            local d2D = (Vector2.new(pos.X, pos.Y) - ct).Magnitude
            local dVal = (tT == "Closest To Mouse") and d2D or d3D
            if dVal < sh then
                sh = dVal
                cl = ch_
            end
        end
    end
    return cl
end

local function mMT(tP)
    local ct = Vector2.new(cm.ViewportSize.X / 2, cm.ViewportSize.Y / 2)
    local dl = (Vector2.new(tP.X, tP.Y) - ct) * S.AimbotSmoothing
    if mousemoverel then mousemoverel(dl.X, dl.Y) end
end

local function isV(orG, tP, tI)
    local rP = RaycastParams.new()
    rP.FilterType = Enum.RaycastFilterType.Exclude
    local ch_ = tI and tI:FindFirstAncestorOfClass("Model")
    rP.FilterDescendantsInstances = {lp.Character, ch_ or tI}
    rP.IgnoreWater = true
    local rs_ = workspace:Raycast(orG, tP - orG, rP)
    return rs_ == nil
end

local function gSO(orG, tP, mR, tI)
    if not cm then return Vector3.zero end
    
    local cCF = cm.CFrame
    local cR = cCF.RightVector
    local cU = cCF.UpVector
    local fd = cCF.LookVector

    local rP = RaycastParams.new()
    rP.FilterType = Enum.RaycastFilterType.Exclude
    local tCh = tI and tI:FindFirstAncestorOfClass("Model")
    rP.FilterDescendantsInstances = {lp.Character, tCh or tI}
    rP.IgnoreWater = true

    local mO = S.BulletManipRadius or 6
    local mFw = S.MaxForward or 3
    local mW = S.MaxWalls or 2

    local function cP(tO, mWH)
        local dr = (tP - tO)
        local d = dr.Magnitude
        dr = dr.Unit

        local rD = d
        local cP = tO
        local wH = 0

        while rD > 0.1 do
            local rs_ = workspace:Raycast(cP, dr * rD, rP)
            if not rs_ then
                return true
            end

            wH = wH + 1
            if wH > mWH then
                return false
            end

            cP = rs_.Position + dr * 0.1
            rD = (tP - cP).Magnitude
        end
        return true
    end

    if cP(orG, mW) then
        return Vector3.zero
    end

    for f_ = 1, mFw do
        local tO = orG + fd * f_ * 1.5
        if cP(tO, mW) then
            return fd * f_ * 1.5
        end
    end

    local sp = {2, 4, 6, 8, mO}
    for _, d_ in ipairs(sp) do
        for i = 0, 12 do
            local an = math.rad(i * 30)
            local os = (cR * math.cos(an) * d_) + (cU * math.sin(an) * d_)
            
            if S.WindowAware then
                os = os + cU * (d_ * 0.15)
            end

            local tO = orG + os
            if cP(tO, mW) then
                return os
            end
        end
    end

    if S.ObstructionFallback then
        for i = 1, 6 do
            local fO = cR * (i * 0.8) + cU * (i * 0.4)
            if cP(orG + fO, math.max(1, mW - 1)) then
                return fO
            end
        end
    end

    return Vector3.zero
end

local function c_bt(orig, targ)
	task.spawn(function()
		if not tr_set.Enabled then return end
		if typeof(orig) ~= "Vector3" or typeof(targ) ~= "Vector3" then return end
		local d = (orig - targ).Magnitude
		if d < 1 then return end

		local tr = Instance.new("Part")
		tr.Anchored, tr.CanCollide, tr.CanTouch, tr.CanQuery, tr.Massless, tr.CastShadow = true, false, false, false, true, false
		tr.Material, tr.Color, tr.Size = Enum.Material.ForceField, tr_set.Color, Vector3.new(tr_set.Thickness * 0.04, tr_set.Thickness * 0.04, d)
		tr.CFrame = CFrame.lookAt(orig, targ) * CFrame.new(0, 0, -d / 2)
		tr.Parent = cm

		local gl
		if tr_set.GlowIntensity > 0 then
			gl = Instance.new("Part")
			gl.Anchored, gl.CanCollide, gl.CanTouch, gl.CanQuery, gl.Massless, gl.CastShadow = true, false, false, false, true, false
			gl.Material, gl.Color, gl.Size = Enum.Material.ForceField, tr_set.Color, Vector3.new(tr_set.Thickness * 0.08 * tr_set.GlowIntensity, tr_set.Thickness * 0.08 * tr_set.GlowIntensity, d)
			gl.CFrame, gl.Transparency = tr.CFrame, 0.5
			gl.Parent = cm
		end

		local lt_ = math.max(tr_set.Lifetime * 0.5, 0.1)
		local tw = ts:Create(tr, TweenInfo.new(lt_, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Transparency = 1, Size = Vector3.new(0, 0, d)
		})
		tw:Play()

		if gl then
			task.wait(lt_ * 0.3)
			local gl_tw = ts:Create(gl, TweenInfo.new(lt_ * 0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Transparency = 1, Size = Vector3.new(0, 0, d)
			})
			gl_tw:Play()
			task.wait(lt_ * 0.7)
			gl:Destroy()
		end

		task.wait(lt_ * 0.3)
		tr:Destroy()
	end)
end

