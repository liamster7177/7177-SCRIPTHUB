        end
        return oNS(self, ...)
    end

    if oNS and oNS ~= nNS then
        nL.Send = nNS
    end

    GameSection:AddLabel('Container Persistence'):AddToggle({
        Default = false,
        Flag = "ContainerPersistence",
        Callback = function(v)
            S.cPE = v
        end
    })
end

